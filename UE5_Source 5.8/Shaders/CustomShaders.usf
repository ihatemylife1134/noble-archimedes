// Noble Archimedes - Custom Shaders
// These shader snippets can be used in UE5 Material Expressions
// Copy relevant sections into Custom Material Expression nodes

//=============================================================================
// Weapon Trail Vertex Offset
//=============================================================================
float3 WeaponTrailOffset(float3 Position, float Time, float TrailWidth, float TrailLength)
{
    // Create a sine wave trail effect for weapon swings
    float wave = sin(Time * 15.0 + Position.x * 5.0) * TrailWidth * 0.1;
    float3 offset = float3(0, wave, 0);
    
    // Fade out along trail length
    float fade = 1.0 - saturate(Position.z / TrailLength);
    
    return Position + offset * fade;
}

//=============================================================================
// Magic Glow (for companions and magic weapons)
//=============================================================================
float3 MagicGlow(float3 BaseColor, float Time, float Intensity, float PulseSpeed)
{
    float pulse = sin(Time * PulseSpeed) * 0.5 + 0.5;
    float glow = Intensity * (0.5 + pulse * 0.5);
    return BaseColor * glow;
}

//=============================================================================
// Perfect Guard Flash
//=============================================================================
float3 PerfectGuardFlash(float Time, float Duration, float3 FlashColor)
{
    float progress = saturate(Time / Duration);
    float flash = 1.0 - progress;
    float3 flashColor = FlashColor * flash * flash; // Quadratic falloff
    return flashColor;
}

//=============================================================================
// Quick Step Motion Blur
//=============================================================================
float3 QuickStepBlur(float3 Position, float Time, float Duration, float BlurAmount)
{
    float progress = saturate(Time / Duration);
    float blur = sin(progress * 3.14159) * BlurAmount;
    return Position + float3(blur, 0, 0);
}

//=============================================================================
// Damage Type Color
//=============================================================================
float3 GetDamageTypeColor(int DamageType)
{
    switch (DamageType)
    {
        case 0: return float3(1.0, 0.0, 0.0);   // Fire - Red
        case 1: return float3(0.0, 0.5, 1.0);   // Ice - Light Blue
        case 2: return float3(1.0, 1.0, 0.5);   // Light - Yellow
        case 3: return float3(0.5, 0.0, 0.5);   // Dark - Purple
        case 4: return float3(0.0, 1.0, 0.0);   // Poison - Green
        case 5: return float3(0.5, 0.0, 1.0);   // Curse - Magenta
        case 6: return float3(0.5, 0.5, 0.5);   // Paralyze - Gray
        case 7: return float3(0.2, 0.2, 0.2);   // Stone - Dark Gray
        case 8: return float3(0.8, 0.6, 0.4);   // Slash - Brown
        case 9: return float3(0.6, 0.6, 0.8);   // Blunt - Blue Gray
        case 10: return float3(0.0, 0.5, 0.5);  // Magic - Cyan
        default: return float3(1.0, 1.0, 1.0);  // White
    }
}

//=============================================================================
// Companion Glow (by type)
//=============================================================================
float3 GetCompanionGlowColor(int CompanionType)
{
    switch (CompanionType)
    {
        case 0: return float3(0.0, 0.5, 1.0);   // Fairy - Light Blue
        case 1: return float3(1.0, 0.3, 0.0);   // Griffin - Orange
        case 2: return float3(1.0, 0.5, 0.0);   // Salamander - Fire Orange
        case 3: return float3(0.2, 0.8, 0.2);   // Ogre - Green
        case 4: return float3(0.5, 0.5, 0.5);   // Skeleton - Gray
        case 5: return float3(0.8, 0.0, 0.8);   // Witch - Purple
        case 6: return float3(1.0, 0.5, 0.0);   // Pumpkin - Orange
        default: return float3(1.0, 1.0, 1.0);  // White
    }
}