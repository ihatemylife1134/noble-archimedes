+
+void SetPresentationSnapshotHook(void (*hook)(void *), void *context)
+{
+    snapshotHookContext.store(context, std::memory_order_release);
+    snapshotHook.store(hook, std::memory_order_release);
+}
+#endif
+std::unique_ptr<GSRasterBackend> CreateBackend()
+{
+    try
+    {
+        auto backend = std::make_unique<PgsBackend>();
+        if (backend->initializeDevice())
+            return backend;
+    }
+    catch (const std::exception &error)
+    {
+        std::fprintf(stderr, "[gs:pgs] initialization failed: %s; keeping CPU backend\n", error.what());
+    }
+    catch (...)
+    {
+        std::fprintf(stderr, "[gs:pgs] initialization failed; keeping CPU backend\n");
+    }
+    return {};
+}
+
+bool IsRawRasterBackend(const GSRasterBackend &backend)
+{
+    return dynamic_cast<const PgsBackend *>(&backend) != nullptr;
+}
+
+void FeedGif(GSRasterBackend &backend, unsigned pathIndex, const uint8_t *data, uint32_t size)
+{
+    if (auto *pgs = dynamic_cast<PgsBackend *>(&backend))
+        pgs->feedGif(pathIndex, data, size);
+}
+
+void FeedRegister(GSRasterBackend &backend, uint8_t address, uint64_t value)
+{
+    if (auto *pgs = dynamic_cast<PgsBackend *>(&backend))
+        pgs->feedRegister(address, value);
+}
+
+void FeedImage(GSRasterBackend &backend, const uint8_t *data, uint32_t size)
+{
+    if (auto *pgs = dynamic_cast<PgsBackend *>(&backend))
+        pgs->feedImage(data, size);
+}
+}
+#endif
