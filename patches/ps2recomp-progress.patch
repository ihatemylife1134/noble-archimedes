diff --git a/ps2xRuntime/tests/ee_archive_completion_hook_test.cpp b/ps2xRuntime/tests/ee_archive_completion_hook_test.cpp
new file mode 100644
index 0000000..c31da19
--- /dev/null
+++ b/ps2xRuntime/tests/ee_archive_completion_hook_test.cpp
@@ -0,0 +1,64 @@
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kFirstPc = 0x412BD0u;
+constexpr uint32_t kLastPc = 0x4134B8u;
+constexpr uint32_t kReturnPc = 0x4134BCu;
+constexpr uint32_t kRequest = 0xA3D590u;
+constexpr uint32_t kCompletion = 0xA3D594u;
+uint32_t calls = 0;
+bool guestCompletes = false;
+
+void guestCompletion(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    ++calls;
+    if (guestCompletes)
+        *reinterpret_cast<uint32_t *>(rdram + kCompletion) = 1u;
+    ctx->pc = kReturnPc;
+}
+} // namespace
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kFirstPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kReturnPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount =
+    (kReturnPc + 4u - kFirstPc) / 4u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[g_ps2RecompiledFunctionTableSlotCount] = {};
+
+int main()
+{
+    for (const uint32_t pc : {0x412BD0u, 0x4134B8u, 0x412C98u})
+        g_ps2RecompiledFunctionTable[(pc - kFirstPc) / 4u] = guestCompletion;
+
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 2;
+    uint8_t *rdram = runtime.memory().getRDRAM();
+    auto *request = reinterpret_cast<uint32_t *>(rdram + kRequest);
+    auto *completion = reinterpret_cast<uint32_t *>(rdram + kCompletion);
+
+    for (const bool completes : {false, true})
+    for (const uint32_t pc : {0x412BD0u, 0x4134B8u, 0x412C98u})
+    {
+        guestCompletes = completes;
+        *request = 1u;
+        *completion = 0u;
+        R5900Context context{};
+        context.pc = pc;
+        SET_GPR_U32(&context, 29, 0x1FFE000u);
+        SET_GPR_U32(&context, 31, kReturnPc);
+        (void)runtime.dispatchGuestBranch(rdram, &context, pc, 0x400000u,
+                                          kReturnPc,
+                                          PS2Runtime::GuestBranchKind::DirectCall,
+                                          "archive completion boundary");
+        std::cout << "pc=0x" << std::hex << pc << std::dec
+                  << " guestCompletes=" << completes
+                  << " request=" << *request << " completion=" << *completion
+                  << " calls=" << calls << '\n';
+        if (*completion != static_cast<uint32_t>(completes)) return 1;
+    }
+    return calls == 6u ? 0 : 2;
+}
diff --git a/ps2xRuntime/tests/ee_async_stack_test.cpp b/ps2xRuntime/tests/ee_async_stack_test.cpp
new file mode 100644
index 0000000..70624fd
--- /dev/null
+++ b/ps2xRuntime/tests/ee_async_stack_test.cpp
@@ -0,0 +1,49 @@
+#include "ps2_runtime.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+
+// This allocator test does not register recompiled guest functions.
+extern const uint32_t g_ps2RecompiledFunctionTableBase = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 0u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE))
+    {
+        std::cerr << "failed to initialize guest RDRAM\n";
+        return 1;
+    }
+    constexpr uint32_t mainSavedReturn = 0x01FFFFD8u;
+    const uint32_t callbackSp = runtime.reserveAsyncCallbackStack(0x4000u, 16u);
+    if (callbackSp == 0u)
+    {
+        std::cerr << "failed to reserve callback stack\n";
+        return 1;
+    }
+    // Model the nested 0x407478 -> 0x407428 handler's saved RA write, while
+    // the suspended main thread's 0x40FAB8 frame is still on the RDRAM stack.
+    uint8_t *rdram = runtime.memory().getRDRAM();
+    constexpr uint32_t canary = 0xDEADBEEFu;
+    constexpr uint32_t callbackSavedReturn = 0u;
+    std::memcpy(rdram + mainSavedReturn, &canary, sizeof(canary));
+    const uint32_t callbackStore = callbackSp - 0x10u - 0x20u + 0x18u;
+    std::memcpy(rdram + callbackStore, &callbackSavedReturn, sizeof(callbackSavedReturn));
+    uint32_t mainReturnAfterCallback = 0u;
+    std::memcpy(&mainReturnAfterCallback, rdram + mainSavedReturn, sizeof(mainReturnAfterCallback));
+    if (mainReturnAfterCallback != canary)
+    {
+        std::cerr << "callback stack overwrites paused main thread return address\n";
+        return 1;
+    }
+    if (callbackSp >= 0x01FE0000u || callbackSp < 0x01F00000u)
+    {
+        std::cerr << "callback stack is outside the reserved callback region\n";
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_attached_callback_fairness_test.cpp b/ps2xRuntime/tests/ee_attached_callback_fairness_test.cpp
new file mode 100644
index 0000000..f337a94
--- /dev/null
+++ b/ps2xRuntime/tests/ee_attached_callback_fairness_test.cpp
@@ -0,0 +1,85 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <functional>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kMainPc = 0x400000u;
+constexpr uint32_t kCallbackPc = 0x400004u;
+int mainSteps = 0;
+int callbacks = 0;
+bool savedContextRestored = false;
+std::function<void(const R5900Context &, R5900Context &)> callbackCompletion;
+
+void mainFunction(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    if (++mainSteps == 1)
+    {
+        GuestInvocation first{};
+        first.context.pc = kCallbackPc;
+        first.onComplete = callbackCompletion;
+        runtime->eeScheduler().queueInvocation(std::move(first));
+    }
+    else
+    {
+        savedContextRestored = getRegU32(ctx, 29) == 0x01FFFFE0u &&
+                               getRegU32(ctx, 31) == 0x12345678u;
+        runtime->eeScheduler().requestStop();
+    }
+    ctx->pc = kMainPc;
+}
+
+void callbackFunction(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    ++callbacks;
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kMainPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kCallbackPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 2u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[2] = {mainFunction, callbackFunction};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE))
+    {
+        return 1;
+    }
+    R5900Context mainContext{};
+    mainContext.pc = kMainPc;
+    mainContext.r[29] = _mm_set_epi32(0, 0, 0, 0x01FFFFE0u);
+    mainContext.r[31] = _mm_set_epi32(0, 0, 0, 0x12345678u);
+    EeScheduler &scheduler = runtime.eeScheduler();
+    scheduler.reset(runtime.memory().getRDRAM(), mainContext);
+
+    int completions = 0;
+    callbackCompletion = [&](const R5900Context &, R5900Context &)
+    {
+        if (++completions < 50)
+        {
+            GuestInvocation next{};
+            next.context.pc = kCallbackPc;
+            next.onComplete = callbackCompletion;
+            scheduler.queueInvocation(std::move(next));
+        }
+        else
+        {
+            scheduler.requestStop();
+        }
+    };
+
+    scheduler.run();
+    if (mainSteps < 2 || callbacks < 1 || completions >= 50 || !savedContextRestored)
+    {
+        std::cerr << "callbacks starved saved guest PC: mainSteps=" << mainSteps
+                  << " callbacks=" << callbacks << " completions=" << completions << '\n';
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_dispatch_policy_test.cpp b/ps2xRuntime/tests/ee_dispatch_policy_test.cpp
new file mode 100644
index 0000000..8baee6c
--- /dev/null
+++ b/ps2xRuntime/tests/ee_dispatch_policy_test.cpp
@@ -0,0 +1,65 @@
+#include "runtime/ee_dispatch_policy.h"
+
+#include <array>
+#include <deque>
+#include <iostream>
+#include <vector>
+
+int main()
+{
+    EeDispatchPolicy policy;
+    // The first two callbacks complete DMA channels 2 and 1. VBlank callback
+    // cause 10 then continues arriving while the ISR wakes the worker.
+    std::deque<int> callbacks{2, 1};
+    for (int i = 0; i < 24; ++i)
+    {
+        callbacks.push_back(10);
+    }
+    std::array<int, 11> guestRing{};
+    int writeIndex = 0;
+    int readIndex = 0;
+    int ringEntries = 0;
+    int servicedCallbacks = 0;
+    bool workerReady = false;
+    std::vector<int> completedDma;
+    for (int turn = 0; turn < 100 && (!callbacks.empty() || workerReady); ++turn)
+    {
+        const EeDispatchChoice choice = policy.choose(!callbacks.empty(), workerReady);
+        if (choice == EeDispatchChoice::Invocation)
+        {
+            if (ringEntries >= static_cast<int>(guestRing.size()))
+            {
+                std::cerr << "DMA worker starved until guest IRQ ring overflowed\n";
+                return 1;
+            }
+            guestRing[writeIndex] = callbacks.front();
+            callbacks.pop_front();
+            writeIndex = (writeIndex + 1) % static_cast<int>(guestRing.size());
+            ++ringEntries;
+            ++servicedCallbacks;
+            workerReady = true; // ISR signals the DMA worker semaphore.
+        }
+        else if (choice == EeDispatchChoice::Ready)
+        {
+            while (ringEntries > 0)
+            {
+                const int cause = guestRing[readIndex];
+                if (cause < 10)
+                {
+                    completedDma.push_back(cause);
+                }
+                readIndex = (readIndex + 1) % static_cast<int>(guestRing.size());
+                --ringEntries;
+            }
+            workerReady = false;
+        }
+    }
+    if (completedDma != std::vector<int>{2, 1} || servicedCallbacks != 26 ||
+        policy.choose(false, true) != EeDispatchChoice::Ready ||
+        policy.choose(false, false) != EeDispatchChoice::Idle)
+    {
+        std::cerr << "DMA completions or callback progress lost\n";
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_dispatcher_lifecycle_test.cpp b/ps2xRuntime/tests/ee_dispatcher_lifecycle_test.cpp
new file mode 100644
index 0000000..4433a86
--- /dev/null
+++ b/ps2xRuntime/tests/ee_dispatcher_lifecycle_test.cpp
@@ -0,0 +1,106 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kCallbackPc = 0x400000u;
+constexpr uint32_t kWorkerPc = 0x400004u;
+constexpr uint32_t kContinuationPc = 0x400008u;
+int calls = 0;
+int continuations = 0;
+
+void callback(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ++calls;
+    // VBlank work requested another dispatch while this IRQ was executing.
+    runtime->eeScheduler().postEvent(EeEvent{EeEventType::ExternalWake, 0u, 0u});
+    (void)runtime->eeScheduler().checkpointDue(32u);
+    ctx->pc = calls == 1 ? kContinuationPc : 0u;
+}
+
+void continuation(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ++continuations;
+    runtime->eeScheduler().postEvent(EeEvent{EeEventType::ExternalWake, 0u, 0u});
+    (void)runtime->eeScheduler().checkpointDue(32u);
+    ctx->pc = 0u;
+}
+
+void busyWorker(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ctx->pc = kWorkerPc;
+    (void)runtime->eeScheduler().checkpointDue(32u);
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kCallbackPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kContinuationPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 3u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[3] = {callback, busyWorker, continuation};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE))
+    {
+        return 1;
+    }
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context main{};
+    main.pc = 0u;
+    scheduler.reset(runtime.memory().getRDRAM(), main);
+    EeThreadCreateParams worker{};
+    worker.entry = kWorkerPc;
+    worker.priority = 40;
+    worker.stack = 0x100000u;
+    worker.stackSize = 0x1000u;
+    const int workerId = scheduler.createThread(worker);
+    if (workerId != 2 || scheduler.startThread(workerId, 0u, main, false) != 0)
+    {
+        std::cerr << "failed to start busy worker\n";
+        return 1;
+    }
+
+    int completed = 0;
+    for (int i = 0; i < 100; ++i)
+    {
+        GuestInvocation invocation{};
+        invocation.context.pc = kCallbackPc;
+        invocation.onComplete = [&](const R5900Context &, R5900Context &)
+        {
+            if (++completed == 100)
+            {
+                scheduler.requestStop();
+            }
+        };
+        scheduler.queueInvocation(std::move(invocation));
+    }
+
+    try
+    {
+        scheduler.run();
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+
+    int dispatcherCount = 0;
+    for (int id = -1; id >= -100; --id)
+    {
+        dispatcherCount += scheduler.thread(id) != nullptr;
+    }
+    if (calls != 100 || continuations != 1 || completed != 100 || dispatcherCount > 2)
+    {
+        std::cerr << "IRQ dispatchers leaked: calls=" << calls
+                  << " continuations=" << continuations
+                  << " completed=" << completed
+                  << " dispatchers=" << dispatcherCount << '\n';
+        return 1;
+    }
+    return 0;
+}
