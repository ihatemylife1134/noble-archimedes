@@ -0,0 +1,14 @@
+#pragma once
+#include "runtime/gs/gs_backend.h"
+#include <memory>
+
+struct GSRegisters;
+
+namespace GSPcsx2 {
+// A selected but unavailable adapter throws; callers must not relabel a fallback.
+std::unique_ptr<GSRasterBackend> CreateBackend(GSRegisters* registers);
+bool IsRawRasterBackend(const GSRasterBackend& backend);
+void FeedGif(GSRasterBackend& backend, unsigned pathIndex, const uint8_t* data, uint32_t sizeBytes);
+void FeedRegister(GSRasterBackend& backend, uint8_t address, uint64_t value);
+void FeedImage(GSRasterBackend& backend, const uint8_t* data, uint32_t sizeBytes);
+}
diff --git a/ps2xRuntime/src/lib/gs/ps2_gs_pgs_bridge.cpp b/ps2xRuntime/src/lib/gs/ps2_gs_pgs_bridge.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ps2_gs_pgs_bridge.cpp
@@ -0,0 +1,699 @@
+#include "ps2_gs_pgs_bridge.h"
+
+#if defined(PS2_GS_HAVE_PGS)
+#include "runtime/gs/ps2_gs_memory.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include "gs_interface.hpp"
+#include "context.hpp"
+#include "device.hpp"
+#include "gs_pgs_profile.h"
+#include "thread_id.hpp"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <mutex>
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+#include <atomic>
+#endif
+
+namespace
+{
+constexpr uint32_t kVramSize = 4u * 1024u * 1024u;
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+std::atomic<void (*)(void *)> snapshotHook{nullptr};
+std::atomic<void *> snapshotHookContext{nullptr};
+void runSnapshotHook()
+{
+    if (const auto hook = snapshotHook.load(std::memory_order_acquire))
+        hook(snapshotHookContext.load(std::memory_order_acquire));
+}
+#endif
+
+void registerThread()
+{
+    // Every device operation is serialized by this backend's mutex.
+    static thread_local bool registered = false;
+    if (!registered)
+    {
+        Util::register_thread_index(0);
+        registered = true;
+    }
+}
+
+uint32_t bitsPerPixel(uint32_t psm)
+{
+    switch (psm)
+    {
+    case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: return 16;
+    case GS_PSM_CT24: case GS_PSM_Z24: return 24;
+    case GS_PSM_T8: case GS_PSM_T8H: return 8;
+    case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: return 4;
+    default: return 32;
+    }
+}
+
+class PgsBackend final : public GSRasterBackend
+{
+public:
+    bool initializeDevice()
+    {
+        registerThread();
+        if (!Vulkan::Context::init_loader(nullptr))
+            return unavailable("Vulkan loader initialization failed");
+        m_context.set_num_thread_indices(1);
+        if (!m_context.init_instance_and_device(nullptr, 0, nullptr, 0))
+            return unavailable("Vulkan device initialization failed");
+        m_device.set_context(m_context);
+        m_device.init_frame_contexts(4);
+        ParallelGS::GSOptions options{};
+        options.vram_size = kVramSize;
+        if (!m_interface.init(&m_device, options))
+            return unavailable("GS device features are unavailable");
+        m_presenter = std::make_unique<GSCpuBackend>();
+        const char *scanout = std::getenv("PS2_GS_PGS_SCANOUT");
+        m_nativeScanout = scanout && std::strcmp(scanout, "native") == 0;
+        m_logicalScanout = !scanout || std::strcmp(scanout, "logical") == 0;
+        m_ready = true;
+        std::fprintf(stderr, "[gs:pgs] offscreen Vulkan backend: %s (1x, %s scanout)\n",
+                     m_device.get_gpu_properties().deviceName, m_nativeScanout ? "native" : m_logicalScanout ? "logical" : "compatible");
+        return true;
+    }
+
+    ~PgsBackend() override
+    {
+        if (m_ready)
+        {
+            registerThread();
+            // Submit retained renderer command buffers before Device waits
+            // for their frame references; member teardown happens afterward.
+            m_interface.flush();
+            m_device.wait_idle();
+        }
+    }
+
+    void Initialize(uint8_t *vram, uint32_t size) override
+    {
+        auto lock = profileLock();
+        registerThread();
+        m_externalVram = vram;
+        m_externalSize = std::min(size, kVramSize);
+        if (m_externalSize && vram)
+        {
+            void *dst = m_interface.map_vram_write(0, m_externalSize);
+            std::memcpy(dst, vram, m_externalSize);
+            m_interface.end_vram_write(0, m_externalSize);
+        }
+        resetUnlocked();
+    }
+
+    void Reset() override
+    {
+        auto lock = profileLock();
+        registerThread();
+        resetUnlocked();
+    }
+
+    // The frontend has already forwarded the original register/GIF stream.
+    void Submit(const GSPrimitiveBatch &) override {}
+    void LoadClut(const GSTex0Reg &, const GSTexClutReg &) override {}
+    void TextureFlush() override {}
+
+    void BeginTransfer(const GSTransferCommand &command) override
+    {
+        auto lock = profileLock();
+        m_transfer = command;
+        m_uploadBytes = m_nativeBytes = 0;
+        m_nativeColdUpload = false;
+        m_nativePublishedPixels = 0;
+        m_imageRemainder.clear();
+        m_nativePayload.clear();
+        m_fifoRemainder.clear();
+        m_fifoOffset = 0;
+        m_transferBytes = (uint64_t(command.trxreg.rrw) * command.trxreg.rrh *
+                           bitsPerPixel(command.direction == 1u ? command.bitbltbuf.spsm : command.bitbltbuf.dpsm) + 7u) / 8u;
+        m_fifoRemaining = command.direction == 1u ? m_transferBytes : 0u;
+    }
+
+    void UploadImage(const uint8_t *, uint32_t size) override
+    {
+        auto lock = profileLock();
+        m_uploadBytes += size;
+    }
+
+    void Flush() override
+    {
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        m_interface.flush();
+    }
+
+    void Sync(GSSyncReason reason) override
+    {
+        auto lock = profileLock();
+        registerThread();
+        if (reason == GSSyncReason::Finish || reason == GSSyncReason::Reset)
+        {
+            flushNativeImageUnlocked();
+            m_interface.flush();
+            {
+                GSParallelProfile::Scope finish(m_profile, GSParallelProfile::Op::Finish);
+                m_device.wait_idle();
+            }
+        }
+        // Presentation submits a fenced copy; guest/debug reads use map_vram_read.
+    }
+
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        // Serialize the reusable immutable snapshot and CPU presenter without
+        // blocking producer-side GPU operations during display conversion.
+        std::unique_lock presentationLock(m_presentationMutex, std::defer_lock);
+        if (!m_nativeScanout)
+            presentationLock.lock();
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        if (m_logicalScanout)
+        {
+            PresentationFrame logicalFrame;
+            if (presentLogicalUnlocked(request, logicalFrame, lock))
+            {
+                m_profile.report();
+                return logicalFrame;
+            }
+        }
+        if (!m_nativeScanout)
+        {
+            // Rasterization stays on Vulkan. Reuse the established pixel-unit
+            // DISPLAY and preferred-source rules for the host scanout contract.
+            m_interface.flush();
+            {
+                GSParallelProfile::Scope readback(m_profile, GSParallelProfile::Op::Map);
+                const auto *data = static_cast<const uint8_t *>(m_interface.map_vram_read(0, kVramSize));
+                m_presentVram.assign(data, data + kVramSize);
+            }
+            const uint64_t epoch = m_presentationEpoch;
+            lock.unlock();
+            PresentationFrame frame;
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+            runSnapshotHook();
+#endif
+            {
+                GSParallelProfile::Scope convert(m_profile, GSParallelProfile::Op::Convert);
+                frame = m_presenter->PresentSnapshot(m_presentVram, request);
+            }
+            const size_t packedSize = size_t(frame.width) * frame.height * 4u;
+            if (frame && frame.pixels.size() != packedSize)
+            {
+                constexpr size_t legacyRowBytes = 640u * 4u;
+                std::vector<uint8_t> packed(packedSize);
+                for (uint32_t y = 0; y < frame.height; ++y)
+                    std::memcpy(packed.data() + size_t(y) * frame.width * 4u,
+                                frame.pixels.data() + size_t(y) * legacyRowBytes, frame.width * 4u);
+                frame.pixels = std::move(packed);
+            }
+            lock = profileLock();
+            m_profile.report();
+            // A concurrent reset/initialize supersedes the captured frame.
+            if (epoch != m_presentationEpoch)
+                return {};
+            return frame;
+        }
+        consumeReadbacksUnlocked();
+        if (request.vsyncTick != m_lastTick)
+        {
+            m_lastTick = request.vsyncTick;
+            auto &priv = m_interface.get_priv_register_state();
+            auto put = [](auto &field, uint64_t value) { std::memcpy(&field, &value, sizeof(value)); };
+            put(priv.pmode, request.pmode);
+            put(priv.smode1, 0x0000000740814504ull);
+            put(priv.smode2, request.smode2);
+            put(priv.dispfb1, request.dispfb1);
+            put(priv.display1, request.display1);
+            put(priv.dispfb2, request.dispfb2);
+            put(priv.display2, request.display2);
+            put(priv.bgcolor, request.bgcolor);
+            ParallelGS::VSyncInfo info{};
+            info.phase = static_cast<uint32_t>(request.vsyncTick & 1u);
+            info.dst_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+            info.dst_stage = VK_PIPELINE_STAGE_2_COPY_BIT;
+            info.dst_access = VK_ACCESS_2_TRANSFER_READ_BIT;
+            info.force_progressive = false;
+            info.anti_blur = false;
+            info.adapt_to_internal_horizontal_resolution = true;
+            info.raw_circuit_scanout = true;
+            m_interface.flush();
+            auto scanout = m_interface.vsync(info);
+            if (scanout.image)
+                queueReadbackUnlocked(scanout, request);
+        }
+        consumeReadbacksUnlocked();
+        return m_latestFrame;
+    }
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+    {
+        if (!context.frame.fbw || (context.frame.psm != GS_PSM_CT32 && context.frame.psm != GS_PSM_CT24 &&
+                                   context.frame.psm != GS_PSM_CT16 && context.frame.psm != GS_PSM_CT16S))
+            return false;
+        auto lock = profileLock();
+        registerThread();
+        GSParallelProfile::Scope clearProfile(m_profile, GSParallelProfile::Op::Clear);
+        // Preserve the host clear helper's raw 16-bit mask semantics exactly.
+        flushNativeImageUnlocked();
+        m_interface.flush();
+        m_interface.map_vram_read(0, kVramSize);
+        auto *data = static_cast<uint8_t *>(m_interface.map_vram_write(0, kVramSize));
+        if ((context.fba & 1u) && context.frame.psm != GS_PSM_CT24)
+            rgba |= 0x80000000u;
+        uint32_t value = rgba;
+        uint32_t mask = context.frame.fbmsk;
+        if (context.frame.psm == GS_PSM_CT16 || context.frame.psm == GS_PSM_CT16S)
+        {
+            value = ((rgba & 0xf8u) >> 3) | ((rgba & 0xf800u) >> 6) |
+                    ((rgba & 0xf80000u) >> 9) | ((rgba & 0x80000000u) >> 16);
+            mask &= 0xffffu;
+        }
+        const uint32_t x0 = context.scissor.x0, x1 = std::max(x0, uint32_t(context.scissor.x1));
+        const uint32_t y0 = context.scissor.y0, y1 = std::max(y0, uint32_t(context.scissor.y1));
+        const uint32_t bp = context.frame.fbp * 32u;
+        auto clear = [&]<uint32_t Psm>()
+        {
+            for (uint32_t y = y0; y <= y1; ++y)
+            {
+                const auto row = GSMem::MakeRowAccess<Psm>(bp, context.frame.fbw, y);
+                for (uint32_t x = x0; x <= x1; ++x)
+                {
+                    uint32_t pixel = value;
+                    if (mask)
+                        pixel = (pixel & ~mask) | (row.Read(data, x) & mask);
+                    row.Write(data, x, static_cast<typename decltype(row)::PackedT>(pixel));
+                }
+            }
+        };
+        switch (context.frame.psm)
+        {
+        case GS_PSM_CT32: clear.template operator()<GS_PSM_CT32>(); break;
+        case GS_PSM_CT24: clear.template operator()<GS_PSM_CT24>(); break;
+        case GS_PSM_CT16: clear.template operator()<GS_PSM_CT16>(); break;
+        case GS_PSM_CT16S: clear.template operator()<GS_PSM_CT16S>(); break;
+        }
+        m_interface.end_vram_write(0, kVramSize);
+        return true;
+    }
+
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override
+    {
+        if (!dst || !maxBytes)
+            return 0;
+        auto lock = profileLock();
+        registerThread();
+        const uint32_t count = static_cast<uint32_t>(std::min<uint64_t>(maxBytes, m_fifoRemaining));
+        if (m_fifoRemainder.size() - m_fifoOffset < count)
+        {
+            const size_t words = (m_fifoRemaining + 15u) / 16u;
+            std::vector<uint8_t> fifo(words * 16u);
+            m_interface.read_transfer_fifo(fifo.data(), static_cast<uint32_t>(words));
+            m_fifoRemainder = std::move(fifo);
+            m_fifoOffset = 0;
+        }
+        if (count)
+            std::memcpy(dst, m_fifoRemainder.data() + m_fifoOffset, count);
+        m_fifoOffset += count;
+        m_fifoRemaining -= count;
+        return count;
+    }
+
+    uint32_t ReadVram(uint32_t psm, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y) const override
+    {
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        m_interface.flush();
+        const auto *data = static_cast<const uint8_t *>(m_interface.map_vram_read(0, kVramSize));
+        return GSMem::ReadInline(psm, data, bp, bw, x, y);
+    }
+
+    void WriteVram(uint32_t psm, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+    {
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        m_interface.flush();
+        m_interface.map_vram_read(0, kVramSize);
+        auto *data = static_cast<uint8_t *>(m_interface.map_vram_write(0, kVramSize));
+        GSMem::WriteInline(psm, data, bp, bw, x, y, value);
+        m_interface.end_vram_write(0, kVramSize);
+    }
+
+    void SnapshotVram(std::vector<uint8_t> &out) const override
+    {
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        m_interface.flush();
+        const auto *data = static_cast<const uint8_t *>(m_interface.map_vram_read(0, kVramSize));
+        out.assign(data, data + kVramSize);
+        if (m_externalVram)
+            std::memcpy(m_externalVram, data, m_externalSize);
+    }
+
+    GSTransferSnapshot GetTransferSnapshot() const override
+    {
+        auto lock = profileLock();
+        GSTransferSnapshot result{};
+        result.direction = m_transfer.direction;
+        result.totalPixels = uint32_t(m_transfer.trxreg.rrw) * m_transfer.trxreg.rrh;
+        result.copiedPixels = m_transfer.direction == 1u || m_transfer.direction == 2u ? result.totalPixels :
+            static_cast<uint32_t>(std::min<uint64_t>(result.totalPixels,
+                                      m_uploadBytes * 8u / bitsPerPixel(m_transfer.bitbltbuf.dpsm)));
+        result.x = m_transfer.trxreg.rrw ? result.copiedPixels % m_transfer.trxreg.rrw : 0u;
+        result.y = m_transfer.trxreg.rrw ? result.copiedPixels / m_transfer.trxreg.rrw : 0u;
+        result.localToHostPendingBytes = static_cast<size_t>(m_fifoRemaining);
+        return result;
+    }
+
+    void feedGif(unsigned path, const uint8_t *data, uint32_t size)
+    {
+        if (!data || size < 16u || path > 2u)
+            return;
+        auto lock = profileLock();
+        registerThread();
+        flushNativeImageUnlocked();
+        GSParallelProfile::Scope profile(m_profile, GSParallelProfile::Op::Gif);
+        m_interface.gif_transfer(path, data, size);
+    }
+
+    void feedRegister(uint8_t address, uint64_t value)
+    {
+        auto lock = profileLock();
+        registerThread();
+        if (address == GS_REG_TRXDIR)
+            flushNativeImageUnlocked();
+        if (address < 0x80u)
+        {
+            GSParallelProfile::Scope profile(m_profile, GSParallelProfile::Op::Register);
+            m_interface.write_register(static_cast<ParallelGS::RegisterAddr>(address), value);
+        }
+    }
+
+    void feedImage(const uint8_t *data, uint32_t size)
+    {
+        if (!data || !size)
+            return;
+        auto lock = profileLock();
+        registerThread();
+        GSParallelProfile::Scope profile(m_profile, GSParallelProfile::Op::NativeImage);
+        m_nativeBytes += size;
+        m_nativePayload.insert(m_nativePayload.end(), data, data + size);
+        if (m_nativeColdUpload)
+        {
+            flushNativeImageUnlocked();
+            return;
+        }
+        m_imageRemainder.insert(m_imageRemainder.end(), data, data + size);
+        const bool completed = m_transferBytes && m_nativeBytes >= m_transferBytes;
+        const size_t bytes = completed ? (m_imageRemainder.size() + 15u) & ~size_t(15u)
+                                       : m_imageRemainder.size() & ~size_t(15u);
+        if (!bytes)
+            return;
+        m_imageRemainder.resize(std::max(bytes, m_imageRemainder.size()), 0);
+        size_t offset = 0;
+        while (offset < bytes)
+        {
+            const uint32_t words = static_cast<uint32_t>(std::min<size_t>((bytes - offset) / 16u, 0x7fffu));
+            std::vector<uint64_t> packet(2u + size_t(words) * 2u);
+            packet[0] = words | (1ull << 15) | (2ull << 58);
+            packet[1] = 0;
+            std::memcpy(packet.data() + 2, m_imageRemainder.data() + offset, size_t(words) * 16u);
+            // The fourth upstream parser state is reserved for this synthetic
+            // stream; physical PATH3 may be interrupted in the middle of a tag.
+            m_interface.gif_transfer(3u, packet.data(), static_cast<uint32_t>(packet.size() * 8u));
+            offset += size_t(words) * 16u;
+        }
+        m_imageRemainder.erase(m_imageRemainder.begin(), m_imageRemainder.begin() + bytes);
+    }
+
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+    uint64_t logicalScanoutCount() const
+    {
+        auto lock = profileLock();
+        return m_logicalScanouts;
+    }
+    uint64_t logicalReasonCount(unsigned reason) const
+    {
+        return m_profile.logicalReasonCount(reason);
+    }
+#endif
+
+private:
+#include "gs_pgs_logical_scanout.h"
+    struct Readback
+    {
+        Vulkan::BufferHandle buffer;
+        Vulkan::ImageHandle image;
+        Vulkan::Fence fence;
+        uint32_t width = 0, height = 0, displayFbp = 0;
+        uint64_t tick = 0;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        bool pending = false;
+    };
+
+    static bool unavailable(const char *reason)
+    {
+        std::fprintf(stderr, "[gs:pgs] %s; keeping CPU backend\n", reason);
+        return false;
+    }
+
+    std::unique_lock<std::recursive_mutex> profileLock() const
+    {
+        std::unique_lock<std::recursive_mutex> lock(m_mutex, std::defer_lock);
+        GSParallelProfile::Scope wait(m_profile, GSParallelProfile::Op::Mutex);
+        lock.lock();
+        return lock;
+    }
+
+    void flushNativeImageUnlocked() const
+    {
+        const uint32_t psm = m_transfer.bitbltbuf.dpsm, bpp = bitsPerPixel(psm);
+        if (m_transfer.direction != 0u)
+            return;
+        if (!m_nativeColdUpload)
+        {
+            if (m_imageRemainder.empty())
+                return;
+            // Publish the earlier whole-qword stream before switching this
+            // transfer to incremental cold writes. Do not submit those bytes
+            // again after an intervening draw, clear or direct VRAM write.
+            m_interface.flush();
+            m_nativePublishedPixels = (m_nativeBytes - m_imageRemainder.size()) * 8u / bpp;
+            m_nativeColdUpload = true;
+        }
+        const uint32_t width = m_transfer.trxreg.rrw;
+        const uint64_t pixels = std::min<uint64_t>(uint64_t(width) * m_transfer.trxreg.rrh,
+                                                  m_nativePayload.size() * 8u / bpp);
+        if (pixels <= m_nativePublishedPixels)
+            return;
+        GSParallelProfile::Scope profile(m_profile, GSParallelProfile::Op::NativeCold);
+        m_interface.flush();
+        m_interface.map_vram_read(0, kVramSize);
+        auto *data = static_cast<uint8_t *>(m_interface.map_vram_write(0, kVramSize));
+        for (uint64_t pixel = m_nativePublishedPixels; pixel < pixels; ++pixel)
+        {
+            uint32_t value = 0;
+            if (bpp == 4u)
+                value = (m_nativePayload[pixel / 2u] >> ((pixel & 1u) * 4u)) & 15u;
+            else
+                for (uint32_t byte = 0; byte < bpp / 8u; ++byte)
+                    value |= uint32_t(m_nativePayload[pixel * (bpp / 8u) + byte]) << (byte * 8u);
+            GSMem::WriteInline(psm, data, m_transfer.bitbltbuf.dbp,
+                               std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u),
+                               m_transfer.trxpos.dsax + static_cast<uint32_t>(pixel % width),
+                               m_transfer.trxpos.dsay + static_cast<uint32_t>(pixel / width), value);
+        }
+        m_interface.end_vram_write(0, kVramSize);
+        m_nativePublishedPixels = pixels;
+    }
+
+    void resetUnlocked()
+    {
+        ++m_presentationEpoch;
+        // A reset must not publish an older scanout after the new GS state.
+        if (std::any_of(m_readbacks.begin(), m_readbacks.end(), [](const Readback &slot) { return slot.pending; }))
+        {
+            m_interface.flush();
+            m_device.wait_idle();
+        }
+        m_readbacks = {};
+        m_readbackIndex = 0;
+        m_interface.reset_context_state();
+        m_lastTick = std::numeric_limits<uint64_t>::max();
+        m_latestTick = 0;
+        m_latestFrame = {};
+        m_transfer = {};
+        m_uploadBytes = m_nativeBytes = m_transferBytes = m_fifoRemaining = 0;
+        m_nativeColdUpload = false;
+        m_nativePublishedPixels = 0;
+        m_imageRemainder.clear();
+        m_nativePayload.clear();
+        m_fifoRemainder.clear();
+        m_fifoOffset = 0;
+    }
+
+    void consumeReadbacksUnlocked()
+    {
+        for (auto &slot : m_readbacks)
+        {
+            if (!slot.pending || !slot.fence || !slot.fence->wait_timeout(0))
+                continue;
+            if (slot.tick >= m_latestTick)
+            {
+                const auto *source = static_cast<const uint8_t *>(m_device.map_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+                const size_t bytes = size_t(slot.width) * slot.height * 4u;
+                m_latestFrame.pixels.assign(source, source + bytes);
+                if (slot.format == VK_FORMAT_B8G8R8A8_UNORM || slot.format == VK_FORMAT_B8G8R8A8_SRGB)
+                    for (size_t i = 0; i < bytes; i += 4u)
+                        std::swap(m_latestFrame.pixels[i], m_latestFrame.pixels[i + 2u]);
+                m_device.unmap_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+                m_latestFrame.width = slot.width;
+                m_latestFrame.height = slot.height;
+                m_latestFrame.displayFbp = m_latestFrame.sourceFbp = slot.displayFbp;
+                m_latestFrame.usedPreferred = false;
+                m_latestTick = slot.tick;
+            }
+            slot.pending = false;
+            slot.image.reset();
+            slot.fence.reset();
+        }
+    }
+
+    void queueReadbackUnlocked(const ParallelGS::ScanoutResult &scanout, const GSPresentationRequest &request)
+    {
+        auto &slot = m_readbacks[m_readbackIndex];
+        if (slot.pending)
+            return;
+        const uint32_t width = scanout.image->get_width(), height = scanout.image->get_height();
+        if (!slot.buffer || slot.width != width || slot.height != height)
+        {
+            Vulkan::BufferCreateInfo create{};
+            create.size = VkDeviceSize(width) * height * 4u;
+            create.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            create.domain = Vulkan::BufferDomain::CachedHost;
+            slot.buffer = m_device.create_buffer(create);
+            if (!slot.buffer)
+                return;
+        }
+        slot.width = width;
+        slot.height = height;
+        slot.format = scanout.image->get_format();
+        slot.tick = request.vsyncTick;
+        slot.displayFbp = static_cast<uint32_t>(((request.pmode & 1u) ? request.dispfb1 : request.dispfb2) & 0x1ffu);
+        auto command = m_device.request_command_buffer();
+        command->copy_image_to_buffer(*slot.buffer, *scanout.image, 0, {}, {width, height, 1}, 0, 0,
+                                      {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+        command->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_2_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+        m_device.submit(command, &slot.fence);
+        slot.image = scanout.image;
+        slot.pending = true;
+        m_readbackIndex = (m_readbackIndex + 1u) % m_readbacks.size();
+    }
+
+    Vulkan::Context m_context;
+    Vulkan::Device m_device;
+    mutable ParallelGS::GSInterface m_interface;
+    mutable std::recursive_mutex m_mutex;
+    std::mutex m_presentationMutex;
+    uint64_t m_presentationEpoch = 0;
+    mutable GSParallelProfile::Counters m_profile;
+    mutable bool m_nativeColdUpload = false;
+    mutable uint64_t m_nativePublishedPixels = 0;
+    bool m_ready = false;
+    bool m_nativeScanout = false;
+    std::unique_ptr<GSCpuBackend> m_presenter;
+    std::vector<uint8_t> m_presentVram;
+    Vulkan::BufferHandle m_logicalBuffer;
+    uint8_t *m_externalVram = nullptr;
+    uint32_t m_externalSize = 0;
+    GSTransferCommand m_transfer{};
+    uint64_t m_uploadBytes = 0, m_nativeBytes = 0, m_transferBytes = 0, m_fifoRemaining = 0;
+    std::vector<uint8_t> m_imageRemainder, m_nativePayload, m_fifoRemainder;
+    size_t m_fifoOffset = 0;
+    std::array<Readback, 3> m_readbacks{};
+    size_t m_readbackIndex = 0;
+    uint64_t m_lastTick = std::numeric_limits<uint64_t>::max(), m_latestTick = 0;
+    PresentationFrame m_latestFrame;
+};
+}
