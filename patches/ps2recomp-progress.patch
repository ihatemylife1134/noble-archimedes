diff --git a/ps2xRuntime/src/lib/ps2_async_stdio.cpp b/ps2xRuntime/src/lib/ps2_async_stdio.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_async_stdio.cpp
@@ -0,0 +1,221 @@
+#include "runtime/ps2_async_stdio.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#if defined(_WIN32)
+#include <fcntl.h>
+#include <io.h>
+extern "C" __declspec(dllimport) int __stdcall SetStdHandle(unsigned long nStdHandle, void *hHandle);
+#else
+#include <unistd.h>
+#endif
+
+namespace ps2_async_stdio
+{
+    namespace
+    {
+        constexpr size_t kReadChunkBytes = 64u * 1024u;
+        constexpr size_t kMaxBacklogBytes = 32u * 1024u * 1024u;
+
+#if defined(_WIN32)
+        int dupFd(int fd) { return _dup(fd); }
+        int dup2Fd(int from, int to) { return _dup2(from, to); }
+        int closeFd(int fd) { return _close(fd); }
+        int readFd(int fd, void *buffer, size_t size) { return _read(fd, buffer, static_cast<unsigned>(size)); }
+        int writeFd(int fd, const void *buffer, size_t size) { return _write(fd, buffer, static_cast<unsigned>(size)); }
+        bool makePipe(int fds[2]) { return _pipe(fds, 1u << 20, _O_BINARY) == 0; }
+#else
+        int dupFd(int fd) { return ::dup(fd); }
+        int dup2Fd(int from, int to) { return ::dup2(from, to); }
+        int closeFd(int fd) { return ::close(fd); }
+        int readFd(int fd, void *buffer, size_t size) { return static_cast<int>(::read(fd, buffer, size)); }
+        int writeFd(int fd, const void *buffer, size_t size) { return static_cast<int>(::write(fd, buffer, size)); }
+        bool makePipe(int fds[2]) { return ::pipe(fds) == 0; }
+#endif
+
+        std::atomic<uint64_t> g_dropped{0};
+
+        struct Relay
+        {
+            int streamFd = -1;   // 1 or 2
+            int originalFd = -1; // duplicate of the sink the process started with
+            int pipeReadFd = -1;
+            std::mutex mutex;
+            std::condition_variable changed;
+            std::deque<std::string> queue;
+            size_t queuedBytes = 0;
+            uint64_t droppedSinceNote = 0;
+
+            void readLoop()
+            {
+                std::string chunk(kReadChunkBytes, '\0');
+                for (;;)
+                {
+                    const int n = readFd(pipeReadFd, chunk.data(), chunk.size());
+                    if (n <= 0)
+                        return;
+                    std::lock_guard<std::mutex> lock(mutex);
+                    if (queuedBytes + static_cast<size_t>(n) > kMaxBacklogBytes)
+                    {
+                        droppedSinceNote += static_cast<uint64_t>(n);
+                        g_dropped.fetch_add(static_cast<uint64_t>(n), std::memory_order_relaxed);
+                        continue;
+                    }
+                    queue.emplace_back(chunk.data(), static_cast<size_t>(n));
+                    queuedBytes += static_cast<size_t>(n);
+                    changed.notify_all();
+                }
+            }
+
+            void writeAll(const char *data, size_t size)
+            {
+                while (size != 0)
+                {
+                    const int n = writeFd(originalFd, data, size);
+                    if (n <= 0)
+                        return; // sink closed; nothing useful left to do
+                    data += n;
+                    size -= static_cast<size_t>(n);
+                }
+            }
+
+            void writeLoop()
+            {
+                for (;;)
+                {
+                    std::string next;
+                    uint64_t dropped = 0;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        changed.wait(lock, [this]() { return !queue.empty() || droppedSinceNote != 0; });
+                        dropped = droppedSinceNote;
+                        droppedSinceNote = 0;
+                        if (!queue.empty())
+                        {
+                            next = std::move(queue.front());
+                            queue.pop_front();
+                        }
+                    }
+                    if (dropped != 0)
+                    {
+                        char note[96];
+                        const int length = std::snprintf(note, sizeof(note),
+                                                         "\n[async-stdio] dropped %llu bytes of backlog\n",
+                                                         static_cast<unsigned long long>(dropped));
+                        if (length > 0)
+                            writeAll(note, static_cast<size_t>(length));
+                    }
+                    if (!next.empty())
+                        writeAll(next.data(), next.size());
+                    {
+                        std::lock_guard<std::mutex> lock(mutex);
+                        queuedBytes -= next.size();
+                    }
+                    changed.notify_all();
+                }
+            }
+
+            bool waitDrained(std::chrono::steady_clock::time_point deadline)
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                return changed.wait_until(lock, deadline, [this]() { return queuedBytes == 0; });
+            }
+        };
+
+        Relay g_relays[2];
+        std::atomic<bool> g_installed{false};
+
+        bool installRelay(Relay &relay, int streamFd)
+        {
+            relay.streamFd = streamFd;
+            relay.originalFd = dupFd(streamFd);
+            if (relay.originalFd < 0)
+                return false; // no sink attached (e.g. GUI launch): leave it alone
+            int fds[2] = {-1, -1};
+            if (!makePipe(fds))
+            {
+                closeFd(relay.originalFd);
+                relay.originalFd = -1;
+                return false;
+            }
+            const int dup2Result = dup2Fd(fds[1], streamFd); // 0 on the CRT, streamFd on POSIX
+            if (dup2Result != 0 && dup2Result != streamFd)
+            {
+                closeFd(fds[0]);
+                closeFd(fds[1]);
+                closeFd(relay.originalFd);
+                relay.originalFd = -1;
+                return false;
+            }
+            closeFd(fds[1]);
+            relay.pipeReadFd = fds[0];
+#if defined(_WIN32)
+            // Keep newline translation where it happened before (on the stream
+            // descriptor) and pass bytes through unchanged to the real sink.
+            _setmode(streamFd, _O_TEXT);
+            _setmode(relay.originalFd, _O_BINARY);
+            constexpr unsigned long kStdOutputHandle = static_cast<unsigned long>(-11);
+            constexpr unsigned long kStdErrorHandle = static_cast<unsigned long>(-12);
+            SetStdHandle(streamFd == 1 ? kStdOutputHandle : kStdErrorHandle,
+                         reinterpret_cast<void *>(_get_osfhandle(streamFd)));
+#endif
+            // Detached: the relay lives for the whole process.
+            std::thread([&relay]() { relay.readLoop(); }).detach();
+            std::thread([&relay]() { relay.writeLoop(); }).detach();
+            return true;
+        }
+    }
+
+    bool install()
+    {
+        const char *disable = std::getenv("PS2_SYNC_STDIO");
+        if (disable && *disable && std::strcmp(disable, "0") != 0)
+            return false;
+        bool expected = false;
+        if (!g_installed.compare_exchange_strong(expected, true))
+            return true;
+
+        std::fflush(stdout);
+        std::fflush(stderr);
+        std::cout.flush();
+        std::cerr.flush();
+        const bool outOk = installRelay(g_relays[0], 1);
+        const bool errOk = installRelay(g_relays[1], 2);
+        std::atexit(flush);
+        return outOk || errOk;
+    }
+
+    void flush()
+    {
+        if (!g_installed.load())
+            return;
+        std::cout.flush();
+        std::cerr.flush();
+        std::fflush(stdout);
+        std::fflush(stderr);
+        // Let the readers pick up bytes still sitting in the pipes, then wait
+        // (bounded) for the writers to hand everything to the real sinks.
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+        for (Relay &relay : g_relays)
+        {
+            if (relay.originalFd >= 0)
+                relay.waitDrained(deadline);
+        }
+    }
+
+    uint64_t droppedBytes()
+    {
+        return g_dropped.load(std::memory_order_relaxed);
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_host_sampler.cpp b/ps2xRuntime/src/lib/ps2_host_sampler.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_sampler.cpp
@@ -0,0 +1,90 @@
+// Opt-in instruction-pointer sampler for host profiling.
+//
+// PS2_RIP_SAMPLES=<file> makes the calling thread (the EE executor) sampled
+// about every 100 us by a background thread. Image-relative RIPs are appended
+// to <file> once per second, so a killed process keeps its samples; symbolize
+// them offline with nm (output/diag_perf/symbolize_samples.py).
+// Declared in runtime/host_profile.h, which is not included here: its minimal
+// Win32 prototypes would conflict with <windows.h>.
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <psapi.h>
+#endif
+
+namespace HostProfile
+{
+    void startRipSamplerForCurrentThread(const char *envName);
+
+    void startRipSamplerForCurrentThread(const char *envName)
+    {
+#if defined(_WIN32)
+        const char *path = std::getenv(envName);
+        if (!path || !*path)
+            return;
+        HANDLE target = nullptr;
+        if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &target,
+                             THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0))
+            return;
+        FILE *out = std::fopen(path, "w");
+        if (!out)
+            return;
+        // Header: every loaded module as "module <base> <size> <path>", so
+        // absolute RIPs can be symbolized per module offline.
+        {
+            HMODULE modules[512];
+            DWORD needed = 0;
+            if (K32EnumProcessModules(GetCurrentProcess(), modules, sizeof(modules), &needed))
+            {
+                for (DWORD i = 0; i < needed / sizeof(HMODULE) && i < 512u; ++i)
+                {
+                    MODULEINFO info{};
+                    char name[MAX_PATH] = {};
+                    if (K32GetModuleInformation(GetCurrentProcess(), modules[i], &info, sizeof(info)) &&
+                        GetModuleFileNameA(modules[i], name, MAX_PATH))
+                        std::fprintf(out, "module %llx %lx %s\n",
+                                     static_cast<unsigned long long>(reinterpret_cast<uint64_t>(info.lpBaseOfDll)),
+                                     static_cast<unsigned long>(info.SizeOfImage), name);
+                }
+            }
+            std::fflush(out);
+        }
+        std::thread([target, out]() {
+            const uint64_t base = 0u; // absolute RIPs (see module header)
+            std::vector<uint64_t> samples;
+            samples.reserve(16384);
+            auto lastFlush = std::chrono::steady_clock::now();
+            for (;;)
+            {
+                if (SuspendThread(target) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT context{};
+                    context.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(target, &context))
+                        samples.push_back(context.Rip - base);
+                    ResumeThread(target);
+                }
+                const auto next = std::chrono::steady_clock::now() + std::chrono::microseconds(100);
+                while (std::chrono::steady_clock::now() < next)
+                {
+                }
+                if (std::chrono::steady_clock::now() - lastFlush >= std::chrono::seconds(1))
+                {
+                    for (uint64_t rva : samples)
+                        std::fprintf(out, "%llx\n", static_cast<unsigned long long>(rva));
+                    std::fflush(out);
+                    samples.clear();
+                    lastFlush = std::chrono::steady_clock::now();
+                }
+            }
+        }).detach();
+#endif
+    }
+}
diff --git a/ps2xRuntime/src/lib/dmac_pending_count.h b/ps2xRuntime/src/lib/dmac_pending_count.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/dmac_pending_count.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <atomic>
+#include <cassert>
+#include <cstdint>
+// Translation-unit sidecar: zero permits a linearizable empty poll.
+// Queue operations retain their original mutex. Publish after a successful push;
+// remove only the number actually swapped out or discarded under that mutex.
+namespace NobleDmacPending {
+static std::atomic<uint64_t> count{0};
+static inline bool any(){return count.load(std::memory_order_acquire)!=0;}
+static inline void published(uint64_t n=1){count.fetch_add(n,std::memory_order_release);}
+static inline void removed(uint64_t n){auto old=count.fetch_sub(n,std::memory_order_release);assert(old>=n);(void)old;}
+}
diff --git a/ps2xRuntime/src/lib/vif1_worker_memory.cpp b/ps2xRuntime/src/lib/vif1_worker_memory.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vif1_worker_memory.cpp
@@ -0,0 +1,315 @@
+#include "runtime/vif1_worker_device.h"
+#include "vif1_worker_memory_internal.inc"
+#include "vif1_worker_queue.h"
+
+#include "gs/gs_raw_feed.h"
+#include "runtime/ps2_memory.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <immintrin.h>
+#include <memory>
+#include <stdexcept>
+#include <utility>
+
+namespace {
+constexpr size_t kMaximumInputBytes = 16u * 1024u * 1024u;
+
+struct Controls {
+    alignas(16) unsigned char bytes[512]{};
+
+    Controls() noexcept { _fxsave64(bytes); }
+    void set() const noexcept {
+        __asm__ volatile("fxrstor64 %0" :: "m"(bytes)
+                         : "memory", "xmm0", "xmm1", "xmm2", "xmm3",
+                           "xmm4", "xmm5", "xmm6", "xmm7", "xmm8",
+                           "xmm9", "xmm10", "xmm11", "xmm12", "xmm13",
+                           "xmm14", "xmm15", "st", "st(1)", "st(2)",
+                           "st(3)", "st(4)", "st(5)", "st(6)", "st(7)");
+    }
+};
+
+struct RestoreControls {
+    Controls saved;
+    ~RestoreControls() noexcept { saved.set(); }
+};
+
+struct Action {
+    enum class Kind : uint8_t { Packet, Mask } kind = Kind::Packet;
+    GifPathId path = GifPathId::Path1;
+    std::vector<uint8_t> bytes;
+    bool drain = false;
+    bool directHl = false;
+    bool continuation = false;
+    bool masked = false;
+};
+
+struct Device {
+    explicit Device(PS2Memory *memory) : owner(memory) {}
+
+    PS2Memory *owner = nullptr;
+    NobleVif1CaptureLaunch captureLaunch;
+    std::unique_ptr<NobleVif1Worker> worker;
+    std::atomic<bool> ready{false};
+    std::vector<Action> actions;
+    NobleVif1Launch launch;
+    uint32_t stoppedBits = 0;
+    bool dma = false;
+    bool committing = false;
+    Device *next = nullptr;
+};
+
+std::atomic<Device *> all{nullptr};
+thread_local Device *workerDevice = nullptr;
+
+Device *lookup(const PS2Memory *owner) noexcept {
+    for (Device *device = all.load(std::memory_order_acquire); device;
+         device = device->next) {
+        if (device->owner == owner)
+            return device;
+    }
+    return nullptr;
+}
+
+class WorkerDeviceScope {
+public:
+    explicit WorkerDeviceScope(Device *device) noexcept
+        : previous(workerDevice) {
+        workerDevice = device;
+    }
+    ~WorkerDeviceScope() noexcept { workerDevice = previous; }
+
+private:
+    Device *previous;
+};
+
+void publish(Device *device) noexcept {
+    Device *head = all.load(std::memory_order_relaxed);
+    do {
+        device->next = head;
+    } while (!all.compare_exchange_weak(head, device,
+                                        std::memory_order_release,
+                                        std::memory_order_relaxed));
+}
+
+void commit(Device &device, NobleVif1Worker::Completion done) {
+    if (!done.completed)
+        return;
+    if (device.committing)
+        return;
+
+    RestoreControls restore;
+    device.committing = true;
+    auto finishCommit = [&]() noexcept { device.committing = false; };
+
+    if (done.error) {
+        device.actions.clear();
+        device.stoppedBits = 0;
+        device.dma = false;
+        device.launch = {};
+        finishCommit();
+        std::rethrow_exception(done.error);
+    }
+
+    std::vector<Action> actions = std::move(device.actions);
+    device.actions.clear();
+    NobleVif1Launch launch = std::move(device.launch);
+    const uint32_t stoppedBits = std::exchange(device.stoppedBits, 0u);
+    const bool dma = std::exchange(device.dma, false);
+
+    try {
+        for (auto &action : actions) {
+            if (action.kind == Action::Kind::Mask) {
+                device.owner->nobleCommitVif1Mask(action.masked);
+                continue;
+            }
+            if (action.continuation) {
+                GSRawFeed::ContinuationScope scope(action.bytes.data());
+                device.owner->submitGifPacket(
+                    action.path, action.bytes.data(),
+                    static_cast<uint32_t>(action.bytes.size()), action.drain,
+                    action.directHl);
+            } else {
+                device.owner->submitGifPacket(
+                    action.path, action.bytes.data(),
+                    static_cast<uint32_t>(action.bytes.size()), action.drain,
+                    action.directHl);
+            }
+        }
+        if (launch.commitStop)
+            launch.commitStop(stoppedBits);
+        if (dma)
+            device.owner->nobleCommitVif1DmaCompletion();
+    } catch (...) {
+        finishCommit();
+        throw;
+    }
+    finishCommit();
+}
+
+bool submitImpl(PS2Memory *owner, std::vector<uint8_t> input,
+                std::function<void(const uint8_t *, uint32_t)> process,
+                bool dma) {
+    if (!owner || !process)
+        return false;
+    if (NobleVif1OnWorker(owner))
+        return false;
+
+    NobleVif1Fence(owner);
+    Device *device = lookup(owner);
+    if (!device || !device->worker)
+        return false;
+    if (input.size() > kMaximumInputBytes)
+        throw std::runtime_error("VIF1 input bound");
+
+    device->actions.clear();
+    device->stoppedBits = 0;
+    device->dma = dma;
+    device->launch = device->captureLaunch ? device->captureLaunch()
+                                           : NobleVif1Launch{};
+    const bool asynchronous = device->launch.asynchronous;
+    Controls caller;
+
+    device->worker->submit(
+        [device, input = std::move(input), process = std::move(process),
+         caller]() mutable {
+            WorkerDeviceScope scope(device);
+            caller.set();
+            process(input.data(), static_cast<uint32_t>(input.size()));
+        });
+
+    if (!asynchronous)
+        NobleVif1Fence(owner);
+    return true;
+}
+} // namespace
+
+void NobleVif1Configure(PS2Memory *owner, NobleVif1CaptureLaunch capture,
+                        std::function<void()> cleanupOnWorker) {
+    NobleVif1Shutdown(owner);
+    auto *device = new Device(owner); // Immutable registry nodes live for process lifetime.
+    device->captureLaunch = std::move(capture);
+    publish(device);
+    device->worker = std::make_unique<NobleVif1Worker>(
+        std::move(cleanupOnWorker), std::function<void()>{}, &device->ready);
+}
+
+void NobleVif1Shutdown(PS2Memory *owner) {
+    Device *device = lookup(owner);
+    if (!device || !device->worker || workerDevice == device)
+        return;
+    bool error = false;
+    try {
+        commit(*device, device->worker->finish());
+    } catch (...) {
+        error = true;
+    }
+    device->worker.reset();
+    device->ready.store(false, std::memory_order_release);
+    device->actions.clear();
+    device->launch = {};
+    device->dma = false;
+    if (error)
+        std::fprintf(stderr,
+                     "[vif1-worker] shutdown completed after job/commit error\n");
+}
+
+void NobleVif1Fence(PS2Memory *owner) {
+    if (NobleVif1OnWorker(owner))
+        return;
+    Device *device = lookup(owner);
+    if (!device || !device->worker || workerDevice == device ||
+        device->committing)
+        return;
+    commit(*device, device->worker->finish());
+}
+
+void NobleVif1Poll(PS2Memory *owner) {
+    if (!NobleVif1CompletionReady(owner) || NobleVif1OnWorker(owner))
+        return;
+    Device *device = lookup(owner);
+    if (!device || !device->worker || workerDevice == device ||
+        device->committing)
+        return;
+    commit(*device, device->worker->tryComplete());
+}
+
+bool NobleVif1CompletionReady(const PS2Memory *owner) noexcept {
+    Device *device = lookup(owner);
+    return device && device->worker &&
+           device->ready.load(std::memory_order_acquire);
+}
+
+bool NobleVif1OnWorker(const PS2Memory *owner) noexcept {
+    return workerDevice && workerDevice->owner == owner;
+}
+
+uint32_t NobleVif1WorkerFbrst(const PS2Memory *owner) {
+    Device *device = lookup(owner);
+    return device ? device->launch.fbrst : 0u;
+}
+
+void NobleVif1WorkerStop(PS2Memory *owner, uint32_t stoppedBits) {
+    if (workerDevice && workerDevice->owner == owner)
+        workerDevice->stoppedBits = stoppedBits & 0x0600u;
+}
+
+bool NobleVif1CapturePacket(PS2Memory *owner, GifPathId path,
+                            const uint8_t *bytes, uint32_t size, bool drain,
+                            bool directHl) {
+    if (!workerDevice || workerDevice->owner != owner)
+        return false;
+    Action action;
+    action.kind = Action::Kind::Packet;
+    action.path = path;
+    action.drain = drain;
+    action.directHl = directHl;
+    action.continuation =
+        path == GifPathId::Path2 && bytes == GSRawFeed::continuationPacket;
+    action.bytes.assign(bytes, bytes + size);
+    workerDevice->actions.emplace_back(std::move(action));
+    return true;
+}
+
+bool NobleVif1CaptureMask(PS2Memory *owner, bool masked) {
+    if (!workerDevice || workerDevice->owner != owner)
+        return false;
+    Action action;
+    action.kind = Action::Kind::Mask;
+    action.masked = masked;
+    workerDevice->actions.emplace_back(std::move(action));
+    return true;
+}
+
+bool NobleVif1Submit(
+    PS2Memory *owner, std::vector<uint8_t> input,
+    std::function<void(const uint8_t *, uint32_t)> process) {
+    return submitImpl(owner, std::move(input), std::move(process), false);
+}
+
+bool NobleVif1SubmitDma(
+    PS2Memory *owner, std::vector<uint8_t> input,
+    std::function<void(const uint8_t *, uint32_t)> process) {
+    return submitImpl(owner, std::move(input), std::move(process), true);
+}
+
+bool NobleVif1Configured(const PS2Memory *owner) noexcept {
+    Device *device = lookup(owner);
+    return device && bool(device->worker);
+}
+
+bool NobleVif1DmaOutstanding(const PS2Memory *owner) noexcept {
+    Device *device = lookup(owner);
+    return device && device->worker && device->dma && device->worker->busy();
+}
+
+bool NobleVif1AnyCompletionReady() noexcept {
+    for (Device *device = all.load(std::memory_order_acquire); device;
+         device = device->next) {
+        if (device->worker && device->ready.load(std::memory_order_acquire))
+            return true;
+    }
+    return false;
+}
diff --git a/ps2xRuntime/src/lib/vif1_worker_memory_internal.inc b/ps2xRuntime/src/lib/vif1_worker_memory_internal.inc
