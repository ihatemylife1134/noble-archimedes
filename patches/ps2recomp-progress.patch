+bool GSCpuBackend::DrawSpriteTexturedFast(const RasterContext &rc, const GSDrawState &state, const SpriteSetup &setup)
+{
+    const auto &ctx = state.context;
+    const uint8_t psm = ctx.tex0.psm;
+    const bool linear = state.linearFilter;
+    if (setup.drawX1 - setup.drawX0 + 1 > kMaxSpriteColumns)
+        return false;
+
+    // Rows are textured before they are written. That matches the per-pixel
+    // order only while the draw cannot sample the pages it writes.
+    const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    const bool depthUsed = ztestMethod >= 2u || !ctx.zbuf.zmask;
+    RowWriter writer = SelectRowWriter(ctx.frame.psm, ctx.zbuf.psm, depthUsed);
+    bool directTexture = false;
+    if (writer)
+    {
+        PageBits written;
+        const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+        markPages(written, ctx.frame.fbp, false, fbw, ctx.frame.psm, setup.drawX0, setup.drawX1, setup.drawY0, setup.drawY1);
+        if (depthUsed)
+            markPages(written, ctx.zbuf.zbp, false, fbw, ctx.zbuf.psm, setup.drawX0, setup.drawX1, setup.drawY0, setup.drawY1);
+        const uint64_t clamp = ctx.clamp;
+        const int maxU = (clamp & 0x2u) != 0u ? 1023 : std::max<int>(state.textureWidth, 1) - 1;
+        const int maxV = (clamp & 0x8u) != 0u ? 1023 : std::max<int>(state.textureHeight, 1) - 1;
+        PageBits sampled;
+        markPages(sampled, ctx.tex0.tbp0 >> 5u, (ctx.tex0.tbp0 & 31u) != 0u, ctx.tex0.tbw, ctx.tex0.psm, 0, maxU, 0, maxV);
+        if ((written & sampled).any())
+        {
+            writer = nullptr;
+        }
+        else if (m_vram && rc.cache)
+        {
+            // Nothing writes the sampled pages during this draw: this one does
+            // not, and the threaded scheduler orders every other writer
+            // around it. Reads through the cache then return local memory,
+            // unless the page it holds from earlier is sampled and stale.
+            const uint32_t cachedPage = rc.cache->PageBase();
+            directTexture = cachedPage == UINT32_MAX ||
+                            !sampled.test((cachedPage / GSMem::TexturePageCache::kPageSize) & 511u) ||
+                            rc.cache->MatchesMemory(m_vram);
+        }
+    }
+
+#define PS2_SPRITE_CASE(value)                                                  \
+    case value:                                                                 \
+        if (linear)                                                             \
+            DrawSpriteTexturedRows<value, true>(rc, state, setup, writer, directTexture); \
+        else                                                                    \
+            DrawSpriteTexturedRows<value, false>(rc, state, setup, writer, directTexture); \
+        return true;
+    switch (psm)
+    {
+        PS2_SPRITE_CASE(GS_PSM_CT32)
+        PS2_SPRITE_CASE(GS_PSM_CT24)
+        PS2_SPRITE_CASE(GS_PSM_CT16)
+        PS2_SPRITE_CASE(GS_PSM_CT16S)
+        PS2_SPRITE_CASE(GS_PSM_T8)
+        PS2_SPRITE_CASE(GS_PSM_T4)
+        PS2_SPRITE_CASE(GS_PSM_T8H)
+        PS2_SPRITE_CASE(GS_PSM_T4HL)
+        PS2_SPRITE_CASE(GS_PSM_T4HH)
+        PS2_SPRITE_CASE(GS_PSM_Z32)
+        PS2_SPRITE_CASE(GS_PSM_Z24)
+        PS2_SPRITE_CASE(GS_PSM_Z16)
+        PS2_SPRITE_CASE(GS_PSM_Z16S)
+    default:
+        return false;
+    }
+#undef PS2_SPRITE_CASE
+}
+
+template <uint32_t kTexPsm, bool kLinear>
+void GSCpuBackend::DrawSpriteTexturedRows(const RasterContext &rc, const GSDrawState &state, const SpriteSetup &setup,
+                                          RowWriter writer, bool directTexture)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    const bool fst = state.prim.fst;
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    const uint8_t wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    const uint16_t maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    const uint16_t maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+
+    bool anyRow = false;
+    for (int y = setup.drawY0; y <= setup.drawY1 && !anyRow; ++y)
+        anyRow = rc.ownsRow(y);
+    if (!anyRow || !m_vram)
+        return;
+
+    constexpr bool kIndexed = kTexPsm == GS_PSM_T8 || kTexPsm == GS_PSM_T4 || kTexPsm == GS_PSM_T8H ||
+                              kTexPsm == GS_PSM_T4HL || kTexPsm == GS_PSM_T4HH;
+    constexpr uint32_t kPaletteSize = (kTexPsm == GS_PSM_T8 || kTexPsm == GS_PSM_T8H) ? 256u : 16u;
+    uint32_t palette[kIndexed ? kPaletteSize : 1u];
+    if constexpr (kIndexed)
+    {
+        for (uint32_t i = 0; i < kPaletteSize; ++i)
+            palette[i] = LookupCLUT(*rc.clut, state, static_cast<u8>(i), tex.cpsm, tex.csm, tex.csa, tex.psm);
+    }
+    const GSTexaReg texa = state.texa;
+    const uint8_t texPsm = tex.psm;
+    const u32 tbp0 = tex.tbp0;
+    const u32 tbw = tex.tbw;
+    const uint8_t *const vram = m_vram;
+    GSMem::TexturePageCache *const cache = rc.cache;
+    // directTexture: every texel read through the cache would return what
+    // local memory holds (see DrawSpriteTexturedFast), so read it directly and
+    // leave the cache as the last miss would have.
+    GSMem::TexturePageCache *const readCache = directTexture ? nullptr : cache;
+    u32 lastTexelAddress = 0u;
+    bool readTexel = false;
+
+    // SampleTexture's samplePoint decode for a raw texel.
+    auto decode = [&](u32 raw) __attribute__((always_inline)) -> uint32_t
+    {
+        if constexpr (kTexPsm == GS_PSM_CT32 || kTexPsm == GS_PSM_Z32 || kTexPsm == GS_PSM_CT24 || kTexPsm == GS_PSM_Z24)
+            return applyTexa(texa, texPsm, raw);
+        else if constexpr (kTexPsm == GS_PSM_CT16 || kTexPsm == GS_PSM_CT16S || kTexPsm == GS_PSM_Z16 || kTexPsm == GS_PSM_Z16S)
+            return applyTexa(texa, texPsm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+        else
+            return palette[static_cast<u8>(raw) & (kPaletteSize - 1u)];
+    };
+
+    SpriteColumn columns[kMaxSpriteColumns];
+    for (int x = setup.drawX0; x <= setup.drawX1; ++x)
+    {
+        const float tx = (static_cast<float>(x - setup.unclippedX0) + 0.5f) / setup.spriteW;
+        const float texUf = setup.u0f + (setup.u1f - setup.u0f) * tx;
+        const float coord = spriteSampleCoordinate(texUf, fst, texW);
+        SpriteColumn &column = columns[x - setup.drawX0];
+        if constexpr (kLinear)
+        {
+            const float sample = coord - 0.5f;
+            const int u0 = static_cast<int>(std::floor(sample));
+            column.fx = sample - static_cast<float>(u0);
+            column.u0 = wrapTextureCoordinate(u0, texW, wrapU, minU, maxU);
+            column.u1 = wrapTextureCoordinate(u0 + 1, texW, wrapU, minU, maxU);
+        }
+        else
+        {
+            column.u0 = wrapTextureCoordinate(static_cast<int>(coord), texW, wrapU, minU, maxU);
+            column.u1 = column.u0;
+            column.fx = 0.0f;
+        }
+    }
+
+    PixelRowSetup pipe;
+    if (writer)
+        InitPixelRowSetup(pipe, state);
+    uint32_t colors[kMaxSpriteColumns];
+    const uint8_t vr = setup.r, vg = setup.g, vb = setup.b, va = setup.a;
+
+    for (int y = setup.drawY0; y <= setup.drawY1; ++y)
+    {
+        if (!rc.ownsRow(y))
+            continue;
+        const float ty = (static_cast<float>(y - setup.unclippedY0) + 0.5f) / setup.spriteH;
+        const float texVf = setup.v0f + (setup.v1f - setup.v0f) * ty;
+        const float coordV = spriteSampleCoordinate(texVf, fst, texH);
+        int v0 = 0, v1 = 0;
+        float fy = 0.0f;
+        if constexpr (kLinear)
+        {
+            const float sample = coordV - 0.5f;
+            const int iv = static_cast<int>(std::floor(sample));
+            fy = sample - static_cast<float>(iv);
+            v0 = wrapTextureCoordinate(iv, texH, wrapV, minV, maxV);
+            v1 = wrapTextureCoordinate(iv + 1, texH, wrapV, minV, maxV);
+        }
+        else
+        {
+            v0 = wrapTextureCoordinate(static_cast<int>(coordV), texH, wrapV, minV, maxV);
+        }
+        const auto row0 = GSMem::MakeRowAccess<kTexPsm>(tbp0, tbw, static_cast<u32>(v0));
+        const auto row1 = GSMem::MakeRowAccess<kTexPsm>(tbp0, tbw, static_cast<u32>(v1));
+        const __m128 fyv = _mm_set1_ps(fy);
+        if (directTexture)
+        {
+            // The last texel this row reads (the cache's page after a miss).
+            const SpriteColumn &last = columns[setup.drawX1 - setup.drawX0];
+            lastTexelAddress = kLinear ? row1.ByteAddress(static_cast<u32>(last.u1))
+                                       : row0.ByteAddress(static_cast<u32>(last.u0));
+            readTexel = true;
+        }
+
+        for (int x = setup.drawX0; x <= setup.drawX1; ++x)
+        {
+            const SpriteColumn &column = columns[x - setup.drawX0];
+            uint32_t texel;
+            if constexpr (kLinear)
+            {
+                const uint32_t c00 = decode(row0.Read(vram, static_cast<u32>(column.u0), readCache));
+                const uint32_t c10 = decode(row0.Read(vram, static_cast<u32>(column.u1), readCache));
+                const uint32_t c01 = decode(row1.Read(vram, static_cast<u32>(column.u0), readCache));
+                const uint32_t c11 = decode(row1.Read(vram, static_cast<u32>(column.u1), readCache));
+                texel = bilinearTexel(c00, c10, c01, c11, _mm_set1_ps(column.fx), fyv);
+            }
+            else
+            {
+                texel = decode(row0.Read(vram, static_cast<u32>(column.u0), readCache));
+            }
+
+            const TextureCombineResult color = combineTexture(tex, vr, vg, vb, va,
+                                                              static_cast<uint8_t>(texel & 0xFFu),
+                                                              static_cast<uint8_t>((texel >> 8) & 0xFFu),
+                                                              static_cast<uint8_t>((texel >> 16) & 0xFFu),
+                                                              static_cast<uint8_t>(texel >> 24));
+            if (writer)
+                colors[x - setup.drawX0] = pack32(color.r, color.g, color.b, color.a);
+            else
+                WritePixel(state, x, y, static_cast<int>(setup.z), color.r, color.g, color.b, color.a, setup.fog);
+        }
+        if (writer)
+            (this->*writer)(state, pipe, y, setup.drawX0, setup.drawX1, colors, setup.z, setup.fog);
+    }
+    if (readTexel)
+        cache->Load(vram, lastTexelAddress);
+}
