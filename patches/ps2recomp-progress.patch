+    // Spin briefly, then block. Notifiers publish their state change before
+    // checking the sleeper count; the timeout is a backstop, not a mechanism.
+    template <typename Predicate>
+    void waitUntil(std::mutex &mutex, std::condition_variable &cv, std::atomic<uint32_t> &sleepers, Predicate done)
+    {
+        for (int i = 0; i < 4096; ++i)
+        {
+            if (done())
+                return;
+            _mm_pause();
+        }
+        for (int i = 0; i < 64; ++i)
+        {
+            if (done())
+                return;
+            std::this_thread::yield();
+        }
+        std::unique_lock<std::mutex> lock(mutex);
+        sleepers.fetch_add(1u, std::memory_order_seq_cst);
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        while (!done())
+            cv.wait_for(lock, std::chrono::milliseconds(2));
+        sleepers.fetch_sub(1u, std::memory_order_seq_cst);
+    }
