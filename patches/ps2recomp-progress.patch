+    // Conservative screen-space bounding box of a primitive after XYOFFSET,
+    // clipped to the scissor. Returns false when nothing can be drawn.
+    bool primitiveBounds(const GSPrimitiveBatch &batch, int &x0, int &x1, int &y0, int &y1)
+    {
+        const GSContext &ctx = batch.state.context;
+        const uint32_t count = batch.state.prim.type == GS_PRIM_POINT ? 1u
+                             : (batch.state.prim.type == GS_PRIM_TRIANGLE || batch.state.prim.type == GS_PRIM_TRISTRIP ||
+                                batch.state.prim.type == GS_PRIM_TRIFAN) ? 3u
+                                                                        : 2u;
+        const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        float minX = batch.vertices[0].x, maxX = minX, minY = batch.vertices[0].y, maxY = minY;
+        for (uint32_t i = 1; i < count; ++i)
+        {
+            minX = std::min(minX, batch.vertices[i].x);
+            maxX = std::max(maxX, batch.vertices[i].x);
+            minY = std::min(minY, batch.vertices[i].y);
+            maxY = std::max(maxY, batch.vertices[i].y);
+        }
+        if (!std::isfinite(minX) || !std::isfinite(maxX) || !std::isfinite(minY) || !std::isfinite(maxY))
+        {
+            x0 = ctx.scissor.x0;
+            x1 = ctx.scissor.x1;
+            y0 = ctx.scissor.y0;
+            y1 = ctx.scissor.y1;
+            return x0 <= x1 && y0 <= y1;
+        }
+        x0 = std::max<int>(ctx.scissor.x0, static_cast<int>(std::floor(std::max(minX - ofx, -65536.0f))) - 1);
+        x1 = std::min<int>(ctx.scissor.x1, static_cast<int>(std::ceil(std::min(maxX - ofx, 65536.0f))) + 1);
+        y0 = std::max<int>(ctx.scissor.y0, static_cast<int>(std::floor(std::max(minY - ofy, -65536.0f))) - 1);
+        y1 = std::min<int>(ctx.scissor.y1, static_cast<int>(std::ceil(std::min(maxY - ofy, 65536.0f))) + 1);
+        return x0 <= x1 && y0 <= y1;
+    }
