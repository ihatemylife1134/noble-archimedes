+    // Marks every page a (bp, bw, psm) buffer can touch inside the pixel
+    // rectangle [x0, x1] x [y0, y1]. Mirrors GSMem::PixelStorageTraits::PageId;
+    // a base that is not page aligned may spill into the following page.
+    void markPages(PageBits &pages, uint32_t basePage, bool unalignedBase, uint32_t bw, uint8_t psm,
+                   int x0, int x1, int y0, int y1)
+    {
+        x0 = std::max(x0, 0);
+        y0 = std::max(y0, 0);
+        x1 = std::min(x1, 2047);
+        y1 = std::min(y1, 2047);
+        if (x1 < x0 || y1 < y0)
+            return;
+        uint32_t pageWidth = 64u;
+        uint32_t pageHeight = 32u;
+        uint32_t pagesPerRow = std::max<uint32_t>(bw, 1u);
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            pageHeight = 64u;
+            break;
+        case GS_PSM_T8:
+            pageWidth = 128u;
+            pageHeight = 64u;
+            pagesPerRow = std::max<uint32_t>(bw / 2u, 1u);
+            break;
+        case GS_PSM_T4:
+            pageWidth = 128u;
+            pageHeight = 128u;
+            pagesPerRow = std::max<uint32_t>(bw / 2u, 1u);
+            break;
+        default:
+            break;
+        }
+        for (uint32_t py = static_cast<uint32_t>(y0) / pageHeight; py <= static_cast<uint32_t>(y1) / pageHeight; ++py)
+        {
+            for (uint32_t px = static_cast<uint32_t>(x0) / pageWidth; px <= static_cast<uint32_t>(x1) / pageWidth; ++px)
