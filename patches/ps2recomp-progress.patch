+    uint32_t configuredGsWorkers()
+    {
+        if (const char *value = std::getenv("PS2_GS_THREADS"); value && *value)
+            return static_cast<uint32_t>(std::max(0, std::atoi(value)));
+        if (const char *trace = std::getenv("PS2_GS_DRAW_TRACE_DIR"); trace && *trace)
+            return 0u; // per-draw VRAM captures need every row of a draw
+        const uint32_t hardware = std::thread::hardware_concurrency();
+        return std::clamp<uint32_t>(hardware / 2u, 1u, 8u);
