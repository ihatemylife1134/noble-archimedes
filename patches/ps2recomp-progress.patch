diff --git a/ps2xRuntime/include/runtime/ee_dispatch_policy.h b/ps2xRuntime/include/runtime/ee_dispatch_policy.h
new file mode 100644
index 0000000..c99a7f4
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ee_dispatch_policy.h
@@ -0,0 +1,34 @@
+#pragma once
+
+enum class EeDispatchChoice
+{
+    Idle,
+    Invocation,
+    Ready,
+};
+
+class EeDispatchPolicy
+{
+public:
+    EeDispatchChoice choose(bool hasPendingInvocation, bool hasReadyThread)
+    {
+        if (hasPendingInvocation && hasReadyThread)
+        {
+            const EeDispatchChoice choice = m_readyNext
+                                                ? EeDispatchChoice::Ready
+                                                : EeDispatchChoice::Invocation;
+            m_readyNext = !m_readyNext;
+            return choice;
+        }
+        if (hasPendingInvocation)
+        {
+            return EeDispatchChoice::Invocation;
+        }
+        return hasReadyThread ? EeDispatchChoice::Ready : EeDispatchChoice::Idle;
+    }
+
+    void reset() { m_readyNext = false; }
+
+private:
+    bool m_readyNext = false;
+};
diff --git a/ps2xRuntime/include/runtime/host_profile.h b/ps2xRuntime/include/runtime/host_profile.h
new file mode 100644
index 0000000..5c9bce4
--- /dev/null
+++ b/ps2xRuntime/include/runtime/host_profile.h
@@ -0,0 +1,160 @@
+#pragma once
+
+// Temporary host-time breakdown for the EE executor. Header-only so it can be
+// added to translation units without changing any class layout.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+#if defined(_WIN32)
+extern "C" __declspec(dllimport) void *__stdcall GetCurrentThread();
+extern "C" __declspec(dllimport) int __stdcall GetThreadTimes(void *, void *, void *, void *, void *);
+#endif
+
+namespace HostProfile
+{
+    // CPU time (user + kernel) consumed by the calling thread, in nanoseconds.
+    inline uint64_t currentThreadCpuNs()
+    {
+#if defined(_WIN32)
+        uint64_t creation = 0, exit = 0, kernel = 0, user = 0;
+        if (GetThreadTimes(GetCurrentThread(), &creation, &exit, &kernel, &user))
+            return (kernel + user) * 100u;
+#endif
+        return 0u;
+    }
+
+    enum Slot : uint32_t
+    {
+        GuestExec,       // recompiled guest function calls from EeScheduler::run
+        WaitForEvent,    // idle waits in EeScheduler::waitForEvent
+        PendingEvents,   // EeScheduler::processPendingEvents
+        IopAdvance,      // PS2Runtime::advanceIopEeCycles from accountCycles
+        GifPacket,       // GS::processGIFPacket (GIF parse + backend work)
+        Draw,            // GSCpuBackend::DrawPrimitive
+        Upload,          // GSCpuBackend::UploadImage
+        Present,         // GSCpuBackend::Present
+        DmaTransfers,    // PS2Memory::processPendingTransfers
+        Vif1,            // PS2Memory::processVIF1Data
+        LoopIteration,   // one EeScheduler::run loop iteration
+        ResumeCompletion,// EeScheduler::run resumeCompletion callbacks
+        GsRingWait,      // producer waiting for GS ring space
+        GsDrainWait,     // producer waiting for queued GS work (any caller)
+        GsDrainPresent,  // ... from SnapshotVram/Present
+        GsDrainTransfer, // ... from local-to-host/local-to-local transfers
+        GsDrainSync,     // ... from Sync (FINISH, reset, debug)
+        GsCmdDraw,       // queued GS commands by kind (counts only)
+        GsCmdDrawAll,
+        GsCmdBarrier,
+        GsCmdUpload,
+        GsCmdClut,
+        GsCmdFlush,
+        GsCmdPresent,
+        GsExclusiveWork, // worker 0 time inside exclusive commands
+        SlotCount
+    };
+
+    inline constexpr const char *kSlotNames[SlotCount] = {
+        "guestExec", "waitForEvent", "pendingEvents", "iopAdvance", "gifPacket",
+        "draw", "upload", "present", "dmaTransfers", "vif1", "loopIteration", "resumeCompletion",
+        "gsRingWait", "gsDrainWait", "gsDrainPresent", "gsDrainTransfer", "gsDrainSync",
+        "cmdDraw", "cmdDrawAll", "cmdBarrier", "cmdUpload", "cmdClut", "cmdFlush", "cmdPresent", "exclusiveWork"};
+
+    // <envName>=<file>: sample the calling thread's RIP into <file>
+    // (ps2_host_sampler.cpp). Call once per thread.
+    void startRipSamplerForCurrentThread(const char *envName);
+
+    inline std::atomic<uint64_t> g_ns[SlotCount]{};
+    inline std::atomic<uint64_t> g_calls[SlotCount]{};
+    inline std::atomic<uint64_t> g_checkpoints{0};
+    // DMA completion delivery: host time from queueing a completed DMAC cause
+    // to dispatching its handlers (first queued cause of each batch).
+    inline std::atomic<uint64_t> g_dmacQueuedAtNs{0};
+    inline std::atomic<uint64_t> g_dmacLatencyNs{0};
+    inline std::atomic<uint64_t> g_dmacDeliveries{0};
+
+    inline uint64_t nowNs()
+    {
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+    }
+
+    struct Scope
+    {
+        Slot slot;
+        uint64_t start;
+        explicit Scope(Slot s) : slot(s), start(nowNs()) {}
+        ~Scope()
+        {
+            g_ns[slot].fetch_add(nowNs() - start, std::memory_order_relaxed);
+            g_calls[slot].fetch_add(1u, std::memory_order_relaxed);
+        }
+    };
+
+    // PS2_HOST_PROFILE_FILE redirects the report away from stderr.
+    inline FILE *reportStream()
+    {
+        static FILE *stream = []() -> FILE *
+        {
+            const char *path = std::getenv("PS2_HOST_PROFILE_FILE");
+            FILE *file = (path && *path) ? std::fopen(path, "w") : nullptr;
+            return file ? file : stderr;
+        }();
+        return stream;
+    }
+
+    // Called from the EE executor loop; prints at most every five seconds.
+    inline void maybeReport(uint64_t eeCycle, uint64_t vsyncTick)
+    {
+        static uint64_t lastNs = nowNs();
+        static uint64_t lastSlotNs[SlotCount]{};
+        static uint64_t lastCalls[SlotCount]{};
+        static uint64_t lastCycle = 0;
+        static uint64_t lastVsync = 0;
+        static uint64_t lastCheckpoints = 0;
+        static uint64_t lastThreadCpu = currentThreadCpuNs();
+        const uint64_t now = nowNs();
+        if (now - lastNs < 5'000'000'000ull)
+            return;
+        FILE *out = reportStream();
+        static uint64_t lastDmacLatency = 0, lastDmacDeliveries = 0;
+        const uint64_t dmacLatency = g_dmacLatencyNs.load(std::memory_order_relaxed);
+        const uint64_t dmacDeliveries = g_dmacDeliveries.load(std::memory_order_relaxed);
+        const uint64_t deliveries = dmacDeliveries - lastDmacDeliveries;
+        std::fprintf(out, "[dmac-latency] deliveries=+%llu meanUs=%.1f\n",
+                     static_cast<unsigned long long>(deliveries),
+                     deliveries ? static_cast<double>(dmacLatency - lastDmacLatency) / 1e3 / static_cast<double>(deliveries) : 0.0);
+        lastDmacLatency = dmacLatency;
+        lastDmacDeliveries = dmacDeliveries;
+        const double wallMs = static_cast<double>(now - lastNs) / 1e6;
+        const uint64_t checkpoints = g_checkpoints.load(std::memory_order_relaxed);
+        const uint64_t threadCpu = currentThreadCpuNs();
+        std::fprintf(out, "[host-profile] eeThreadCpuMs=%.0f ", static_cast<double>(threadCpu - lastThreadCpu) / 1e6);
+        lastThreadCpu = threadCpu;
+        std::fprintf(out, "wallMs=%.0f vsync=+%llu (%.2f/s) eeCycles=+%llu checkpoints=+%llu",
+                     wallMs,
+                     static_cast<unsigned long long>(vsyncTick - lastVsync),
+                     static_cast<double>(vsyncTick - lastVsync) * 1000.0 / wallMs,
+                     static_cast<unsigned long long>(eeCycle - lastCycle),
+                     static_cast<unsigned long long>(checkpoints - lastCheckpoints));
+        for (uint32_t i = 0; i < SlotCount; ++i)
+        {
+            const uint64_t ns = g_ns[i].load(std::memory_order_relaxed);
+            const uint64_t calls = g_calls[i].load(std::memory_order_relaxed);
+            std::fprintf(out, " %s=%.0fms/%llu", kSlotNames[i],
+                         static_cast<double>(ns - lastSlotNs[i]) / 1e6,
+                         static_cast<unsigned long long>(calls - lastCalls[i]));
+            lastSlotNs[i] = ns;
+            lastCalls[i] = calls;
+        }
+        std::fprintf(out, "\n");
+        std::fflush(out);
+        lastNs = now;
+        lastCycle = eeCycle;
+        lastVsync = vsyncTick;
+        lastCheckpoints = checkpoints;
+    }
+}
diff --git a/ps2xRuntime/include/runtime/ps2_async_stdio.h b/ps2xRuntime/include/runtime/ps2_async_stdio.h
new file mode 100644
index 0000000..6e47bb6
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_async_stdio.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2_async_stdio
+{
+    // Redirects file descriptors 1 and 2 through in-process pipes drained by
+    // background threads, so a slow or blocked console/file/pipe never stalls
+    // the thread that logs. Output is kept in order per stream; if the
+    // in-memory backlog exceeds its bound, the excess is dropped and counted.
+    // Setting PS2_SYNC_STDIO=1 disables the relay. Safe to call once, early.
+    bool install();
+
+    // Flushes C stdio and waits (bounded) for queued output to reach the
+    // original sinks. Registered with atexit() by install().
+    void flush();
+
+    // Bytes dropped because the backlog bound was exceeded.
+    uint64_t droppedBytes();
+}
diff --git a/ps2xRuntime/include/runtime/ps2_guest_dispatch_state.h b/ps2xRuntime/include/runtime/ps2_guest_dispatch_state.h
new file mode 100644
index 0000000..12b92a5
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_guest_dispatch_state.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+
+// Per-host-thread state of the guest call stack, shared by the dispatcher,
+// the EE scheduler and runtime code that calls guest functions directly.
+//
+// Generated code unwinds nested guest calls by returning: a callee that stops
+// early leaves ctx->pc at its resume point, dispatchGuestBranch reports false
+// and every generated caller returns in turn. Runtime code that calls a guest
+// function natively (RPC callbacks) expects it to run to completion, so no
+// checkpoint may unwind while such a call is on the stack.
+namespace ps2_guest_dispatch
+{
+    struct NativeGuestCallScope
+    {
+        NativeGuestCallScope();
+        ~NativeGuestCallScope();
+        NativeGuestCallScope(const NativeGuestCallScope &) = delete;
+        NativeGuestCallScope &operator=(const NativeGuestCallScope &) = delete;
+    };
+
+    // True while runtime code is inside a native call of a guest function.
+    bool nativeGuestCallActive() noexcept;
+
+    // Entry PC of the innermost guest function entered through
+    // dispatchGuestBranch (0 at the scheduler's top level). A callee that
+    // returns with ctx->pc equal to its entry PC reads as "returned normally",
+    // so a checkpoint at that PC must not unwind.
+    uint32_t currentCalleeEntryPc() noexcept;
+}
diff --git a/ps2xRuntime/src/lib/ps2_async_stdio.cpp b/ps2xRuntime/src/lib/ps2_async_stdio.cpp
new file mode 100644
index 0000000..1e594b4
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_async_stdio.cpp
@@ -0,0 +1,221 @@
+#include "runtime/ps2_async_stdio.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#if defined(_WIN32)
+#include <fcntl.h>
+#include <io.h>
+extern "C" __declspec(dllimport) int __stdcall SetStdHandle(unsigned long nStdHandle, void *hHandle);
+#else
+#include <unistd.h>
+#endif
+
+namespace ps2_async_stdio
+{
+    namespace
+    {
+        constexpr size_t kReadChunkBytes = 64u * 1024u;
+        constexpr size_t kMaxBacklogBytes = 32u * 1024u * 1024u;
+
+#if defined(_WIN32)
+        int dupFd(int fd) { return _dup(fd); }
+        int dup2Fd(int from, int to) { return _dup2(from, to); }
+        int closeFd(int fd) { return _close(fd); }
+        int readFd(int fd, void *buffer, size_t size) { return _read(fd, buffer, static_cast<unsigned>(size)); }
+        int writeFd(int fd, const void *buffer, size_t size) { return _write(fd, buffer, static_cast<unsigned>(size)); }
+        bool makePipe(int fds[2]) { return _pipe(fds, 1u << 20, _O_BINARY) == 0; }
+#else
+        int dupFd(int fd) { return ::dup(fd); }
+        int dup2Fd(int from, int to) { return ::dup2(from, to); }
+        int closeFd(int fd) { return ::close(fd); }
+        int readFd(int fd, void *buffer, size_t size) { return static_cast<int>(::read(fd, buffer, size)); }
+        int writeFd(int fd, const void *buffer, size_t size) { return static_cast<int>(::write(fd, buffer, size)); }
+        bool makePipe(int fds[2]) { return ::pipe(fds) == 0; }
+#endif
+
+        std::atomic<uint64_t> g_dropped{0};
+
+        struct Relay
+        {
+            int streamFd = -1;   // 1 or 2
+            int originalFd = -1; // duplicate of the sink the process started with
+            int pipeReadFd = -1;
+            std::mutex mutex;
+            std::condition_variable changed;
+            std::deque<std::string> queue;
+            size_t queuedBytes = 0;
+            uint64_t droppedSinceNote = 0;
+
+            void readLoop()
+            {
+                std::string chunk(kReadChunkBytes, '\0');
+                for (;;)
+                {
+                    const int n = readFd(pipeReadFd, chunk.data(), chunk.size());
+                    if (n <= 0)
+                        return;
+                    std::lock_guard<std::mutex> lock(mutex);
+                    if (queuedBytes + static_cast<size_t>(n) > kMaxBacklogBytes)
+                    {
+                        droppedSinceNote += static_cast<uint64_t>(n);
+                        g_dropped.fetch_add(static_cast<uint64_t>(n), std::memory_order_relaxed);
+                        continue;
+                    }
+                    queue.emplace_back(chunk.data(), static_cast<size_t>(n));
+                    queuedBytes += static_cast<size_t>(n);
+                    changed.notify_all();
+                }
+            }
+
+            void writeAll(const char *data, size_t size)
+            {
+                while (size != 0)
+                {
+                    const int n = writeFd(originalFd, data, size);
+                    if (n <= 0)
+                        return; // sink closed; nothing useful left to do
+                    data += n;
+                    size -= static_cast<size_t>(n);
+                }
+            }
+
+            void writeLoop()
+            {
+                for (;;)
+                {
+                    std::string next;
+                    uint64_t dropped = 0;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        changed.wait(lock, [this]() { return !queue.empty() || droppedSinceNote != 0; });
+                        dropped = droppedSinceNote;
+                        droppedSinceNote = 0;
+                        if (!queue.empty())
+                        {
+                            next = std::move(queue.front());
+                            queue.pop_front();
+                        }
+                    }
+                    if (dropped != 0)
+                    {
+                        char note[96];
+                        const int length = std::snprintf(note, sizeof(note),
+                                                         "\n[async-stdio] dropped %llu bytes of backlog\n",
+                                                         static_cast<unsigned long long>(dropped));
+                        if (length > 0)
+                            writeAll(note, static_cast<size_t>(length));
+                    }
+                    if (!next.empty())
+                        writeAll(next.data(), next.size());
+                    {
+                        std::lock_guard<std::mutex> lock(mutex);
+                        queuedBytes -= next.size();
+                    }
+                    changed.notify_all();
+                }
+            }
+
+            bool waitDrained(std::chrono::steady_clock::time_point deadline)
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                return changed.wait_until(lock, deadline, [this]() { return queuedBytes == 0; });
+            }
+        };
+
+        Relay g_relays[2];
+        std::atomic<bool> g_installed{false};
+
+        bool installRelay(Relay &relay, int streamFd)
+        {
+            relay.streamFd = streamFd;
+            relay.originalFd = dupFd(streamFd);
+            if (relay.originalFd < 0)
+                return false; // no sink attached (e.g. GUI launch): leave it alone
+            int fds[2] = {-1, -1};
+            if (!makePipe(fds))
+            {
+                closeFd(relay.originalFd);
+                relay.originalFd = -1;
+                return false;
+            }
+            const int dup2Result = dup2Fd(fds[1], streamFd); // 0 on the CRT, streamFd on POSIX
+            if (dup2Result != 0 && dup2Result != streamFd)
+            {
+                closeFd(fds[0]);
+                closeFd(fds[1]);
+                closeFd(relay.originalFd);
+                relay.originalFd = -1;
+                return false;
+            }
+            closeFd(fds[1]);
+            relay.pipeReadFd = fds[0];
+#if defined(_WIN32)
+            // Keep newline translation where it happened before (on the stream
+            // descriptor) and pass bytes through unchanged to the real sink.
+            _setmode(streamFd, _O_TEXT);
+            _setmode(relay.originalFd, _O_BINARY);
+            constexpr unsigned long kStdOutputHandle = static_cast<unsigned long>(-11);
+            constexpr unsigned long kStdErrorHandle = static_cast<unsigned long>(-12);
+            SetStdHandle(streamFd == 1 ? kStdOutputHandle : kStdErrorHandle,
+                         reinterpret_cast<void *>(_get_osfhandle(streamFd)));
+#endif
+            // Detached: the relay lives for the whole process.
+            std::thread([&relay]() { relay.readLoop(); }).detach();
+            std::thread([&relay]() { relay.writeLoop(); }).detach();
+            return true;
+        }
+    }
+
+    bool install()
+    {
+        const char *disable = std::getenv("PS2_SYNC_STDIO");
+        if (disable && *disable && std::strcmp(disable, "0") != 0)
+            return false;
+        bool expected = false;
+        if (!g_installed.compare_exchange_strong(expected, true))
+            return true;
+
+        std::fflush(stdout);
+        std::fflush(stderr);
+        std::cout.flush();
+        std::cerr.flush();
+        const bool outOk = installRelay(g_relays[0], 1);
+        const bool errOk = installRelay(g_relays[1], 2);
+        std::atexit(flush);
+        return outOk || errOk;
+    }
+
+    void flush()
+    {
+        if (!g_installed.load())
+            return;
+        std::cout.flush();
+        std::cerr.flush();
+        std::fflush(stdout);
+        std::fflush(stderr);
+        // Let the readers pick up bytes still sitting in the pipes, then wait
+        // (bounded) for the writers to hand everything to the real sinks.
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+        for (Relay &relay : g_relays)
+        {
+            if (relay.originalFd >= 0)
+                relay.waitDrained(deadline);
+        }
+    }
+
+    uint64_t droppedBytes()
+    {
+        return g_dropped.load(std::memory_order_relaxed);
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_host_sampler.cpp b/ps2xRuntime/src/lib/ps2_host_sampler.cpp
new file mode 100644
index 0000000..9c6d31c
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_sampler.cpp
@@ -0,0 +1,90 @@
+// Opt-in instruction-pointer sampler for host profiling.
+//
+// PS2_RIP_SAMPLES=<file> makes the calling thread (the EE executor) sampled
+// about every 100 us by a background thread. Image-relative RIPs are appended
+// to <file> once per second, so a killed process keeps its samples; symbolize
+// them offline with nm (output/diag_perf/symbolize_samples.py).
+// Declared in runtime/host_profile.h, which is not included here: its minimal
+// Win32 prototypes would conflict with <windows.h>.
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <psapi.h>
+#endif
+
+namespace HostProfile
+{
+    void startRipSamplerForCurrentThread(const char *envName);
+
+    void startRipSamplerForCurrentThread(const char *envName)
+    {
+#if defined(_WIN32)
+        const char *path = std::getenv(envName);
+        if (!path || !*path)
+            return;
+        HANDLE target = nullptr;
+        if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &target,
+                             THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0))
+            return;
+        FILE *out = std::fopen(path, "w");
+        if (!out)
+            return;
+        // Header: every loaded module as "module <base> <size> <path>", so
+        // absolute RIPs can be symbolized per module offline.
+        {
+            HMODULE modules[512];
+            DWORD needed = 0;
+            if (K32EnumProcessModules(GetCurrentProcess(), modules, sizeof(modules), &needed))
+            {
+                for (DWORD i = 0; i < needed / sizeof(HMODULE) && i < 512u; ++i)
+                {
+                    MODULEINFO info{};
+                    char name[MAX_PATH] = {};
+                    if (K32GetModuleInformation(GetCurrentProcess(), modules[i], &info, sizeof(info)) &&
+                        GetModuleFileNameA(modules[i], name, MAX_PATH))
+                        std::fprintf(out, "module %llx %lx %s\n",
+                                     static_cast<unsigned long long>(reinterpret_cast<uint64_t>(info.lpBaseOfDll)),
+                                     static_cast<unsigned long>(info.SizeOfImage), name);
+                }
+            }
+            std::fflush(out);
+        }
+        std::thread([target, out]() {
+            const uint64_t base = 0u; // absolute RIPs (see module header)
+            std::vector<uint64_t> samples;
+            samples.reserve(16384);
+            auto lastFlush = std::chrono::steady_clock::now();
+            for (;;)
+            {
+                if (SuspendThread(target) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT context{};
+                    context.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(target, &context))
+                        samples.push_back(context.Rip - base);
+                    ResumeThread(target);
+                }
+                const auto next = std::chrono::steady_clock::now() + std::chrono::microseconds(100);
+                while (std::chrono::steady_clock::now() < next)
+                {
+                }
+                if (std::chrono::steady_clock::now() - lastFlush >= std::chrono::seconds(1))
+                {
+                    for (uint64_t rva : samples)
+                        std::fprintf(out, "%llx\n", static_cast<unsigned long long>(rva));
+                    std::fflush(out);
+                    samples.clear();
+                    lastFlush = std::chrono::steady_clock::now();
+                }
+            }
+        }).detach();
+#endif
+    }
+}
diff --git a/ps2xRuntime/tests/async_stdio_relay_test.cpp b/ps2xRuntime/tests/async_stdio_relay_test.cpp
new file mode 100644
index 0000000..24b5370
--- /dev/null
+++ b/ps2xRuntime/tests/async_stdio_relay_test.cpp
@@ -0,0 +1,105 @@
+// Regression: logging must not block the emulation thread when the process's
+// stdout sink stalls (a paused console, a slow redirected file, a full pipe).
+//
+// The test replaces fd 1 with a small pipe that nobody reads, installs the
+// relay, and writes 2 MiB. With the relay the writes return promptly; once the
+// sink starts draining, every byte must arrive in order. With PS2_SYNC_STDIO=1
+// (relay disabled) the writes block and the watchdog reports the failure.
+#include "runtime/ps2_async_stdio.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+
+#include <fcntl.h>
+#include <io.h>
+
+namespace
+{
+constexpr size_t kPayloadBytes = 2u * 1024u * 1024u;
+
+char expectedByte(size_t i) { return static_cast<char>('a' + (i % 26u)); }
+
+int fail(const char *message)
+{
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::fflush(stderr);
+    std::_Exit(1);
+}
+} // namespace
+
+int main()
+{
+    // A 4 KiB pipe with no reader yet: writing more than that blocks.
+    int sink[2] = {-1, -1};
+    if (_pipe(sink, 4096, _O_BINARY) != 0)
+        return fail("create sink pipe");
+    std::fflush(stdout);
+    if (_dup2(sink[1], 1) != 0)
+        return fail("redirect stdout to sink");
+    _close(sink[1]);
+    setvbuf(stdout, nullptr, _IONBF, 0); // mirror main.cpp: every write is a syscall
+
+    const bool installed = ps2_async_stdio::install();
+
+    std::atomic<bool> writesDone{false};
+    std::thread watchdog([&writesDone, installed]() {
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        while (!writesDone.load())
+        {
+            if (std::chrono::steady_clock::now() > deadline)
+            {
+                std::fprintf(stderr, "FAIL: 2 MiB of stdout writes blocked for >5 s on a stalled sink (relay installed=%d)\n",
+                             installed ? 1 : 0);
+                std::fflush(stderr);
+                std::_Exit(1);
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+    });
+
+    const auto start = std::chrono::steady_clock::now();
+    std::string line;
+    for (size_t i = 0; i < kPayloadBytes;)
+    {
+        line.clear();
+        for (size_t j = 0; j < 255u && i < kPayloadBytes; ++j, ++i)
+            line.push_back(expectedByte(i));
+        std::fwrite(line.data(), 1, line.size(), stdout);
+    }
+    const auto elapsedMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                               std::chrono::steady_clock::now() - start).count();
+    writesDone.store(true);
+    watchdog.join();
+
+    // Now drain the sink and verify integrity and order.
+    std::string received;
+    received.reserve(kPayloadBytes);
+    std::thread flusher([]() { ps2_async_stdio::flush(); });
+    char buffer[65536];
+    while (received.size() < kPayloadBytes)
+    {
+        const int n = _read(sink[0], buffer, sizeof(buffer));
+        if (n <= 0)
+            break;
+        received.append(buffer, static_cast<size_t>(n));
+    }
+    flusher.join();
+
+    if (received.size() != kPayloadBytes)
+        return fail("sink did not receive every byte");
+    for (size_t i = 0; i < kPayloadBytes; ++i)
+    {
+        if (received[i] != expectedByte(i))
+            return fail("sink received bytes out of order or corrupted");
+    }
+    if (ps2_async_stdio::droppedBytes() != 0)
+        return fail("relay dropped bytes below its backlog bound");
+
+    std::fprintf(stderr, "async_stdio_relay_test: passed (2 MiB written in %lld ms, stalled sink)\n",
+                 static_cast<long long>(elapsedMs));
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_actual_dma_queue_yield_test.cpp b/ps2xRuntime/tests/ee_actual_dma_queue_yield_test.cpp
new file mode 100644
index 0000000..ca636b6
--- /dev/null
+++ b/ps2xRuntime/tests/ee_actual_dma_queue_yield_test.cpp
@@ -0,0 +1,132 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <thread>
+
+void sub_00420450_0x420450(uint8_t *, R5900Context *, PS2Runtime *);
+void sub_0075D440_0x75d440(uint8_t *, R5900Context *, PS2Runtime *);
+void sub_0075D460_0x75d460(uint8_t *, R5900Context *, PS2Runtime *);
+
+namespace
+{
+constexpr uint32_t kOuterPc = 0x400000u;
+constexpr uint32_t kResumePc = 0x400004u;
+constexpr uint32_t kCallbackPc = 0x400008u;
+constexpr uint32_t kHelperPc = 0x420450u;
+constexpr uint32_t kSignalSemaPc = 0x75D440u;
+constexpr uint32_t kWaitSemaPc = 0x75D460u;
+constexpr uint32_t kStackPointer = 0x1FFF000u;
+constexpr uint32_t kSlotCount = (kWaitSemaPc + 4u - kOuterPc) / 4u;
+bool callbackRan = false;
+bool resumedWithGuestContext = false;
+uint32_t nestedDepth = 0;
+
+void nestedCaller(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ctx->r[31] = _mm_set_epi32(0, 0, 0, static_cast<int>(kResumePc));
+    ctx->pc = kHelperPc;
+    nestedDepth = runtime->guestDispatchDepth() + 1u;
+    (void)runtime->dispatchGuestBranch(rdram, ctx, kHelperPc, kOuterPc,
+                                       kResumePc, PS2Runtime::GuestBranchKind::DirectCall,
+                                       "actual DMA helper nested call");
+}
+
+void resumeMarker(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    resumedWithGuestContext = getRegU32(ctx, 31) == kResumePc &&
+                              getRegU32(ctx, 29) == kStackPointer;
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+
+void vsyncCallback(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    callbackRan = true;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3CF8u) = 0xAC3470u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3470u) = 0xAC3480u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3480u) = 0u;
+    runtime->eeScheduler().setGsVSyncCallback(0u, 0u, 0u);
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kOuterPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kWaitSemaPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = kSlotCount;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[kSlotCount] = {};
+
+int main()
+{
+    g_ps2RecompiledFunctionTable[(kOuterPc - kOuterPc) / 4u] = nestedCaller;
+    g_ps2RecompiledFunctionTable[(kResumePc - kOuterPc) / 4u] = resumeMarker;
+    g_ps2RecompiledFunctionTable[(kCallbackPc - kOuterPc) / 4u] = vsyncCallback;
+    for (uint32_t pc : {0x420450u, 0x4204B0u, 0x4204E8u, 0x4204F4u,
+                        0x4204FCu, 0x420528u, 0x420530u, 0x420538u,
+                        0x4205B4u})
+    {
+        g_ps2RecompiledFunctionTable[(pc - kOuterPc) / 4u] = sub_00420450_0x420450;
+    }
+    g_ps2RecompiledFunctionTable[(kSignalSemaPc - kOuterPc) / 4u] = sub_0075D440_0x75d440;
+    g_ps2RecompiledFunctionTable[(0x75D448u - kOuterPc) / 4u] = sub_0075D440_0x75d440;
+    g_ps2RecompiledFunctionTable[(kWaitSemaPc - kOuterPc) / 4u] = sub_0075D460_0x75d460;
+    g_ps2RecompiledFunctionTable[(0x75D468u - kOuterPc) / 4u] = sub_0075D460_0x75d460;
+
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 1;
+    uint8_t *rdram = runtime.memory().getRDRAM();
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context mainContext{};
+    mainContext.pc = kOuterPc;
+    mainContext.r[29] = _mm_set_epi32(0, 0, 0, static_cast<int>(kStackPointer));
+    scheduler.reset(rdram, mainContext);
+    const int semaphoreId = scheduler.createSemaphore(1, 1, 0u, 0u);
+    if (semaphoreId <= 0) return 1;
+    std::memcpy(rdram + 0xAC3D0Cu, &semaphoreId, sizeof(semaphoreId));
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3C40u) = 0xAC3440u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3C44u) = 0xAC3440u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3CF8u) = 0u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3470u) = 0u;
+    *reinterpret_cast<uint32_t *>(rdram + 0xAC3480u) = 0u;
+    scheduler.setGsVSyncCallback(kCallbackPc, 0u, 0u);
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+
+    std::atomic<bool> timedOut = false;
+    std::jthread watchdog([&](std::stop_token stop)
+    {
+        for (int i = 0; i < 200 && !stop.stop_requested(); ++i)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        if (!stop.stop_requested())
+        {
+            timedOut.store(true);
+            scheduler.requestStop();
+        }
+    });
+    scheduler.run();
+    watchdog.request_stop();
+    if (timedOut.load() || !callbackRan || !resumedWithGuestContext || nestedDepth == 0u)
+    {
+        const GuestThread *main = scheduler.thread(1);
+        std::cerr << "actual DMA queue helper did not resume: timeout=" << timedOut.load()
+                  << " callback=" << callbackRan
+                  << " resumed=" << resumedWithGuestContext
+                  << " nestedDepth=" << nestedDepth
+                  << " tick=" << scheduler.currentVSyncTick()
+                  << " pc=0x" << std::hex << (main ? main->context.pc : 0u)
+                  << " sp=0x" << (main ? getRegU32(&main->context, 29) : 0u)
+                  << " free=0x" << *reinterpret_cast<uint32_t *>(rdram + 0xAC3CF8u)
+                  << " head=0x" << *reinterpret_cast<uint32_t *>(rdram + 0xAC3C40u)
+                  << " tail=0x" << *reinterpret_cast<uint32_t *>(rdram + 0xAC3C44u)
+                  << " s1=0x" << (main ? getRegU32(&main->context, 17) : 0u)
+                  << " status=" << (main ? static_cast<int>(main->status) : -1)
+                  << std::dec << '\n';
+        return 1;
+    }
+    return 0;
+}
