+struct GSCpuBackend::PixelRowSetup
+{
+    PixelWriteMask masks[256];
+};
+
+// Row writer for WritePixel semantics: frame and Z addressing hoisted per row,
+// draw state held in locals (VRAM stores may alias any heap object).
+template <uint32_t kFramePsm, uint32_t kZPsm>
+void GSCpuBackend::WritePixelRow(const GSDrawState &state, const PixelRowSetup &pipe, int y, int x0, int x1,
+                                 const uint32_t *colors, uint32_t z, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    if (y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return;
+    const int scissorX0 = ctx.scissor.x0;
+    const int scissorX1 = ctx.scissor.x1;
+    const bool fogEnabled = state.prim.fge;
+    const uint8_t fogR = state.fogR, fogG = state.fogG, fogB = state.fogB;
+    const u32 fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const u32 fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    const u32 zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const uint64_t testReg = ctx.test;
+    const uint32_t ztestMethod = static_cast<uint32_t>((testReg >> 17) & 3u);
+    const bool alphaBlendEnabled = state.prim.abe;
+    const bool destinationAlphaTestNeedsRead = ((testReg >> 14) & 0x1u) != 0u &&
+        (kFramePsm == GS_PSM_CT32 || kFramePsm == GS_PSM_CT16 || kFramePsm == GS_PSM_CT16S);
+    const u32 fbmsk = ctx.frame.fbmsk;
+    const bool pabe = state.pabe;
+    const uint64_t alphaReg = ctx.alpha;
+    const uint8_t asel = alphaReg & 3;
+    const uint8_t bsel = (alphaReg >> 2) & 3;
+    const uint8_t csel = (alphaReg >> 4) & 3;
+    const uint8_t dsel = (alphaReg >> 6) & 3;
+    const uint8_t fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+    const bool forceAlphaMsb = (ctx.fba & 0x1ull) != 0ull && kFramePsm != GS_PSM_CT24;
+    const bool zmask = ctx.zbuf.zmask;
+    constexpr bool kFrame16 = kFramePsm == GS_PSM_CT16 || kFramePsm == GS_PSM_CT16S;
+    uint8_t *const vram = m_vram;
+    const auto frameRow = GSMem::MakeRowAccess<kFramePsm>(fbp, fbw, static_cast<u32>(y));
+    const auto depthRow = GSMem::MakeRowAccess<kZPsm>(zbp, fbw, static_cast<u32>(y));
+    using FramePacked = typename decltype(frameRow)::PackedT;
+    using DepthPacked = typename decltype(depthRow)::PackedT;
+
+    for (int x = x0; x <= x1; ++x)
+    {
+        if (x < scissorX0 || x > scissorX1)
+            continue;
+        const uint32_t color = colors[x - x0];
+        uint8_t r = static_cast<uint8_t>(color & 0xFFu);
+        uint8_t g = static_cast<uint8_t>((color >> 8) & 0xFFu);
+        uint8_t b = static_cast<uint8_t>((color >> 16) & 0xFFu);
+        uint8_t a = static_cast<uint8_t>(color >> 24);
+
+        if (fogEnabled)
+        {
+            const uint32_t inverseFog = 255u - fog;
+            auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+            {
+                return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+            };
+            r = applyFog(r, fogR);
+            g = applyFog(g, fogG);
+            b = applyFog(b, fogB);
+        }
+
+        const PixelWriteMask writeMask = pipe.masks[a];
+        if (!writeMask.writesAnything())
+            continue;
+
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && kFramePsm == GS_PSM_CT32;
+        const bool frmw = destinationAlphaTestNeedsRead ||
+                          (writeMask.writesFramebuffer() && ((fbmsk != 0) || alphaBlendEnabled || preserveDestinationAlpha));
+
+        u32 rawFramebufferPixel = 0;
+        u32 fbrgba = 0;
+        if (frmw)
+        {
+            rawFramebufferPixel = frameRow.Read(vram, static_cast<u32>(x));
+            fbrgba = rawFramebufferPixel;
+            if constexpr (kFrame16)
+                fbrgba = Rgba5551ToRgba8888(static_cast<u16>(fbrgba));
+            else if constexpr (kFramePsm == GS_PSM_CT24)
+                fbrgba |= 0x80000000u;
+        }
+
+        if (!passesDestinationAlphaTest(testReg, static_cast<uint8_t>(kFramePsm), rawFramebufferPixel))
+            continue;
+
+        bool zpass = false;
+        switch (ztestMethod)
+        {
+        case 0:
+            zpass = false;
+            break;
+        case 1:
+            zpass = true;
+            break;
+        case 2:
+            zpass = z >= static_cast<uint32_t>(depthRow.Read(vram, static_cast<u32>(x)));
+            break;
+        case 3:
+            zpass = z > static_cast<uint32_t>(depthRow.Read(vram, static_cast<u32>(x)));
+            break;
+        }
+        if (!zpass)
+            continue;
+
+        if (writeMask.writesFramebuffer())
+        {
+            if (alphaBlendEnabled)
+            {
+                const uint8_t dr = fbrgba & 0xFF;
+                const uint8_t dg = (fbrgba >> 8) & 0xFF;
+                const uint8_t db = (fbrgba >> 16) & 0xFF;
+                const uint8_t da = (fbrgba >> 24) & 0xFF;
+                if (!(pabe && (a & 0x80u) == 0u))
+                {
+                    auto pickRGB = [&](uint8_t sel, int cs, int cd) -> int
+                    {
+                        if (sel == 0)
+                            return cs;
+                        if (sel == 1)
+                            return cd;
+                        return 0;
+                    };
+                    const int cAlpha = (csel == 0) ? a : (csel == 1) ? da : fix;
+                    r = clampU8(((pickRGB(asel, r, dr) - pickRGB(bsel, r, dr)) * cAlpha >> 7) + pickRGB(dsel, r, dr));
+                    g = clampU8(((pickRGB(asel, g, dg) - pickRGB(bsel, g, dg)) * cAlpha >> 7) + pickRGB(dsel, g, dg));
+                    b = clampU8(((pickRGB(asel, b, db) - pickRGB(bsel, b, db)) * cAlpha >> 7) + pickRGB(dsel, b, db));
+                }
+            }
+
+            if (writeMask.writeAlpha && forceAlphaMsb)
+                a = static_cast<uint8_t>(a | 0x80u);
+
+            u32 pixel = pack32(r, g, b, a);
+            if (fbmsk != 0)
+                pixel = (pixel & ~fbmsk) | (fbrgba & fbmsk);
+            if (preserveDestinationAlpha)
+                pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+            if constexpr (kFrame16)
+                pixel = Rgba8888ToRgba5551(pixel);
+            frameRow.Write(vram, static_cast<u32>(x), static_cast<FramePacked>(pixel));
+        }
+
+        if (writeMask.writeDepth && !zmask)
+            depthRow.Write(vram, static_cast<u32>(x), static_cast<DepthPacked>(z));
+    }
+}
+
+GSCpuBackend::RowWriter GSCpuBackend::SelectRowWriter(uint8_t framePsm, uint8_t depthPsm, bool depthUsed)
+{
+    // Unused Z needs no Z format; its accessor is never touched.
+    if (!depthUsed)
+        depthPsm = GS_PSM_Z32;
+#define PS2_ROW_WRITER_Z(frame)                                                         \
+    switch (depthPsm)                                                                   \
+    {                                                                                   \
+    case GS_PSM_Z32: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z32>;           \
+    case GS_PSM_Z24: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z24>;           \
+    case GS_PSM_Z16: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z16>;           \
+    case GS_PSM_Z16S: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z16S>;         \
+    default: return nullptr;                                                            \
+    }
+    switch (framePsm)
+    {
+    case GS_PSM_CT32: PS2_ROW_WRITER_Z(GS_PSM_CT32)
+    case GS_PSM_CT24: PS2_ROW_WRITER_Z(GS_PSM_CT24)
+    case GS_PSM_CT16: PS2_ROW_WRITER_Z(GS_PSM_CT16)
+    case GS_PSM_CT16S: PS2_ROW_WRITER_Z(GS_PSM_CT16S)
+    default:
+        return nullptr;
+    }
+#undef PS2_ROW_WRITER_Z
+}
+
+void GSCpuBackend::InitPixelRowSetup(PixelRowSetup &pipe, const GSDrawState &state)
+{
+    for (uint32_t alpha = 0; alpha < 256u; ++alpha)
+        pipe.masks[alpha] = classifyAlphaTest(state.context.test, static_cast<uint8_t>(alpha), state.context.frame.psm);
+}
