+void GSCpuBackend::WorkerLoop(uint32_t index)
+{
+    const uint32_t count = static_cast<uint32_t>(m_workerConfig);
+    const RasterContext rc{index, count, &m_workerCaches[index], &m_workerCluts[index]};
+    if (index == 0u)
+        HostProfile::startRipSamplerForCurrentThread("PS2_RIP_SAMPLES_GS0");
+    uint64_t next = 0u;
+    const bool stats = DrawStats::enabled();
+    auto phaseStart = std::chrono::steady_clock::now();
+    auto endPhase = [&](std::atomic<uint64_t> *bucket) {
+        if (!stats)
+            return;
+        const auto now = std::chrono::steady_clock::now();
+        bucket[index].fetch_add(static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(now - phaseStart).count()), std::memory_order_relaxed);
+        phaseStart = now;
+    };
+    DrawStats &drawStats = DrawStats::instance();
+    for (;;)
+    {
+        waitUntil(m_signalMutex, m_signalCv, m_sleepers, [&]()
+                  { return m_head.load(std::memory_order_acquire) > next ||
+                           m_stopWorkers.load(std::memory_order_acquire); });
+        endPhase(drawStats.idleNs);
+        if (m_head.load(std::memory_order_acquire) <= next)
+            return; // stop requested and every queued command is done
+
+        Command &command = m_ring[next % kRingSize];
+        if (command.kind == Command::Kind::Draw)
+        {
+            if (index == 0u && DrawStats::enabled())
+            {
+                const auto start = std::chrono::steady_clock::now();
+                DrawPrimitive(rc, command.batch);
+                const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    std::chrono::steady_clock::now() - start).count();
+                DrawStats::instance().addTime(DrawStats::key(command.batch), static_cast<uint64_t>(ns), count);
+            }
+            else
+            {
+                DrawPrimitive(rc, command.batch);
+            }
+            endPhase(drawStats.busyNs);
+        }
+        else if (command.kind == Command::Kind::LoadClut)
+        {
+            LoadClutInto(*rc.clut, nullptr, command.tex0, command.texclut);
+        }
+        else if (command.kind == Command::Kind::TextureFlush)
+        {
+            rc.cache->Invalidate();
+        }
+        else if (index == 0u)
+        {
+            // Every other worker must have finished all earlier commands.
+            waitUntil(m_signalMutex, m_signalCv, m_sleepers, [&]()
+                      {
+                          for (uint32_t i = 1; i < count; ++i)
+                          {
+                              if (m_workerProgress[i].load(std::memory_order_acquire) < next)
+                                  return false;
+                          }
+                          return true;
+                      });
+            endPhase(drawStats.barrierNs);
+            {
+                HostProfile::Scope profileScope(HostProfile::GsExclusiveWork);
+                ExecuteExclusive(command);
+            }
+            endPhase(drawStats.exclusiveNs);
+            m_exclusiveDone.store(next + 1u, std::memory_order_seq_cst);
+        }
+        else
+        {
+            waitUntil(m_signalMutex, m_signalCv, m_sleepers, [&]()
+                      { return m_exclusiveDone.load(std::memory_order_acquire) > next; });
+            endPhase(drawStats.barrierNs);
+        }
+        ++next;
+        m_workerProgress[index].store(next, std::memory_order_seq_cst);
+        NotifyWorkers();
+    }
+}
+
+void GSCpuBackend::ExecuteExclusive(Command &command)
+{
+    switch (command.kind)
+    {
+    case Command::Kind::Upload:
+        RunUpload<true>(command.transfer, command.transferState, command.data.data(),
+                        static_cast<uint32_t>(command.data.size()));
+        break;
+    case Command::Kind::LoadClut:     // per worker, handled in WorkerLoop
+    case Command::Kind::TextureFlush: // per worker, handled in WorkerLoop
+        break;
+    case Command::Kind::PresentSnapshot:
+    {
+        std::lock_guard<std::mutex> lock(m_presentMutex);
+        m_presentSnapshot.assign(m_vram, m_vram + m_vramSize);
+        m_presentRequest = command.presentRequest;
+        m_hasPresentSnapshot = true;
+        break;
+    }
+    case Command::Kind::DrawAll:
+    {
+        const RasterContext rc{0u, 1u, &m_workerCaches[0], &m_workerCluts[0]};
+        DrawPrimitive(rc, command.batch);
+        break;
+    }
+    case Command::Kind::Barrier:
+    case Command::Kind::Draw:
+        break;
+    }
+}
+
+void GSCpuBackend::StopWorkers()
+{
+    if (m_workers.empty())
+        return;
+    m_stopWorkers.store(true, std::memory_order_seq_cst);
+    {
+        std::lock_guard<std::mutex> lock(m_signalMutex);
+        m_signalCv.notify_all();
+    }
+    for (std::thread &worker : m_workers)
+        worker.join();
+    m_workers.clear();
+}
