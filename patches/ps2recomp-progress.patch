diff --git a/ps2xRuntime/scripts/fetch_parallel_gs.py b/ps2xRuntime/scripts/fetch_parallel_gs.py
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/scripts/fetch_parallel_gs.py
@@ -0,0 +1,42 @@
+"""Fetch the pinned optional GS library and the small standalone dependency set."""
+from pathlib import Path
+import subprocess
+
+RUNTIME = Path(__file__).resolve().parents[1]
+DESTINATION = RUNTIME / "third_party" / "parallel-gs"
+REVISION = "3a66c1976170cbc2cb53a3593fabbc7c4b2ccfbd"
+REPOSITORY = "https://github.com/Arntzen-Software/parallel-gs.git"
+PATCH = RUNTIME / "third_party" / "parallel-gs-transfer-fragments.patch"
+
+
+def git(*args, cwd=None):
+    return subprocess.check_output(["git", *args], cwd=cwd, text=True).strip()
+
+
+def apply_pinned_patch():
+    reverse = subprocess.run(["git", "apply", "--reverse", "--check", str(PATCH)],
+                             cwd=DESTINATION, capture_output=True)
+    if reverse.returncode == 0:
+        return
+    git("apply", "--check", str(PATCH), cwd=DESTINATION)
+    git("apply", str(PATCH), cwd=DESTINATION)
+
+
+def main():
+    if not DESTINATION.exists():
+        DESTINATION.parent.mkdir(parents=True, exist_ok=True)
+        git("clone", "--no-checkout", "--depth", "1", REPOSITORY, str(DESTINATION))
+        git("fetch", "--depth", "1", "origin", REVISION, cwd=DESTINATION)
+        git("checkout", "--detach", REVISION, cwd=DESTINATION)
+    elif git("rev-parse", "HEAD", cwd=DESTINATION) != REVISION:
+        raise SystemExit("Existing paraLLEl-GS checkout differs from the pin; preserving it.")
+    git("submodule", "update", "--init", "--depth", "1", "Granite", cwd=DESTINATION)
+    git("submodule", "update", "--init", "--depth", "1",
+        "third_party/volk", "third_party/khronos/vulkan-headers",
+        "third_party/stb/stb", "third_party/rapidjson", cwd=DESTINATION / "Granite")
+    apply_pinned_patch()
+    print(f"paraLLEl-GS ready at {DESTINATION} ({REVISION})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/GuestWriteSpan.h b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/GuestWriteSpan.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/GuestWriteSpan.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "runtime/ps2_memory.h"
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace GuestWriteSpan
+{
+// Only canonical RAM aliases and an unbroken scratchpad range are copied in
+// bulk. Mirrored wraps, device ranges and overlapping sources retain byte order.
+template <typename Resolve>
+bool tryCopy(uint32_t addr, const uint8_t *src, size_t len, Resolve &&resolve)
+{
+    if (!src || !len) return false;
+    const uint32_t segment = addr & 0xe0000000u;
+    const uint32_t physical = addr & 0x1fffffffu;
+    const bool ramAlias = segment == 0u || segment == 0x20000000u ||
+                          segment == 0x80000000u || segment == 0xa0000000u;
+    bool contiguous = ramAlias && physical < PS2_RAM_SIZE && len <= PS2_RAM_SIZE - physical;
+    if (ps2IsScratchpadAddress(addr))
+        contiguous = len <= PS2_SCRATCHPAD_SIZE - ps2ScratchpadOffset(addr);
+    if (!contiguous) return false;
+    auto *dst = resolve(addr);
+    if (!dst) return false;
+    const auto source = reinterpret_cast<uintptr_t>(src);
+    const auto destination = reinterpret_cast<uintptr_t>(dst);
+    const auto distance = source < destination ? destination - source : source - destination;
+    if (distance < len) return false;
+    std::memcpy(dst, src, len);
+    return true;
+}
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_menu_row.h b/ps2xRuntime/src/lib/gs/gs_menu_row.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_menu_row.h
@@ -0,0 +1,189 @@
+#pragma once
+
+// Private span kernel. Each SIMD lane is a different framebuffer pixel;
+// swizzled memory gathers/stores retain the scalar GS memory mapping.
+#include "runtime/gs/ps2_gs_memory.h"
+#include "runtime/gs/gs_types.h"
+#include <immintrin.h>
+
+namespace GSMenu
+{
+inline __m128i channel(__m128i rgba, int shift)
+{
+    return _mm_and_si128(_mm_srl_epi32(rgba, _mm_cvtsi32_si128(shift)), _mm_set1_epi32(255));
+}
+
+inline __m128i pickRgb(uint8_t selector, __m128i source, __m128i destination)
+{
+    return selector == 0 ? source : selector == 1 ? destination : _mm_setzero_si128();
+}
+
+inline __m128i blendChannel(__m128i source, __m128i destination, __m128i alpha,
+                           uint8_t a, uint8_t b, uint8_t d)
+{
+    const __m128i difference = _mm_sub_epi32(pickRgb(a, source, destination), pickRgb(b, source, destination));
+    const __m128i scaled = _mm_srai_epi32(_mm_mullo_epi32(difference, alpha), 7);
+    const __m128i value = _mm_add_epi32(scaled, pickRgb(d, source, destination));
+    return _mm_min_epi32(_mm_max_epi32(value, _mm_setzero_si128()), _mm_set1_epi32(255));
+}
+
+// Common CT32 UI spans use two contiguous pairs of pixels per GS column.
+// Keep colors in SIMD registers and retain the two swizzled addresses for
+// both reads and writes, avoiding the generic gather arrays and mask tables.
+template <uint32_t kZPsm>
+bool writeCommonCt32(uint8_t *vram, const GSDrawState &state, int y,
+                     int &x, int x1, const uint32_t *colors, uint32_t z)
+{
+    const auto &ctx = state.context;
+    const uint32_t atst = (ctx.test >> 1) & 7u, afail = (ctx.test >> 12) & 3u;
+    const bool alphaAlways = (ctx.test & 1u) == 0u || atst == 1u;
+    const bool alphaPositive = !alphaAlways && atst == 6u && ((ctx.test >> 4) & 255u) == 0u && afail == 0u;
+    const bool alphaFbOnly = !alphaAlways && atst == 0u && afail == 1u;
+    const uint32_t ztest = (ctx.test >> 17) & 3u;
+    const uint8_t mode = static_cast<uint8_t>(ctx.alpha);
+    if (!state.prim.abe || (x & 3) != 0 || x1 - x + 1 < 16 ||
+        (!alphaAlways && !alphaPositive && !alphaFbOnly) || (ztest != 1u && ztest != 2u) ||
+        (mode != 0x44u && mode != 0x54u && mode != 0x58u && mode != 0x88u))
+        return false;
+    const uint32_t fbw = std::max(ctx.frame.fbw, 1u);
+    const auto frame = GSMem::MakeRowAccess<GS_PSM_CT32>(ctx.frame.fbp * 32u, fbw, y);
+    const auto depth = GSMem::MakeRowAccess<kZPsm>(ctx.zbuf.zbp * 32u, fbw, y);
+    const bool writeZ = !ctx.zbuf.zmask && !alphaFbOnly;
+    const __m128i all = _mm_set1_epi32(-1), zero = _mm_setzero_si128();
+    const __m128i frameMask = _mm_set1_epi32(ctx.frame.fbmsk);
+    const __m128i fba = _mm_set1_epi32((ctx.fba & 1u) ? 0x80000000u : 0u);
+    const __m128i sign = _mm_set1_epi32(0x80000000u);
+    const __m128i unsignedZ = _mm_xor_si128(_mm_set1_epi32(z), sign);
+    const int first = x;
+    for (; x + 3 <= x1; x += 4)
+    {
+        uint8_t *const f0 = vram + frame.ByteAddress(x);
+        uint8_t *const f2 = vram + frame.ByteAddress(x + 2);
+        const __m128i old = _mm_unpacklo_epi64(_mm_loadl_epi64(reinterpret_cast<const __m128i *>(f0)),
+                                              _mm_loadl_epi64(reinterpret_cast<const __m128i *>(f2)));
+        const __m128i src = _mm_loadu_si128(reinterpret_cast<const __m128i *>(colors + x - first));
+        __m128i pass = alphaPositive ? _mm_cmpgt_epi32(_mm_srli_epi32(src, 24), zero) : all;
+        uint32_t d0 = 0, d1 = 0, d2 = 0, d3 = 0;
+        if (writeZ || ztest == 2u)
+        {
+            d0 = depth.ByteAddress(x); d1 = depth.ByteAddress(x + 1);
+            d2 = depth.ByteAddress(x + 2); d3 = depth.ByteAddress(x + 3);
+        }
+        if (ztest == 2u)
+        {
+            using Packed = typename decltype(depth)::PackedT;
+            Packed z0, z1, z2, z3;
+            std::memcpy(&z0, vram + d0, sizeof(Packed)); std::memcpy(&z1, vram + d1, sizeof(Packed));
+            std::memcpy(&z2, vram + d2, sizeof(Packed)); std::memcpy(&z3, vram + d3, sizeof(Packed));
+            const __m128i previousZ = _mm_xor_si128(_mm_setr_epi32(z0, z1, z2, z3), sign);
+            pass = _mm_andnot_si128(_mm_cmpgt_epi32(previousZ, unsignedZ), pass);
+        }
+        const __m128i factor = mode == 0x44u || mode == 0x88u ? channel(src, 24) : channel(old, 24);
+        const uint8_t b = mode == 0x44u || mode == 0x54u ? 1u : 2u;
+        const uint8_t d = mode == 0x88u ? 2u : 1u;
+        const __m128i r = blendChannel(channel(src, 0), channel(old, 0), factor, 0u, b, d);
+        const __m128i g = blendChannel(channel(src, 8), channel(old, 8), factor, 0u, b, d);
+        const __m128i bl = blendChannel(channel(src, 16), channel(old, 16), factor, 0u, b, d);
+        __m128i pixel = _mm_or_si128(_mm_and_si128(src, _mm_set1_epi32(0xFF000000u)),
+                                    _mm_or_si128(r, _mm_or_si128(_mm_slli_epi32(g, 8), _mm_slli_epi32(bl, 16))));
+        pixel = _mm_or_si128(pixel, fba);
+        pixel = _mm_or_si128(_mm_andnot_si128(frameMask, pixel), _mm_and_si128(frameMask, old));
+        pixel = _mm_or_si128(_mm_and_si128(pass, pixel), _mm_andnot_si128(pass, old));
+        _mm_storel_epi64(reinterpret_cast<__m128i *>(f0), pixel);
+        _mm_storel_epi64(reinterpret_cast<__m128i *>(f2), _mm_srli_si128(pixel, 8));
+        if (writeZ)
+        {
+            const int lanes = _mm_movemask_ps(_mm_castsi128_ps(pass));
+            const auto value = static_cast<typename decltype(depth)::PackedT>(z);
+            if (lanes & 1) std::memcpy(vram + d0, &value, sizeof(value));
+            if (lanes & 2) std::memcpy(vram + d1, &value, sizeof(value));
+            if (lanes & 4) std::memcpy(vram + d2, &value, sizeof(value));
+            if (lanes & 8) std::memcpy(vram + d3, &value, sizeof(value));
+        }
+    }
+    return true;
+}
+
+template <uint32_t kFramePsm, uint32_t kZPsm, typename Masks>
+void writeRow(uint8_t *vram, const GSDrawState &state, const Masks &masks,
+              int y, int x0, int x1, const uint32_t *colors, uint32_t z)
+{
+    constexpr bool kFrame16 = kFramePsm == GS_PSM_CT16S;
+    const auto &ctx = state.context;
+    const auto frame = GSMem::MakeRowAccess<kFramePsm>(ctx.frame.fbp * 32u, std::max(ctx.frame.fbw, 1u), y);
+    const auto depth = GSMem::MakeRowAccess<kZPsm>(ctx.zbuf.zbp * 32u, std::max(ctx.frame.fbw, 1u), y);
+    const uint32_t ztest = (ctx.test >> 17) & 3u;
+    const uint32_t fbmsk = ctx.frame.fbmsk;
+    const bool blend = state.prim.abe;
+    const bool zmask = ctx.zbuf.zmask;
+    const bool fba = (ctx.fba & 1u) != 0u;
+    const uint8_t a = ctx.alpha & 3u, b = (ctx.alpha >> 2) & 3u;
+    const uint8_t c = (ctx.alpha >> 4) & 3u, d = (ctx.alpha >> 6) & 3u;
+    const uint8_t fix = (ctx.alpha >> 32) & 255u;
+    const bool blendReads = blend && (a == 1u || b == 1u || c == 1u || d == 1u);
+
+    for (int x = x0; x <= x1; x += 4)
+    {
+        const int count = std::min(4, x1 - x + 1);
+        alignas(16) uint32_t source[4]{}, dest[4]{}, result[4]{};
+        uint32_t storedZ[4]{};
+        bool readFrame = fbmsk != 0u || blendReads;
+        for (int lane = 0; lane < count; ++lane)
+        {
+            source[lane] = colors[x + lane - x0];
+            const auto mask = masks[source[lane] >> 24];
+            readFrame |= !kFrame16 && mask.writeRgb && !mask.writeAlpha;
+        }
+        for (int lane = 0; lane < count; ++lane)
+        {
+            if (readFrame)
+            {
+                uint32_t raw = frame.Read(vram, x + lane);
+                if constexpr (kFrame16)
+                    raw = ((raw & 31u) << 3) | (((raw >> 5) & 31u) << 11) |
+                          (((raw >> 10) & 31u) << 19) | ((raw & 0x8000u) << 16);
+                dest[lane] = raw;
+            }
+            if (ztest >= 2u)
+                storedZ[lane] = depth.Read(vram, x + lane);
+        }
+
+        const __m128i src = _mm_load_si128(reinterpret_cast<const __m128i *>(source));
+        const __m128i dst = _mm_load_si128(reinterpret_cast<const __m128i *>(dest));
+        __m128i pixel = src;
+        if (blend)
+        {
+            const __m128i factor = c == 0u ? channel(src, 24) : c == 1u ? channel(dst, 24) : _mm_set1_epi32(fix);
+            const __m128i r = blendChannel(channel(src, 0), channel(dst, 0), factor, a, b, d);
+            const __m128i g = blendChannel(channel(src, 8), channel(dst, 8), factor, a, b, d);
+            const __m128i bl = blendChannel(channel(src, 16), channel(dst, 16), factor, a, b, d);
+            pixel = _mm_or_si128(_mm_and_si128(src, _mm_set1_epi32(0xFF000000u)),
+                                _mm_or_si128(r, _mm_or_si128(_mm_slli_epi32(g, 8), _mm_slli_epi32(bl, 16))));
+        }
+        _mm_store_si128(reinterpret_cast<__m128i *>(result), pixel);
+        for (int lane = 0; lane < count; ++lane)
+        {
+            const auto mask = masks[source[lane] >> 24];
+            if (!mask.writesAnything() || (ztest == 2u && z < storedZ[lane]) ||
+                (ztest == 3u && z <= storedZ[lane]))
+                continue;
+            if (mask.writesFramebuffer())
+            {
+                uint32_t rgba = result[lane];
+                if (fba && mask.writeAlpha)
+                    rgba |= 0x80000000u;
+                rgba = (rgba & ~fbmsk) | (dest[lane] & fbmsk);
+                if constexpr (!kFrame16)
+                    if (mask.writeRgb && !mask.writeAlpha)
+                        rgba = (rgba & 0xFFFFFFu) | (dest[lane] & 0xFF000000u);
+                if constexpr (kFrame16)
+                    rgba = ((rgba >> 3) & 31u) | ((rgba >> 6) & 0x3E0u) |
+                           ((rgba >> 9) & 0x7C00u) | ((rgba >> 16) & 0x8000u);
+                frame.Write(vram, x + lane, static_cast<typename decltype(frame)::PackedT>(rgba));
+            }
+            if (mask.writeDepth && !zmask)
+                depth.Write(vram, x + lane, static_cast<typename decltype(depth)::PackedT>(z));
+        }
+    }
+}
+} // namespace GSMenu
diff --git a/ps2xRuntime/src/lib/gs/gs_pgs_logical_scanout.h b/ps2xRuntime/src/lib/gs/gs_pgs_logical_scanout.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_pgs_logical_scanout.h
@@ -0,0 +1,257 @@
+    // Exact single-source subset of the runtime logical DISPLAY contract.
+    struct LogicalSource
+    {
+        uint64_t dispfb = 0;
+        uint32_t width = 0, height = 0, displayFbp = 0, sourceFbp = 0, psm = 0;
+        bool preferred = false;
+    };
+
+    static bool logicalColorFormat(uint32_t psm)
+    {
+        return psm == GS_PSM_CT32 || psm == GS_PSM_CT24 ||
+               psm == GS_PSM_CT16 || psm == GS_PSM_CT16S;
+    }
+
+    static std::array<uint32_t, 2> logicalDisplaySize(uint64_t display)
+    {
+        const uint32_t magh = static_cast<uint32_t>((display >> 23u) & 15u);
+        uint32_t width = (static_cast<uint32_t>((display >> 32u) & 4095u) + 1u) / (magh + 1u);
+        uint32_t height = static_cast<uint32_t>((display >> 44u) & 2047u) + 1u;
+        if (width < 64u || height < 64u)
+        {
+            width = 640u;
+            height = 448u;
+        }
+        return {std::min(width, 640u), std::min(height, 512u)};
+    }
+
+    static bool selectLogicalSource(const GSPresentationRequest &request, LogicalSource &source,
+                                    GSParallelProfile::LogicalReason &reason)
+    {
+        using Reason = GSParallelProfile::LogicalReason;
+        const auto reject = [&](Reason value) { reason = value; return false; };
+        if ((request.smode2 & 1u) != 0u)
+            return reject(Reason::Interlace);
+        const bool en1 = (request.pmode & 1u) || request.pmode == 0u;
+        const bool en2 = (request.pmode & 2u) != 0u;
+        if (!en1 && !en2)
+            return reject(Reason::Disabled);
+        const bool both = en1 && en2;
+        if (both)
+        {
+            if (request.pmode & 0x80u)
+                return reject(Reason::CircuitBackground);
+            // Match the CPU's decoded source equivalence. DISPLAY positioning,
+            // MAGV and reserved bits do not affect the logical pixel contract.
+            constexpr uint64_t sourceMask = 0xfffffull | (0x3fffffull << 32u);
+            if ((request.dispfb1 & sourceMask) != (request.dispfb2 & sourceMask))
+                return reject(Reason::CircuitSource);
+            if (logicalDisplaySize(request.display1) != logicalDisplaySize(request.display2))
+                return reject(Reason::CircuitSize);
+        }
+        source.dispfb = en1 ? request.dispfb1 : request.dispfb2;
+        const uint64_t display = en1 ? request.display1 : request.display2;
+        const uint32_t fbp = static_cast<uint32_t>(source.dispfb & 511u);
+        const uint32_t fbw = static_cast<uint32_t>((source.dispfb >> 9u) & 63u);
+        const uint32_t psm = static_cast<uint32_t>((source.dispfb >> 15u) & 31u);
+        source.psm = psm;
+        if (!fbw)
+            return reject(Reason::SourceWidth);
+        if (!logicalColorFormat(psm))
+            return reject(Reason::SourceFormat);
+        const auto size = logicalDisplaySize(display);
+        source.width = size[0];
+        source.height = size[1];
+        if (source.height > 448u || (source.height & 1u))
+            return reject(Reason::Dimensions);
+        source.displayFbp = source.sourceFbp = fbp;
+        if (!both && request.hasPreferredSource && request.preferredDestFbp == fbp &&
+            (request.preferredSource.fbw || request.preferredSource.fbp != fbp))
+        {
+            const auto &preferred = request.preferredSource;
+            if (!preferred.fbw || preferred.fbw > 63u || preferred.fbp >= 16384u ||
+                preferred.fbp % 32u || !logicalColorFormat(preferred.psm))
+                return reject(Reason::PreferredLayout);
+            source.dispfb = (preferred.fbp / 32u) | (uint64_t(preferred.fbw) << 9u) |
+                             (uint64_t(preferred.psm) << 15u);
+            source.sourceFbp = preferred.fbp; // CPU contract uses 256-byte units.
+            source.psm = preferred.psm;
+            source.preferred = true;
+        }
+        return true;
+    }
+
+    void noteLogicalOutcome(GSParallelProfile::LogicalReason reason, const GSPresentationRequest &request)
+    {
+        if (!GSParallelProfile::Counters::enabled())
+            return;
+        m_profile.logicalReason(reason);
+        const auto now = std::chrono::steady_clock::now();
+        if (m_lastLogicalDump != std::chrono::steady_clock::time_point{} &&
+            now - m_lastLogicalDump < std::chrono::seconds(2))
+            return;
+        m_lastLogicalDump = now;
+        std::fprintf(stderr, "[gs:pgs-request] reason=%s tick=%llu pmode=%016llx smode2=%016llx "
+                     "dispfb=(%016llx,%016llx) display=(%016llx,%016llx) bgcolor=%016llx "
+                     "contexts=(%u,%u,%u,%08x)/(%u,%u,%u,%08x) preferred=%u dest=%u source=(%u,%u,%u,%08x)\n",
+                     GSParallelProfile::reasonName(reason), static_cast<unsigned long long>(request.vsyncTick),
+                     static_cast<unsigned long long>(request.pmode), static_cast<unsigned long long>(request.smode2),
+                     static_cast<unsigned long long>(request.dispfb1), static_cast<unsigned long long>(request.dispfb2),
+                     static_cast<unsigned long long>(request.display1), static_cast<unsigned long long>(request.display2),
+                     static_cast<unsigned long long>(request.bgcolor),
+                     request.contextFrames[0].fbp, request.contextFrames[0].fbw, request.contextFrames[0].psm, request.contextFrames[0].fbmsk,
+                     request.contextFrames[1].fbp, request.contextFrames[1].fbw, request.contextFrames[1].psm, request.contextFrames[1].fbmsk,
+                     request.hasPreferredSource, request.preferredDestFbp,
+                     request.preferredSource.fbp, request.preferredSource.fbw, request.preferredSource.psm, request.preferredSource.fbmsk);
+    }
+
+    bool presentLogicalUnlocked(const GSPresentationRequest &request, PresentationFrame &frame,
+                                std::unique_lock<std::recursive_mutex> &lock)
+    {
+        LogicalSource source;
+        using Reason = GSParallelProfile::LogicalReason;
+        Reason reason = Reason::Accepted;
+        if (!selectLogicalSource(request, source, reason))
+        {
+            noteLogicalOutcome(reason, request);
+            return false;
+        }
+        GSParallelProfile::Scope scanoutProfile(m_profile, GSParallelProfile::Op::Scanout);
+        auto &priv = m_interface.get_priv_register_state();
+        struct RestorePriv
+        {
+            ParallelGS::PrivRegisterState &state;
+            ParallelGS::PrivRegisterState saved;
+            bool active = true;
+            void apply() { if (active) { state = saved; active = false; } }
+            ~RestorePriv() { apply(); }
+        } restore{priv, priv};
+        auto put = [](auto &field, uint64_t value) { std::memcpy(&field, &value, sizeof(value)); };
+        put(priv.pmode, 1u | (1u << 5u) | (255u << 8u));
+        put(priv.smode1, 0x0000000740814504ull);
+        priv.smode1.CMOD = ParallelGS::SMODE1Bits::CMOD_PROGRESSIVE;
+        priv.smode1.LC = ParallelGS::SMODE1Bits::LC_ANALOG;
+        put(priv.smode2, 2u); // Non-interlaced progressive full-frame source.
+        put(priv.dispfb1, source.dispfb);
+        put(priv.dispfb2, 0u);
+        put(priv.display1, (1ull << 23u) | (uint64_t(source.width * 2u - 1u) << 32u) |
+                           (uint64_t(source.height - 1u) << 44u));
+        put(priv.display2, 0u);
+        priv.extwrite.WRITE = 0;
+        ParallelGS::VSyncInfo info{};
+        info.phase = 0;
+        info.dst_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        info.dst_stage = VK_PIPELINE_STAGE_2_COPY_BIT;
+        info.dst_access = VK_ACCESS_2_TRANSFER_READ_BIT;
+        info.adapt_to_internal_horizontal_resolution = true;
+        info.raw_circuit_scanout = true;
+        info.anti_blur = false;
+        info.force_progressive = false;
+        m_interface.flush();
+        auto scanout = m_interface.vsync(info);
+        if (!scanout.image)
+        {
+            noteLogicalOutcome(Reason::MissingImage, request);
+            return false;
+        }
+        if (scanout.image->get_width() != source.width || scanout.image->get_height() != source.height)
+        {
+            noteLogicalOutcome(Reason::ImageSize, request);
+            return false;
+        }
+        const size_t bytes = size_t(source.width) * source.height * 4u;
+        if (!m_logicalBuffer || m_logicalBuffer->get_create_info().size < bytes)
+        {
+            Vulkan::BufferCreateInfo create{};
+            create.size = bytes;
+            create.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            create.domain = Vulkan::BufferDomain::CachedHost;
+            m_logicalBuffer = m_device.create_buffer(create);
+        }
+        if (!m_logicalBuffer)
+        {
+            noteLogicalOutcome(Reason::NoBuffer, request);
+            return false;
+        }
+        auto command = m_device.request_command_buffer();
+        command->copy_image_to_buffer(*m_logicalBuffer, *scanout.image, 0, {},
+                                      {source.width, source.height, 1}, 0, 0,
+                                      {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+        command->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_2_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+        Vulkan::Fence fence;
+        m_device.submit(command, &fence);
+        const uint64_t epoch = m_presentationEpoch;
+        // Presentation owns the buffer and image references until readout ends.
+        // Restore shared GS state before allowing further producer operations.
+        restore.apply();
+        struct RelockGpu
+        {
+            std::unique_lock<std::recursive_mutex> &lock;
+            ~RelockGpu() { if (!lock.owns_lock()) lock.lock(); }
+        } relock{lock};
+        lock.unlock();
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+        runSnapshotHook();
+#endif
+        // Return this request's completed frame; release only the producer lock,
+        // retaining the presentation lock through fence wait and pixel readout.
+        const bool completed = fence && fence->wait_timeout(5000000000ull);
+        lock = profileLock();
+        if (epoch != m_presentationEpoch)
+        {
+            noteLogicalOutcome(Reason::Stale, request);
+            frame = {};
+            return true; // The reset superseded this request; do not fall back.
+        }
+        if (!completed)
+        {
+            noteLogicalOutcome(Reason::FenceTimeout, request);
+            return false;
+        }
+        const auto *data = static_cast<const uint8_t *>(m_device.map_host_buffer(*m_logicalBuffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+        frame.pixels.assign(data, data + bytes);
+        m_device.unmap_host_buffer(*m_logicalBuffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+        const VkFormat format = scanout.image->get_format();
+        lock.unlock();
+        bool nonBlack = false;
+        for (size_t i = 0; i < bytes; i += 4u)
+        {
+            if (format == VK_FORMAT_B8G8R8A8_UNORM || format == VK_FORMAT_B8G8R8A8_SRGB)
+                std::swap(frame.pixels[i], frame.pixels[i + 2u]);
+            if (source.psm == GS_PSM_CT16 || source.psm == GS_PSM_CT16S)
+                for (unsigned channel = 0; channel < 3u; ++channel)
+                    frame.pixels[i + channel] |= frame.pixels[i + channel] >> 5u;
+            nonBlack |= frame.pixels[i] || frame.pixels[i + 1u] || frame.pixels[i + 2u];
+            frame.pixels[i + 3u] = 255u;
+        }
+        lock = profileLock();
+        if (epoch != m_presentationEpoch)
+        {
+            noteLogicalOutcome(Reason::Stale, request);
+            frame = {};
+            return true;
+        }
+        if (!nonBlack && !source.preferred)
+        {
+            noteLogicalOutcome(Reason::BlackDisplay, request);
+            frame = {};
+            return false;
+        }
+        frame.width = source.width;
+        frame.height = source.height;
+        frame.displayFbp = source.displayFbp;
+        frame.sourceFbp = source.sourceFbp;
+        frame.usedPreferred = source.preferred;
+        noteLogicalOutcome(Reason::Accepted, request);
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+        ++m_logicalScanouts;
+#endif
+        return true;
+    }
+
+    bool m_logicalScanout = false;
+    std::chrono::steady_clock::time_point m_lastLogicalDump{};
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+    uint64_t m_logicalScanouts = 0;
+#endif
diff --git a/ps2xRuntime/src/lib/gs/gs_pgs_profile.h b/ps2xRuntime/src/lib/gs/gs_pgs_profile.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_pgs_profile.h
@@ -0,0 +1,138 @@
+#pragma once
+// Private opt-in bridge instrumentation; disabled for normal execution.
+#include <array>
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace GSParallelProfile
+{
+enum class Op : unsigned { Mutex, Gif, Register, NativeImage, Map, Convert, Clear, Finish, NativeCold, Scanout, Count };
+enum class LogicalReason : unsigned
+{
+    Accepted, Interlace, Disabled, CircuitBackground, CircuitSource, CircuitSize,
+    SourceWidth, SourceFormat, Dimensions, PreferredLayout, MissingImage, ImageSize,
+    NoBuffer, FenceTimeout, BlackDisplay, Stale, Count
+};
+inline const char *reasonName(LogicalReason reason)
+{
+    static constexpr const char *names[] = {
+        "accepted", "interlace", "disabled", "circuitBackground", "circuitSource", "circuitSize",
+        "sourceWidth", "sourceFormat", "dimensions", "preferredLayout", "missingImage", "imageSize",
+        "noBuffer", "fenceTimeout", "blackDisplay", "stale"};
+    const auto index = static_cast<unsigned>(reason);
+    return index < static_cast<unsigned>(LogicalReason::Count) ? names[index] : "invalid";
+}
+class Counters
+{
+    using Clock = std::chrono::steady_clock;
+    struct Value { uint64_t calls = 0, ns = 0, maxNs = 0, cpuNs = 0, cpuSamples = 0; };
+    std::array<Value, static_cast<unsigned>(Op::Count)> values{};
+    mutable std::mutex valuesMutex;
+    std::array<uint64_t, static_cast<unsigned>(LogicalReason::Count)> reasons{}, totalReasons{};
+    uint64_t sampleSequence = 0;
+    Clock::time_point reportTime = Clock::now();
+public:
+    static bool enabled()
+    {
+        static const bool on = [] { const char *v = std::getenv("PS2_GS_PGS_PROFILE"); return v && *v && *v != '0'; }();
+        return on;
+    }
+    static uint64_t threadCpuNs()
+    {
+#if defined(_WIN32)
+        FILETIME creation{}, exit{}, kernel{}, user{};
+        if (GetThreadTimes(GetCurrentThread(), &creation, &exit, &kernel, &user))
+        {
+            const uint64_t k = (uint64_t(kernel.dwHighDateTime) << 32) | kernel.dwLowDateTime;
+            const uint64_t u = (uint64_t(user.dwHighDateTime) << 32) | user.dwLowDateTime;
+            return (k + u) * 100u;
+        }
+#endif
+        return 0;
+    }
+    bool sampleCpu(Op op) { return op == Op::Gif && (++sampleSequence & 63u) == 0u; }
+    void add(Op op, uint64_t ns, uint64_t cpuNs, bool sampled)
+    {
+        std::lock_guard lock(valuesMutex);
+        auto &v = values[static_cast<unsigned>(op)];
+        ++v.calls; v.ns += ns; v.maxNs = std::max(v.maxNs, ns);
+        if (sampled) { v.cpuNs += cpuNs; ++v.cpuSamples; }
+    }
+    void logicalReason(LogicalReason reason)
+    {
+        if (!enabled()) return;
+        const auto index = static_cast<unsigned>(reason);
+        if (index >= reasons.size()) return;
+        std::lock_guard lock(valuesMutex);
+        ++reasons[index]; ++totalReasons[index];
+    }
+    uint64_t logicalReasonCount(unsigned reason) const
+    {
+        std::lock_guard lock(valuesMutex);
+        return reason < totalReasons.size() ? totalReasons[reason] : 0u;
+    }
+    void report()
+    {
+        if (!enabled()) return;
+        std::lock_guard lock(valuesMutex);
+        const auto now = Clock::now();
+        if (now - reportTime < std::chrono::seconds(2)) return;
+        static const char *names[] = {"mutexWait", "rawGif", "register", "nativeImage", "mapReadback", "cpuConvert", "clear", "finishWait", "nativeCold", "gpuScanout"};
+        std::fprintf(stderr, "[gs:pgs-profile] intervalMs=%lld",
+                     static_cast<long long>(std::chrono::duration_cast<std::chrono::milliseconds>(now - reportTime).count()));
+        for (unsigned i = 0; i < values.size(); ++i)
+        {
+            const auto &v = values[i];
+            if (!v.calls) continue;
+            std::fprintf(stderr, " %s=%.3fms/%llu max=%.3fms", names[i], v.ns / 1e6,
+                         static_cast<unsigned long long>(v.calls), v.maxNs / 1e6);
+            if (v.cpuSamples)
+                std::fprintf(stderr, " sampledCpuEst=%.3fms/%llu", v.cpuNs * 64.0 / 1e6,
+                             static_cast<unsigned long long>(v.cpuSamples));
+        }
+        for (unsigned i = 0; i < reasons.size(); ++i)
+            if (reasons[i])
+                std::fprintf(stderr, " logical.%s=%llu", reasonName(static_cast<LogicalReason>(i)),
+                             static_cast<unsigned long long>(reasons[i]));
+        std::fputc('\n', stderr);
+        values = {}; reasons = {}; reportTime = now;
+    }
+};
+
+class Scope
+{
+    Counters &owner;
+    Op op;
+    std::chrono::steady_clock::time_point start{};
+    uint64_t cpuStart = 0;
+    bool active = Counters::enabled(), sampled = false;
+public:
+    Scope(Counters &counters, Op operation) : owner(counters), op(operation)
+    {
+        if (!active) return;
+        sampled = owner.sampleCpu(op);
+        if (sampled) cpuStart = Counters::threadCpuNs();
+        start = std::chrono::steady_clock::now();
+    }
+    ~Scope()
+    {
+        if (!active) return;
+        const uint64_t wall = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+        const uint64_t cpu = sampled ? Counters::threadCpuNs() - cpuStart : 0u;
+        owner.add(op, wall, cpu, sampled);
+    }
+};
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_raw_backend_feed.h b/ps2xRuntime/src/lib/gs/gs_raw_backend_feed.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_raw_backend_feed.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "ps2_gs_pgs_bridge.h"
+#if defined(PS2_GS_HAVE_PCSX2)
+#include "ps2_gs_pcsx2_bridge.h"
+#endif
+
+namespace GSBackendFeed {
+inline bool IsRawRasterBackend(const GSRasterBackend& backend) {
+#if defined(PS2_GS_HAVE_PCSX2)
+    if (GSPcsx2::IsRawRasterBackend(backend)) return true;
+#endif
+    return GSParallel::IsRawRasterBackend(backend);
+}
+inline void FeedGif(GSRasterBackend& backend, unsigned path, const uint8_t* bytes, uint32_t size) {
+#if defined(PS2_GS_HAVE_PCSX2)
+    if (GSPcsx2::IsRawRasterBackend(backend)) { GSPcsx2::FeedGif(backend, path, bytes, size); return; }
+#endif
+    GSParallel::FeedGif(backend, path, bytes, size);
+}
+inline void FeedRegister(GSRasterBackend& backend, uint8_t address, uint64_t value) {
+#if defined(PS2_GS_HAVE_PCSX2)
+    if (GSPcsx2::IsRawRasterBackend(backend)) { GSPcsx2::FeedRegister(backend, address, value); return; }
+#endif
+    GSParallel::FeedRegister(backend, address, value);
+}
+inline void FeedImage(GSRasterBackend& backend, const uint8_t* bytes, uint32_t size) {
+#if defined(PS2_GS_HAVE_PCSX2)
+    if (GSPcsx2::IsRawRasterBackend(backend)) { GSPcsx2::FeedImage(backend, bytes, size); return; }
+#endif
+    GSParallel::FeedImage(backend, bytes, size);
+}
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_raw_feed.h b/ps2xRuntime/src/lib/gs/gs_raw_feed.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_raw_feed.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+// Keep the original GIF path and raw-packet nesting in private runtime state.
+// The public frontend API deliberately remains independent of GPU backends.
+namespace GSRawFeed
+{
+    // Host-only VIF continuation wrappers need a tag for the CPU's per-packet
+    // parser. Mark their reserved bits so the stateful raw parser sees only
+    // the original payload. This marker never enters guest RAM.
+    inline constexpr uint64_t continuationMask = ((1ull << 30u) - 1u) << 16u;
+    inline constexpr uint64_t continuationMarker = 0x25ac791bull << 16u;
+    inline bool isContinuationWrapper(const uint8_t *data, uint32_t size)
+    {
+        if (!data || size < 32u) return false;
+        uint64_t tag = 0, regs = 0;
+        std::memcpy(&tag, data, 8u);
+        std::memcpy(&regs, data + 8u, 8u);
+        return (tag & continuationMask) == continuationMarker &&
+               ((tag >> 58u) & 3u) == 2u && regs == 0u &&
+               (tag & ((1ull << 46u) | (0xfull << 60u))) == 0u &&
+               ((tag & 0x7fffu) + 1u) * 16u == size;
+    }
+    inline thread_local unsigned pathIndex = 1u;
+    inline thread_local unsigned packetDepth = 0u;
+    inline thread_local bool acceptedRawRaster = false;
+    inline thread_local const void *acceptedRasterBackend = nullptr;
+#if defined(PS2_GS_PGS_TEST_HOOKS)
+    inline thread_local bool forceFullFrontend = false;
+    inline thread_local uint64_t skippedDrawBatches = 0u, fullDrawBatches = 0u;
+#endif
+    inline thread_local const uint8_t *continuationPacket = nullptr;
+    struct ContinuationScope
+    {
+        const uint8_t *previous;
+        explicit ContinuationScope(const uint8_t *packet) : previous(continuationPacket)
+        { continuationPacket = packet; }
+        ~ContinuationScope() { continuationPacket = previous; }
+    };
+
+    struct PathScope
+    {
+        unsigned previous;
+        explicit PathScope(unsigned path) : previous(pathIndex)
+        {
+            pathIndex = path < 3u ? path : 1u;
+        }
+        ~PathScope() { pathIndex = previous; }
+    };
+
+    struct PacketScope
+    {
+        bool previous;
+        const void *previousBackend;
+        explicit PacketScope(bool accepted = false, const void *backend = nullptr)
+            : previous(acceptedRawRaster), previousBackend(acceptedRasterBackend)
+        { ++packetDepth; acceptedRawRaster = accepted; acceptedRasterBackend = accepted ? backend : nullptr; }
+        ~PacketScope() { --packetDepth; acceptedRawRaster = previous; acceptedRasterBackend = previousBackend; }
+    };
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_upload_policy.h b/ps2xRuntime/src/lib/gs/gs_upload_policy.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_upload_policy.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstdint>
+
+namespace GSUploadPolicy
+{
+    inline thread_local bool bulkImagePacket = false;
+
+    // A complete MPEG frame contains hundreds of macroblock uploads in one
+    // large GIF packet. Small menu/font packets must retain queued uploads.
+    class PacketScope
+    {
+        bool previous;
+    public:
+        explicit PacketScope(uint32_t bytes) : previous(bulkImagePacket)
+        {
+            bulkImagePacket = previous || bytes >= 128u * 1024u;
+        }
+        ~PacketScope() { bulkImagePacket = previous; }
+        PacketScope(const PacketScope &) = delete;
+        PacketScope &operator=(const PacketScope &) = delete;
+    };
+}
diff --git a/ps2xRuntime/src/lib/gs/ps2_gs_pcsx2_bridge.cpp b/ps2xRuntime/src/lib/gs/ps2_gs_pcsx2_bridge.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ps2_gs_pcsx2_bridge.cpp
@@ -0,0 +1,330 @@
+#include "ps2_gs_pcsx2_bridge.h"
+#include "runtime/ps2_memory.h"
+#include "pcsx2_gs_abi.h"
+#include "pcsx2_gs_fp_scope.hpp"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace {
+constexpr uint32_t vramBytes = 4u * 1024u * 1024u;
+uint32_t pixelBits(uint32_t psm) {
+    switch (psm) {
+    case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: return 16;
+    case GS_PSM_CT24: case GS_PSM_Z24: return 24;
+    case GS_PSM_T8: case GS_PSM_T8H: return 8;
+    case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: return 4;
+    default: return 32;
+    }
+}
+
+#ifdef _WIN32
+class Pcsx2Backend final : public GSRasterBackend {
+public:
+    explicit Pcsx2Backend(GSRegisters* registers) : m_registers(registers) {}
+    ~Pcsx2Backend() override {
+        NoblePcsx2GsFpScope fp;
+        if (m_instance && m_api.close && m_api.close(m_instance) != NOBLE_GS_OK) {
+            // Do not unload executable code while an unsuccessful close may still own workers.
+            std::fprintf(stderr, "[gs:pcsx2] Close failed; retaining the adapter until process exit.\n");
+            return;
+        }
+        if (m_library) FreeLibrary(m_library);
+    }
+    void open() {
+        NoblePcsx2GsFpScope fp;
+        if (!m_registers) throw std::runtime_error("PCSX2 GS requires guest privileged registers");
+        std::filesystem::path path;
+        if (const wchar_t* explicitPath = _wgetenv(L"PS2_PCSX2_GS_ADAPTER"); explicitPath && *explicitPath)
+            path = std::filesystem::absolute(explicitPath);
+        else {
+            wchar_t executable[32768];
+            const auto length = GetModuleFileNameW(nullptr, executable, 32768);
+            if (!length || length >= 32768) throw std::runtime_error("PCSX2 GS cannot resolve the application directory");
+            path = std::filesystem::path(executable).parent_path() / L"noble_pcsx2_gs.dll";
+        }
+        m_library = LoadLibraryExW(path.c_str(), nullptr,
+            LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+        if (!m_library) throw std::runtime_error("PCSX2 GS adapter load failed (Windows error " + std::to_string(GetLastError()) + ")");
+        const auto symbol = GetProcAddress(m_library, "noble_pcsx2_gs_query_api");
+        NoblePcsx2GsQueryApi query = nullptr;
+        static_assert(sizeof(query) == sizeof(symbol));
+        std::memcpy(&query, &symbol, sizeof(query));
+        if (!query) throw std::runtime_error("PCSX2 GS adapter has no supported API export");
+        if (query(NOBLE_PCSX2_GS_ABI_VERSION, sizeof(m_api), &m_api) != NOBLE_GS_OK ||
+            m_api.version != NOBLE_PCSX2_GS_ABI_VERSION || m_api.size != sizeof(m_api))
+            throw std::runtime_error("PCSX2 GS adapter ABI mismatch");
+        if (!m_api.identity || !m_api.last_error || !m_api.open || !m_api.close || !m_api.reset ||
+            !m_api.raw_gif || !m_api.write_register || !m_api.image || !m_api.privileged || !m_api.flush ||
+            !m_api.read_fifo || !m_api.vsync || !m_api.rgba || !m_api.read_vram || !m_api.write_vram || !m_api.snapshot_vram)
+            throw std::runtime_error("PCSX2 GS adapter API is incomplete");
+        auto resources = path.parent_path() / L"resources";
+        if (const wchar_t* overridePath = _wgetenv(L"PS2_PCSX2_GS_RESOURCES"); overridePath && *overridePath)
+            resources = std::filesystem::absolute(overridePath);
+        const auto utf8 = resources.u8string();
+        const std::string resourcesUtf8(reinterpret_cast<const char*>(utf8.data()), utf8.size());
+        const NoblePcsx2GsConfig config{sizeof(config), NOBLE_GS_D3D11_SURFACELESS, 640, 448,
+                                       resourcesUtf8.c_str(), 0, 0};
+        check(m_api.open(&config, &m_instance), "open");
+        if (!m_instance) throw std::runtime_error("PCSX2 GS adapter returned an empty instance");
+        // Runtime construction precedes EE execution. Later snapshots are taken only by its producer.
+        m_privileged = readProducerRegisters();
+        publishPrivileged();
+        const char* identity = m_api.identity();
+        if (!identity || !*identity) throw std::runtime_error("PCSX2 GS adapter returned no identity");
+        std::fprintf(stderr, "[gs:pcsx2] %s; adapter=%ls\n", identity, path.c_str());
+    }
+    void Initialize(uint8_t* vram, uint32_t size) override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        // Startup selection is supported; a nonzero VRAM handoff is not a full GS migration.
+        if (!vram || size != vramBytes || std::any_of(vram, vram + size, [](uint8_t b) { return b != 0; }))
+            throw std::runtime_error("PCSX2 GS requires selection before game VRAM is populated");
+        m_externalVram = vram;
+        reset();
+    }
+    void Reset() override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        reset();
+    }
+    void Submit(const GSPrimitiveBatch&) override {} // Raw traffic has already been submitted.
+    void LoadClut(const GSTex0Reg&, const GSTexClutReg&) override {}
+    void TextureFlush() override {} // TEXFLUSH reaches the raw register stream.
+    bool ClearFramebuffer(const GSContext&, uint32_t) override { return false; }
+    void BeginTransfer(const GSTransferCommand& transfer) override {
+        std::lock_guard lock(m_mutex);
+        m_transfer = transfer;
+        m_uploaded = 0;
+        m_fifo.clear(); m_fifoOffset = 0;
+        const auto bits = pixelBits(transfer.direction == 1 ? transfer.bitbltbuf.spsm : transfer.bitbltbuf.dpsm);
+        const uint64_t bytes = (uint64_t(transfer.trxreg.rrw) * transfer.trxreg.rrh * bits + 7) / 8;
+        m_remaining = transfer.direction == 1 ? bytes : 0;
+    }
+    void UploadImage(const uint8_t*, uint32_t size) override {
+        std::lock_guard lock(m_mutex);
+        m_uploaded += size; // FeedGif/FeedImage owns the actual bytes exactly once.
+    }
+    void Flush() override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        check(m_api.flush(m_instance), "flush");
+    }
+    void Sync(GSSyncReason reason) override {
+        if (reason == GSSyncReason::Finish || reason == GSSyncReason::Reset || reason == GSSyncReason::DebugReadback)
+            Flush();
+    }
+    PresentationFrame Present(const GSPresentationRequest& request) override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        if (request.vsyncTick == m_frameTick) return m_frame;
+        // Presentation never reads non-atomic guest MMIO fields from the host thread.
+        auto registers = m_privileged;
+        registers.pmode = request.pmode; registers.smode2 = request.smode2;
+        registers.dispfb1 = request.dispfb1; registers.display1 = request.display1;
+        registers.dispfb2 = request.dispfb2; registers.display2 = request.display2;
+        registers.bgcolor = request.bgcolor;
+        if (request.vsyncTick != m_vsyncTick) {
+            publishPrivileged(registers);
+            check(m_api.vsync(m_instance, static_cast<uint32_t>(request.vsyncTick & 1), 1), "vsync");
+            m_vsyncTick = request.vsyncTick;
+        }
+        NoblePcsx2GsFrame frame{}; frame.size = sizeof(frame);
+        const auto queried = m_api.rgba(m_instance, 640, 448, nullptr, 0, &frame);
+        if (queried != NOBLE_GS_OK && queried != NOBLE_GS_BUFFER_TOO_SMALL) check(queried, "frame query");
+        if (!frame.width || !frame.height) return {};
+        if (frame.width > 8192 || frame.height > 8192 || frame.stride_bytes < uint64_t(frame.width) * 4 ||
+            frame.required_bytes != uint64_t(frame.stride_bytes) * frame.height || frame.required_bytes > 256u * 1024u * 1024u)
+            throw std::runtime_error("PCSX2 GS returned an invalid frame layout");
+        std::vector<uint8_t> pixels(static_cast<size_t>(frame.required_bytes));
+        const auto expected = frame;
+        check(m_api.rgba(m_instance, 640, 448, pixels.data(), pixels.size(), &frame), "frame readback");
+        if (frame.width != expected.width || frame.height != expected.height || frame.stride_bytes != expected.stride_bytes ||
+            frame.required_bytes != expected.required_bytes)
+            throw std::runtime_error("PCSX2 GS frame changed between query and readback");
+        m_frame = {};
+        m_frame.width = frame.width; m_frame.height = frame.height;
+        m_frame.pixels.resize(size_t(frame.width) * frame.height * 4);
+        for (uint32_t y = 0; y < frame.height; ++y)
+            std::memcpy(m_frame.pixels.data() + size_t(y) * frame.width * 4,
+                        pixels.data() + size_t(y) * frame.stride_bytes, size_t(frame.width) * 4);
+        const auto display = (request.pmode & 1) ? request.dispfb1 : request.dispfb2;
+        m_frame.displayFbp = static_cast<uint32_t>(display & 0x1ff);
+        m_frame.sourceFbp = m_frame.displayFbp;
+        m_frameTick = request.vsyncTick;
+        return m_frame;
+    }
+    uint32_t ConsumeLocalToHostBytes(uint8_t* destination, uint32_t maximum) override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        if (!destination || !maximum || !m_remaining) return 0;
+        const auto count = static_cast<uint32_t>(std::min<uint64_t>(maximum, m_remaining));
+        if (m_fifo.size() - m_fifoOffset < count) {
+            const auto bytes = (m_remaining + 15) & ~uint64_t(15);
+            if (bytes > std::numeric_limits<uint32_t>::max()) throw std::runtime_error("PCSX2 GS FIFO transfer is too large");
+            std::vector<uint8_t> pending(static_cast<size_t>(bytes));
+            check(m_api.read_fifo(m_instance, pending.data(), static_cast<uint32_t>(bytes)), "FIFO readback");
+            m_fifo.swap(pending); m_fifoOffset = 0;
+        }
+        std::memcpy(destination, m_fifo.data() + m_fifoOffset, count);
+        m_fifoOffset += count; m_remaining -= count;
+        return count;
+    }
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t width, uint32_t x, uint32_t y) const override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        uint32_t value = 0;
+        check(m_api.read_vram(m_instance, psm, base, width, x, y, &value), "VRAM read");
+        return value;
+    }
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t width, uint32_t x, uint32_t y, uint32_t value) override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        check(m_api.write_vram(m_instance, psm, base, width, x, y, value), "VRAM write");
+    }
+    void SnapshotVram(std::vector<uint8_t>& result) const override {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        result.resize(vramBytes);
+        check(m_api.snapshot_vram(m_instance, result.data(), vramBytes), "VRAM snapshot");
+        if (m_externalVram) std::memcpy(m_externalVram, result.data(), vramBytes);
+    }
+    GSTransferSnapshot GetTransferSnapshot() const override {
+        std::lock_guard lock(m_mutex);
+        GSTransferSnapshot result{};
+        result.direction = m_transfer.direction;
+        result.totalPixels = m_transfer.trxreg.rrw * m_transfer.trxreg.rrh;
+        result.copiedPixels = m_transfer.direction == 1 || m_transfer.direction == 2 ? result.totalPixels :
+            static_cast<uint32_t>(std::min<uint64_t>(result.totalPixels, m_uploaded * 8 / pixelBits(m_transfer.bitbltbuf.dpsm)));
+        result.x = m_transfer.trxreg.rrw ? result.copiedPixels % m_transfer.trxreg.rrw : 0;
+        result.y = m_transfer.trxreg.rrw ? result.copiedPixels / m_transfer.trxreg.rrw : 0;
+        result.localToHostPendingBytes = static_cast<size_t>(m_remaining);
+        return result;
+    }
+    void feedGif(unsigned path, const uint8_t* bytes, uint32_t size) {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        if (path > 2 || (!bytes && size)) throw std::runtime_error("PCSX2 GS invalid raw GIF span");
+        captureProducerRegisters();
+        publishPrivileged();
+        check(m_api.raw_gif(m_instance, path + 1, bytes, size), "raw GIF");
+    }
+    void feedRegister(uint8_t address, uint64_t value) {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        captureProducerRegisters();
+        publishPrivileged();
+        if (address < 0x80) check(m_api.write_register(m_instance, address, value), "GS register");
+    }
+    void feedImage(const uint8_t* bytes, uint32_t size) {
+        NoblePcsx2GsFpScope fp;
+        std::lock_guard lock(m_mutex);
+        captureProducerRegisters();
+        publishPrivileged();
+        check(m_api.image(m_instance, bytes, size), "native IMAGE");
+    }
+private:
+    void check(int32_t status, const char* operation) const {
+        if (status == NOBLE_GS_OK) return;
+        char details[512]{};
+        if (m_api.last_error) m_api.last_error(details, sizeof(details));
+        details[sizeof(details) - 1] = 0;
+        throw std::runtime_error(std::string("PCSX2 GS ") + operation + " failed (" + std::to_string(status) + "): " + details);
+    }
+    NoblePcsx2GsPrivRegs readProducerRegisters() const {
+        const auto& r = *m_registers;
+        return {r.pmode,r.smode1,r.smode2,r.srfsh,r.synch1,r.synch2,r.syncv,
+                r.dispfb1,r.display1,r.dispfb2,r.display2,r.extbuf,r.extdata,r.extwrite,r.bgcolor,
+                r.csr.load(std::memory_order_acquire),r.imr,r.busdir,r.siglblid};
+    }
+    void captureProducerRegisters() {
+        // Native worker output is committed on the EE producer before entering the GS frontend.
+        // That thread also owns the non-atomic MMIO writes; a different producer needs a new contract.
+        const auto producer = GetCurrentThreadId();
+        if (m_producerThread && m_producerThread != producer)
+            throw std::runtime_error("PCSX2 GS received guest register traffic from another producer thread");
+        m_producerThread = producer;
+        m_privileged = readProducerRegisters();
+    }
+    void publishPrivileged(const NoblePcsx2GsPrivRegs& snapshot) {
+        if (m_havePublished && std::memcmp(&snapshot, &m_published, sizeof(snapshot)) == 0) return;
+        check(m_api.privileged(m_instance, &snapshot), "privileged registers");
+        m_published = snapshot;
+        m_havePublished = true;
+    }
+    void publishPrivileged() {
+        publishPrivileged(m_privileged);
+    }
+    void reset() {
+        check(m_api.reset(m_instance), "reset");
+        m_havePublished = false;
+        publishPrivileged();
+        m_frame = {}; m_vsyncTick = m_frameTick = ~uint64_t(0);
+        m_producerThread = 0;
+        m_transfer = {}; m_fifo.clear(); m_fifoOffset = 0; m_remaining = m_uploaded = 0;
+    }
+    HMODULE m_library = nullptr;
+    NoblePcsx2GsApi m_api{};
+    NoblePcsx2GsInstance m_instance = nullptr;
+    GSRegisters* m_registers;
+    NoblePcsx2GsPrivRegs m_privileged{};
+    NoblePcsx2GsPrivRegs m_published{};
+    bool m_havePublished = false;
+    DWORD m_producerThread = 0;
+    uint8_t* m_externalVram = nullptr;
+    mutable std::mutex m_mutex;
+    GSTransferCommand m_transfer{};
+    uint64_t m_uploaded = 0, m_remaining = 0, m_vsyncTick = ~uint64_t(0), m_frameTick = ~uint64_t(0);
+    std::vector<uint8_t> m_fifo;
+    size_t m_fifoOffset = 0;
+    PresentationFrame m_frame;
+};
+#endif
+}
+
+namespace GSPcsx2 {
+std::unique_ptr<GSRasterBackend> CreateBackend(GSRegisters* registers) {
+#ifdef _WIN32
+    auto backend = std::make_unique<Pcsx2Backend>(registers);
+    backend->open();
+    return backend;
+#else
+    (void)registers;
+    throw std::runtime_error("PCSX2 GS adapter is supported only on Windows in this build");
+#endif
+}
+bool IsRawRasterBackend(const GSRasterBackend& backend) {
+#ifdef _WIN32
+    return dynamic_cast<const Pcsx2Backend*>(&backend) != nullptr;
+#else
+    (void)backend; return false;
+#endif
+}
+void FeedGif(GSRasterBackend& backend, unsigned pathIndex, const uint8_t* bytes, uint32_t size) {
+#ifdef _WIN32
+    if (auto* gs = dynamic_cast<Pcsx2Backend*>(&backend)) gs->feedGif(pathIndex, bytes, size);
+#endif
+}
+void FeedRegister(GSRasterBackend& backend, uint8_t address, uint64_t value) {
+#ifdef _WIN32
+    if (auto* gs = dynamic_cast<Pcsx2Backend*>(&backend)) gs->feedRegister(address, value);
+#endif
+}
+void FeedImage(GSRasterBackend& backend, const uint8_t* bytes, uint32_t size) {
+#ifdef _WIN32
+    if (auto* gs = dynamic_cast<Pcsx2Backend*>(&backend)) gs->feedImage(bytes, size);
+#endif
+}
+}
diff --git a/ps2xRuntime/src/lib/gs/ps2_gs_pcsx2_bridge.h b/ps2xRuntime/src/lib/gs/ps2_gs_pcsx2_bridge.h
