@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+class PS2Memory;
+
+bool NobleVif1Configured(const PS2Memory *) noexcept;
+bool NobleVif1DmaOutstanding(const PS2Memory *) noexcept;
+bool NobleVif1AnyCompletionReady() noexcept;
+bool NobleVif1SubmitDma(
+    PS2Memory *, std::vector<uint8_t>,
+    std::function<void(const uint8_t *, uint32_t)>);
+
diff --git a/ps2xRuntime/src/lib/vif1_worker_queue.h b/ps2xRuntime/src/lib/vif1_worker_queue.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vif1_worker_queue.h
@@ -0,0 +1,98 @@
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+// One owning job and one unconsumed result. Callers must finish/consume before
+// reusing guest resources. No detached thread, caller-thread job execution, or
+// implicit consumption. Destroy only outside the worker thread, with no other
+// users concurrently accessing this object's lifetime.
+class NobleVif1Worker final {
+public:
+ struct Completion { bool completed=false; std::exception_ptr error; };
+ explicit NobleVif1Worker(std::function<void()> cleanupOnWorker={},
+                          std::function<void()> notifyCompletion={},
+                          std::atomic<bool>* externalReady=nullptr)
+  :m_cleanup(std::move(cleanupOnWorker)),m_notify(std::move(notifyCompletion)),
+   m_externalReady(externalReady),m_thread([this]{run();}) {
+   if(m_externalReady)m_externalReady->store(false,std::memory_order_release);
+  }
+ NobleVif1Worker(const NobleVif1Worker&)=delete;
+ NobleVif1Worker& operator=(const NobleVif1Worker&)=delete;
+ ~NobleVif1Worker() noexcept {
+  // Self-destruction cannot join and would invalidate a running member function.
+  if(isWorkerThread())std::terminate();
+  {std::lock_guard<std::mutex> lock(m_mutex);m_stopping=true;}
+  m_changed.notify_all();m_thread.join();
+ }
+ void submit(std::function<void()> owningJob) {
+  if(!owningJob)throw std::invalid_argument("empty VIF1 worker job");
+  {std::lock_guard<std::mutex> lock(m_mutex);
+   if(m_stopping||m_active||m_ready)throw std::logic_error("VIF1 worker busy or result unconsumed");
+   m_job=std::move(owningJob);m_active=true;
+  }
+  m_changed.notify_all();
+ }
+ Completion tryComplete() {
+  if(isWorkerThread())throw std::logic_error("VIF1 worker cannot consume its own result");
+  std::lock_guard<std::mutex> lock(m_mutex);return consumeLocked();
+ }
+ Completion finish() {
+  if(isWorkerThread())throw std::logic_error("VIF1 worker cannot fence itself");
+  std::unique_lock<std::mutex> lock(m_mutex);
+  m_changed.wait(lock,[this]{return m_ready||!m_active;});
+  return consumeLocked();
+ }
+ bool completionReady() const noexcept {return m_completionReady.load(std::memory_order_acquire);}
+ bool busy() const {
+  std::lock_guard<std::mutex> lock(m_mutex);return m_active||m_ready;
+ }
+ bool isWorkerThread() const noexcept {return std::this_thread::get_id()==m_thread.get_id();}
+private:
+ // External flag storage must outlive this worker (including its joined shutdown).
+ void publishReadyLocked(bool ready) noexcept {
+  m_completionReady.store(ready,std::memory_order_release);
+  if(m_externalReady)m_externalReady->store(ready,std::memory_order_release);
+ }
+ Completion consumeLocked() {
+  if(!m_ready)return {};
+  Completion result{true,std::move(m_error)};m_ready=false;m_error=nullptr;publishReadyLocked(false);return result;
+ }
+ void run() noexcept {
+  for(;;){
+   std::function<void()> job;
+   {std::unique_lock<std::mutex> lock(m_mutex);
+    m_changed.wait(lock,[this]{return m_stopping||bool(m_job);});
+    if(!m_job)break; // Shutdown waits for the last submitted job, never drops it.
+    job=std::move(m_job);m_job={};
+   }
+   std::exception_ptr error;
+   try{job();}catch(...){error=std::current_exception();}
+   // Destroy captures on the worker before publishing completion. Their guest
+   // resource lifetime cannot outlast finish(), even when destruction has work.
+   job={};
+   {std::lock_guard<std::mutex> lock(m_mutex);m_error=std::move(error);m_active=false;m_ready=true;publishReadyLocked(true);}
+   m_changed.notify_all();
+   // Notification is a wakeup only. It may inspect busy(); it is
+   // outside the mutex and cannot replace or erase the job exception.
+   if(m_notify)try{m_notify();}catch(...){}
+  }
+  // Native TLS owner teardown belongs to the same persistent execution thread.
+  // Cleanup must be noexcept in integrations; destructor cannot deliver errors.
+  if(m_cleanup)try{m_cleanup();}catch(...){}
+ }
+ mutable std::mutex m_mutex;
+ std::condition_variable m_changed;
+ std::function<void()> m_job,m_cleanup,m_notify;
+ std::exception_ptr m_error;
+ bool m_active=false,m_ready=false,m_stopping=false;
+ std::atomic<bool> m_completionReady{false};
+ std::atomic<bool>* m_externalReady=nullptr;
+ // Last member: every object read by run() is constructed before thread start.
+ std::thread m_thread;
+};
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_capture.h b/ps2xRuntime/src/lib/vu/ps2_vu1_capture.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_capture.h
@@ -0,0 +1,412 @@
+#ifndef PS2_VU1_CAPTURE_H
+#define PS2_VU1_CAPTURE_H
+#define PS2_VU_CHAIN_CAPTURE_SUPPORTED 1
+#define PS2_VU_CHAIN_GATE_SUPPORTED 1
+
+#include "runtime/ps2_vu1.h"
+
+#include <cstdio>
+#include <chrono>
+#include <cstddef>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Private execute-boundary replay format. A fresh execute clears the scheduler,
+// so its public register state is sufficient; an arbitrary resume is not.
+namespace vu_replay
+{
+    constexpr uint32_t kInputMagic = 0x31554956u; // VIU1
+    constexpr uint32_t kOutputMagic = 0x31554f56u; // VOU1
+    constexpr uint32_t kVersion = 1u;
+
+    struct InputHeader
+    {
+        uint32_t magic = kInputMagic;
+        uint32_t version = kVersion;
+        uint32_t stateSize = sizeof(VU1State);
+        uint32_t codeSize = 0u;
+        uint32_t dataSize = 0u;
+        uint32_t maxCycles = 0u;
+    };
+
+    struct OutputHeader
+    {
+        uint32_t magic = kOutputMagic;
+        uint32_t version = kVersion;
+        uint32_t stateSize = sizeof(VU1State);
+        uint32_t dataSize = 0u;
+        uint32_t packetCount = 0u;
+    };
+
+    constexpr uint32_t stateLayout()
+    {
+        uint32_t hash = 2166136261u;
+        for (const uint32_t part : {uint32_t(sizeof(VU1State)), uint32_t(offsetof(VU1State, vf)),
+             uint32_t(offsetof(VU1State, vi)), uint32_t(offsetof(VU1State, acc)),
+             uint32_t(offsetof(VU1State, q)), uint32_t(offsetof(VU1State, p)),
+             uint32_t(offsetof(VU1State, i)), uint32_t(offsetof(VU1State, r)),
+             uint32_t(offsetof(VU1State, pc)), uint32_t(offsetof(VU1State, mac)),
+             uint32_t(offsetof(VU1State, clip)), uint32_t(offsetof(VU1State, status)),
+             uint32_t(offsetof(VU1State, cycles)), uint32_t(offsetof(VU1State, ebit)),
+             uint32_t(offsetof(VU1State, haltAfterDelaySlot)), uint32_t(offsetof(VU1State, dBitEnabled)),
+             uint32_t(offsetof(VU1State, tBitEnabled)), uint32_t(offsetof(VU1State, stoppedByD)),
+             uint32_t(offsetof(VU1State, stoppedByT)), uint32_t(offsetof(VU1State, top)),
+             uint32_t(offsetof(VU1State, itop)), uint32_t(offsetof(VU1State, branchPending)),
+             uint32_t(offsetof(VU1State, branchTarget)), uint32_t(offsetof(VU1State, branchDelay))})
+            hash = (hash ^ part) * 16777619u;
+        return hash;
+    }
+
+    constexpr uint32_t kChainMagic = 0x31554356u; // VCU1
+    constexpr uint64_t kMaxChainBytes = 64u * 1024u * 1024u;
+    struct ChainHeader
+    {
+        uint32_t magic = kChainMagic;
+        uint32_t version = kVersion;
+        uint32_t stateSize = sizeof(VU1State);
+        uint32_t layout = stateLayout();
+        uint32_t callCount = 0u;
+    };
+    struct ChainCallHeader
+    {
+        uint32_t resume = 0u;
+        uint32_t codeSize = 0u;
+        uint32_t dataSize = 0u;
+        uint32_t maxCycles = 0u;
+    };
+    struct ChainCall
+    {
+        ChainCallHeader header;
+        VU1State initial{};
+        VU1State final{};
+        std::vector<uint8_t> code;
+        std::vector<uint8_t> data;
+        std::vector<uint8_t> finalData;
+        std::vector<std::vector<uint8_t>> packets;
+    };
+    struct Chain
+    {
+        const void *owner = nullptr; // transient identity; never serialized
+        FILE *file = nullptr;
+        std::vector<ChainCall> pending;
+        uint32_t calls = 0u;
+        uint32_t startPc = 0u;
+        uint64_t bytes = sizeof(ChainHeader);
+        bool selected = false;
+        bool discarded = false;
+        ~Chain() { if (file) std::fclose(file); }
+        void reset(const void *newOwner, uint32_t pc)
+        {
+            if (file) std::fclose(file);
+            file = nullptr;
+            pending.clear();
+            calls = 0u;
+            startPc = pc;
+            bytes = sizeof(ChainHeader);
+            selected = false;
+            discarded = false;
+            owner = newOwner;
+        }
+    };
+    inline Chain &captureChain()
+    {
+        static thread_local Chain chain;
+        return chain;
+    }
+    inline thread_local uint32_t successfulChains = 0u;
+    inline thread_local uint32_t chainReports = 0u;
+
+    inline bool chainEnabled()
+    {
+        static const bool enabled = [] {
+            const char *flag = std::getenv("PS2_VU_CAPTURE_CHAIN");
+            return flag && *flag && std::strcmp(flag, "0") != 0;
+        }();
+        return enabled;
+    }
+
+    inline uint32_t chainLimit()
+    {
+        static const uint32_t limit = [] {
+            const char *value = std::getenv("PS2_VU_CAPTURE_CHAIN_CALLS");
+            const unsigned long parsed = value && *value ? std::strtoul(value, nullptr, 10) : 64u;
+            return static_cast<uint32_t>(parsed < 2u ? 2u : parsed > 4096u ? 4096u : parsed);
+        }();
+        return limit;
+    }
+
+    struct CaptureGate
+    {
+        bool enabled = false;
+        uint32_t callsUntilPoll = 0u;
+        std::chrono::steady_clock::time_point nextPoll{};
+    };
+    inline CaptureGate &captureGate()
+    {
+        static thread_local CaptureGate gate;
+        return gate;
+    }
+    inline bool captureGateReady()
+    {
+        static const char *path = std::getenv("PS2_VU_CAPTURE_GATE_FILE");
+        if (!path || !*path)
+            return true; // No clock or filesystem work in the default path.
+        CaptureGate &gate = captureGate();
+        if (gate.enabled)
+            return true;
+        if (gate.callsUntilPoll != 0u)
+        {
+            --gate.callsUntilPoll;
+            return false;
+        }
+        gate.callsUntilPoll = 255u;
+        const auto now = std::chrono::steady_clock::now();
+        if (now < gate.nextPoll)
+            return false;
+        gate.nextPoll = now + std::chrono::seconds(1);
+        if (FILE *file = std::fopen(path, "rb"))
+        {
+            std::fclose(file);
+            gate.enabled = true;
+            std::fprintf(stderr, "[VU:capture-gate] enabled path=%s; next fresh execute begins chain\n", path);
+        }
+        return gate.enabled;
+    }
+
+    inline void writeChainCall(FILE *file, const ChainCall &call)
+    {
+        std::fwrite(&call.header, sizeof(call.header), 1u, file);
+        std::fwrite(&call.initial, sizeof(call.initial), 1u, file);
+        std::fwrite(call.code.data(), 1u, call.code.size(), file);
+        std::fwrite(call.data.data(), 1u, call.data.size(), file);
+        std::fwrite(&call.final, sizeof(call.final), 1u, file);
+        std::fwrite(call.finalData.data(), 1u, call.finalData.size(), file);
+        const uint32_t packets = static_cast<uint32_t>(call.packets.size());
+        std::fwrite(&packets, sizeof(packets), 1u, file);
+        for (const auto &packet : call.packets)
+        {
+            const uint32_t size = static_cast<uint32_t>(packet.size());
+            std::fwrite(&size, sizeof(size), 1u, file);
+            std::fwrite(packet.data(), 1u, size, file);
+        }
+    }
+
+    class Capture;
+    inline thread_local Capture *activeCapture = nullptr;
+
+    class Capture
+    {
+    public:
+        Capture(bool isVu1, const VU1State &state, const uint8_t *code,
+                uint32_t codeSize, const uint8_t *data, uint32_t dataSize,
+                uint32_t maxCycles, const void *owner = nullptr, bool resume = false)
+        {
+            static const char *prefix = std::getenv("PS2_VU_CAPTURE_PREFIX");
+            if (!prefix || !*prefix || !isVu1 || activeCapture)
+                return;
+            if (chainEnabled())
+            {
+                Chain &chain = captureChain();
+                const bool gateReady = captureGateReady();
+                if (!resume)
+                {
+                    chain.reset(owner, state.pc);
+                    // An opening gate in the middle of a previously skipped
+                    // invocation cannot recreate its hidden pipeline state.
+                    chain.discarded = !gateReady;
+                }
+                if (!gateReady)
+                    return;
+                static const uint32_t limit = [] {
+                    const char *value = std::getenv("PS2_VU_CAPTURE_COUNT");
+                    return value && *value ? static_cast<uint32_t>(std::strtoul(value, nullptr, 10)) : 1u;
+                }();
+                if (chain.owner != owner || chain.discarded ||
+                    (!chain.file && successfulChains >= limit))
+                    return;
+                if (chain.calls >= chainLimit())
+                {
+                    if (!chain.selected && chainReports++ < 4u)
+                        std::fprintf(stderr, "[VU:capture-chain] discarded before selector calls=%u start=%x\n",
+                                     chain.calls, chain.startPc);
+                    if (chain.file) std::fclose(chain.file);
+                    chain.file = nullptr;
+                    chain.pending.clear();
+                    chain.discarded = true;
+                    return;
+                }
+                const uint64_t bytes = sizeof(ChainCallHeader) + 2u * sizeof(VU1State) +
+                                       uint64_t(codeSize) + 2u * uint64_t(dataSize) + sizeof(uint32_t);
+                if (chain.bytes + bytes > kMaxChainBytes)
+                {
+                    if (chainReports++ < 4u)
+                        std::fprintf(stderr, "[VU:capture-chain] reached byte bound calls=%u selected=%u\n",
+                                     chain.calls, chain.selected);
+                    if (chain.file) std::fclose(chain.file);
+                    chain.file = nullptr;
+                    chain.pending.clear();
+                    chain.discarded = true;
+                    return;
+                }
+                chain.bytes += bytes;
+                static const char *entry = std::getenv("PS2_VU_CAPTURE_RESUME_ENTRY");
+                if (resume && (!entry || !*entry || state.pc == std::strtoul(entry, nullptr, 16)))
+                    chain.selected = true;
+                ChainCall &call = chain.pending.emplace_back();
+                call.header = {resume ? 1u : 0u, codeSize, dataSize, maxCycles};
+                call.initial = state;
+                call.code.assign(code, code + codeSize);
+                call.data.assign(data, data + dataSize);
+                m_chainCall = &call;
+                m_entryCycle = state.cycles;
+                activeCapture = this;
+                return;
+            }
+            if (!captureGateReady())
+                return;
+            if (resume)
+                return;
+            static const char *entry = std::getenv("PS2_VU_CAPTURE_ENTRY");
+            if (entry && *entry && state.pc != std::strtoul(entry, nullptr, 16))
+                return;
+            static const uint32_t limit = [] {
+                const char *count = std::getenv("PS2_VU_CAPTURE_COUNT");
+                return count && *count ? static_cast<uint32_t>(std::strtoul(count, nullptr, 10)) : 1u;
+            }();
+            static thread_local uint32_t count = 0u;
+            static thread_local uint32_t failedReports = 0u;
+            if (count >= limit)
+                return;
+
+            char suffix[64]{};
+            std::snprintf(suffix, sizeof(suffix), "_%04u_%04x", count, state.pc);
+            m_prefix = std::string(prefix) + suffix;
+            FILE *file = std::fopen((m_prefix + "_input.bin").c_str(), "wb");
+            if (!file)
+            {
+                if (failedReports++ < 4u)
+                    std::fprintf(stderr, "[VU:capture] cannot write %s_input.bin\n", m_prefix.c_str());
+                m_prefix.clear();
+                return;
+            }
+            ++count;
+            const InputHeader header{kInputMagic, kVersion, sizeof(VU1State), codeSize, dataSize, maxCycles};
+            std::fwrite(&header, sizeof(header), 1u, file);
+            std::fwrite(&state, sizeof(state), 1u, file);
+            std::fwrite(code, 1u, codeSize, file);
+            std::fwrite(data, 1u, dataSize, file);
+            std::fclose(file);
+            m_entryCycle = state.cycles;
+            activeCapture = this;
+        }
+
+        ~Capture()
+        {
+            if (activeCapture == this)
+                activeCapture = nullptr;
+        }
+
+        void packet(const uint8_t *bytes, uint32_t size)
+        {
+            if (m_chainCall)
+            {
+                Chain &chain = captureChain();
+                if (chain.bytes + size + sizeof(uint32_t) > kMaxChainBytes)
+                {
+                    chain.discarded = true;
+                    return;
+                }
+                if (!chain.discarded)
+                {
+                    chain.bytes += size + sizeof(uint32_t);
+                    m_chainCall->packets.emplace_back(bytes, bytes + size);
+                }
+            }
+            else
+                m_packets.emplace_back(bytes, bytes + size);
+        }
+
+        void finish(const VU1State &state, const uint8_t *data, uint32_t dataSize)
+        {
+            if (m_chainCall)
+            {
+                Chain &chain = captureChain();
+                if (chain.discarded)
+                {
+                    if (chainReports++ < 4u)
+                        std::fprintf(stderr, "[VU:capture-chain] reached packet byte bound calls=%u\n", chain.calls);
+                    if (chain.file) std::fclose(chain.file);
+                    chain.file = nullptr;
+                    chain.pending.clear();
+                    m_chainCall = nullptr;
+                    return;
+                }
+                m_chainCall->final = state;
+                m_chainCall->final.cycles -= m_entryCycle;
+                m_chainCall->finalData.assign(data, data + dataSize);
+                ++chain.calls;
+                if (!chain.selected)
+                    return;
+                if (!chain.file)
+                {
+                    char suffix[64]{};
+                    std::snprintf(suffix, sizeof(suffix), "_chain_%04u_%04x.bin", successfulChains, chain.startPc);
+                    const std::string path = std::string(std::getenv("PS2_VU_CAPTURE_PREFIX")) + suffix;
+                    chain.file = std::fopen(path.c_str(), "wb");
+                    if (!chain.file)
+                    {
+                        if (chainReports++ < 4u)
+                            std::fprintf(stderr, "[VU:capture-chain] cannot write %s\n", path.c_str());
+                        return;
+                    }
+                    ++successfulChains;
+                    const ChainHeader header{kChainMagic, kVersion, sizeof(VU1State), stateLayout(), chain.calls};
+                    std::fwrite(&header, sizeof(header), 1u, chain.file);
+                    std::fprintf(stderr, "[VU:capture-chain] prefix=%s selected=%x preceding=%zu limit=%u\n",
+                                 path.c_str(), m_chainCall->initial.pc, chain.pending.size() - 1u, chainLimit());
+                }
+                for (const ChainCall &call : chain.pending)
+                    writeChainCall(chain.file, call);
+                chain.pending.clear();
+                m_chainCall = nullptr;
+                const ChainHeader header{kChainMagic, kVersion, sizeof(VU1State), stateLayout(), chain.calls};
+                std::fseek(chain.file, 0, SEEK_SET);
+                std::fwrite(&header, sizeof(header), 1u, chain.file);
+                std::fseek(chain.file, 0, SEEK_END);
+                std::fflush(chain.file);
+                return;
+            }
+            if (m_prefix.empty())
+                return;
+            FILE *file = std::fopen((m_prefix + "_output.bin").c_str(), "wb");
+            if (!file)
+                return;
+            const OutputHeader header{kOutputMagic, kVersion, sizeof(VU1State), dataSize,
+                                      static_cast<uint32_t>(m_packets.size())};
+            VU1State finalState = state;
+            finalState.cycles -= m_entryCycle;
+            std::fwrite(&header, sizeof(header), 1u, file);
+            std::fwrite(&finalState, sizeof(finalState), 1u, file);
+            std::fwrite(data, 1u, dataSize, file);
+            for (const auto &packet : m_packets)
+            {
+                const uint32_t size = static_cast<uint32_t>(packet.size());
+                std::fwrite(&size, sizeof(size), 1u, file);
+                std::fwrite(packet.data(), 1u, size, file);
+            }
+            std::fclose(file);
+            std::fprintf(stderr, "[VU:capture] prefix=%s cycles=%llu packets=%u\n", m_prefix.c_str(),
+                         static_cast<unsigned long long>(finalState.cycles), header.packetCount);
+        }
+
+    private:
+        std::string m_prefix;
+        uint64_t m_entryCycle = 0u;
+        std::vector<std::vector<uint8_t>> m_packets;
+        ChainCall *m_chainCall = nullptr;
+    };
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_native.h b/ps2xRuntime/src/lib/vu/ps2_vu1_native.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_native.h
@@ -0,0 +1,81 @@
+#pragma once
+
+// Optional native backend. The interpreter remains the default and the VU0
+// implementation; enabling this backend requires an explicitly selected DLL.
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <stdexcept>
+#include <string>
+
+namespace native_vu {
+using Packet = void (*)(void*, const uint8_t*, uint32_t);
+using Run = bool (*)(void*, VU1State*, uint8_t*, uint32_t, uint8_t*, uint32_t,
+                    uint32_t, bool, Packet, void*);
+struct Api { HMODULE module; Run run; void (*reset)(void*); };
+inline bool enabled()
+{
+    static const bool selected = [] {
+        const char* value = std::getenv("PS2_VU_BACKEND");
+        return value && std::strcmp(value, "play") == 0;
+    }();
+    return selected;
+}
+inline Api& api()
+{
+    static Api backend = [] {
+        wchar_t executable[32768];
+        const DWORD length = GetModuleFileNameW(nullptr, executable, 32768);
+        if (!length || length == 32768)
+            throw std::runtime_error("Cannot locate native VU backend directory");
+        std::wstring path(executable, length);
+        path.resize(path.find_last_of(L"\\/") + 1);
+        path += L"noble_vu_jit.dll";
+        HMODULE module = LoadLibraryExW(path.c_str(), nullptr,
+            LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+        if (!module) throw std::runtime_error("Native VU DLL unavailable: noble_vu_jit.dll");
+        auto version = reinterpret_cast<uint32_t (*)()>(GetProcAddress(module, "noble_play_vu_version"));
+        auto size = reinterpret_cast<uint32_t (*)()>(GetProcAddress(module, "noble_play_vu_state_size"));
+        auto run = reinterpret_cast<Run>(GetProcAddress(module, "noble_play_vu_run"));
+        auto reset = reinterpret_cast<void (*)(void*)>(GetProcAddress(module, "noble_play_vu_reset"));
+        if (!version || !size || !run || !reset || version() != 1 || size() != sizeof(VU1State))
+        {
+            FreeLibrary(module);
+            throw std::runtime_error("Incompatible native VU DLL API");
+        }
+        std::fprintf(stderr, "[native-vu] Experimental Play! VU1 compiler enabled\n");
+        return Api{module, run, reset};
+    }();
+    return backend;
+}
+inline void reset(void* owner) { if (enabled()) api().reset(owner); }
+inline bool execute(void* owner, VU1State& state, uint8_t* code, uint32_t codeSize,
+                    uint8_t* data, uint32_t dataSize, GS& gs, PS2Memory* memory,
+                    uint32_t budget, bool resume)
+{
+    if (!enabled() || codeSize != 16384 || dataSize != 16384) return false;
+    struct Target { GS* gs; PS2Memory* memory; } target{&gs, memory};
+    auto packet = [](void* opaque, const uint8_t* bytes, uint32_t size) {
+        auto& target = *static_cast<Target*>(opaque);
+        if (vu_replay::activeCapture) vu_replay::activeCapture->packet(bytes, size);
+        if (target.memory) target.memory->submitGifPacket(GifPathId::Path1, bytes, size);
+        else target.gs->processGIFPacket(bytes, size);
+    };
+    const uint64_t entryCycles = state.cycles;
+    if (!api().run(owner, &state, code, codeSize, data, dataSize, budget, resume, packet, &target))
+        throw std::runtime_error("Native VU execution failed");
+    // The DLL ABI reports this invocation's delta; VU1Interpreter publishes an
+    // absolute clock, which capture.finish normalizes using its entry clock.
+    state.cycles += entryCycles;
+    return true;
+}
+}
+#else
+namespace native_vu {
+inline void reset(void*) {}
+inline bool execute(void*, VU1State&, uint8_t*, uint32_t, uint8_t*, uint32_t,
+                    GS&, PS2Memory*, uint32_t, bool) { return false; }
+}
+#endif
diff --git a/ps2xRuntime/src/lib/vu/vu_fmac_math.h b/ps2xRuntime/src/lib/vu/vu_fmac_math.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/vu_fmac_math.h
@@ -0,0 +1,281 @@
+#pragma once
+#include "ps2_vu1_detail.h"
+#include <cmath>
+#include <limits>
+
+// With 53/64-bit x87 precision, binary32 products are represented exactly by
+// binary64 (at most 48 significand bits, magnitude 2^-252 through 2^256).
+// The double sum is rounded toward zero just like the original long-double
+// sum. Float min/max are exact binary64 grid points: a strictly interior
+// double magnitude cannot hide a long-double zero, underflow or overflow.
+// A zero result is exact: binary32 products have no bits below 2^-298,
+// well above the binary64 underflow limit, and close cancellation fits in
+// 48 significant bits. Matching x87/SSE rounding keeps its signed-zero rule.
+// Threshold cases retain the original evaluator.
+inline bool vuWideProductPrecision()
+{
+#if defined(__GNUC__) && defined(__x86_64__)
+    uint16_t control;
+    __asm__ volatile("fnstcw %0" : "=m"(control) : : "memory");
+    return (control & 0x0300u) >= 0x0200u &&
+           (control & 0x0C00u) == ((_mm_getcsr() >> 3u) & 0x0C00u);
+#else
+    return false;
+#endif
+}
+
+inline uint8_t vuBinary64Flags(double exact)
+{
+    uint8_t flags = std::signbit(exact) ? 2u : 0u;
+    const double magnitude = std::fabs(exact);
+    if (magnitude == 0.0) flags |= 1u;
+    else if (magnitude > static_cast<double>(std::numeric_limits<float>::max())) flags |= 8u;
+    else if (magnitude < static_cast<double>(std::numeric_limits<float>::min())) flags |= 5u;
+    return flags;
+}
+
+template <typename Real>
+inline bool vuEvaluateFmac(const VU1State &state, uint32_t upper, uint32_t component, Real &result)
+{
+    const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+    const uint8_t special = op >= 0x3Cu
+                                ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu))
+                                : 0xFFu;
+    const uint8_t fs = FS(upper);
+    const uint8_t ft = FT(upper);
+
+    const auto operand = [](float value)
+    {
+        return static_cast<Real>(vuNormalizeScalar(value));
+    };
+    const auto vs = [&](uint32_t lane)
+    {
+        return operand(state.vf[fs][lane]);
+    };
+    const auto vt = [&](uint32_t lane)
+    {
+        return operand(state.vf[ft][lane]);
+    };
+    const auto acc = [&](uint32_t lane)
+    {
+        return operand(state.acc[lane]);
+    };
+
+    if (op < 0x3Cu)
+    {
+        if (op <= 0x03u)
+            result = vs(component) + vt(op & 3u);
+        else if (op <= 0x07u)
+            result = vs(component) - vt(op & 3u);
+        else if (op <= 0x0Bu)
+            result = acc(component) + vs(component) * vt(op & 3u);
+        else if (op <= 0x0Fu)
+            result = acc(component) - vs(component) * vt(op & 3u);
+        else if (op >= 0x18u && op <= 0x1Bu)
+            result = vs(component) * vt(op & 3u);
+        else
+        {
+            switch (op)
+            {
+            case 0x1Cu:
+                result = vs(component) * operand(state.q);
+                break;
+            case 0x1Eu:
+                result = vs(component) * operand(state.i);
+                break;
+            case 0x20u:
+                result = vs(component) + operand(state.q);
+                break;
+            case 0x21u:
+                result = acc(component) + vs(component) * operand(state.q);
+                break;
+            case 0x22u:
+                result = vs(component) + operand(state.i);
+                break;
+            case 0x23u:
+                result = acc(component) + vs(component) * operand(state.i);
+                break;
+            case 0x24u:
+                result = vs(component) - operand(state.q);
+                break;
+            case 0x25u:
+                result = acc(component) - vs(component) * operand(state.q);
+                break;
+            case 0x26u:
+                result = vs(component) - operand(state.i);
+                break;
+            case 0x27u:
+                result = acc(component) - vs(component) * operand(state.i);
+                break;
+            case 0x28u:
+                result = vs(component) + vt(component);
+                break;
+            case 0x29u:
+                result = acc(component) + vs(component) * vt(component);
+                break;
+            case 0x2Au:
+                result = vs(component) * vt(component);
+                break;
+            case 0x2Cu:
+                result = vs(component) - vt(component);
+                break;
+            case 0x2Du:
+                result = acc(component) - vs(component) * vt(component);
+                break;
+            case 0x2Eu:
+            {
+                static constexpr uint8_t left[4] = {1u, 2u, 0u, 3u};
+                static constexpr uint8_t right[4] = {2u, 0u, 1u, 3u};
+                result = component == 3u
+                             ? Real(0)
+                             : acc(component) - vs(left[component]) * vt(right[component]);
+                break;
+            }
+            default:
+                return false;
+            }
+        }
+        return true;
+    }
+
+    if (special <= 0x03u)
+        result = vs(component) + vt(special & 3u);
+    else if (special <= 0x07u)
+        result = vs(component) - vt(special & 3u);
+    else if (special <= 0x0Bu)
+        result = acc(component) + vs(component) * vt(special & 3u);
+    else if (special <= 0x0Fu)
+        result = acc(component) - vs(component) * vt(special & 3u);
+    else if (special >= 0x18u && special <= 0x1Bu)
+        result = vs(component) * vt(special & 3u);
+    else
+    {
+        switch (special)
+        {
+        case 0x1Cu:
+            result = vs(component) * operand(state.q);
+            break;
+        case 0x1Eu:
+            result = vs(component) * operand(state.i);
+            break;
+        case 0x20u:
+            result = vs(component) + operand(state.q);
+            break;
+        case 0x21u:
+            result = acc(component) + vs(component) * operand(state.q);
+            break;
+        case 0x22u:
+            result = vs(component) + operand(state.i);
+            break;
+        case 0x23u:
+            result = acc(component) + vs(component) * operand(state.i);
+            break;
+        case 0x24u:
+            result = vs(component) - operand(state.q);
+            break;
+        case 0x25u:
+            result = acc(component) - vs(component) * operand(state.q);
+            break;
+        case 0x26u:
+            result = vs(component) - operand(state.i);
+            break;
+        case 0x27u:
+            result = acc(component) - vs(component) * operand(state.i);
+            break;
+        case 0x28u:
+            result = vs(component) + vt(component);
+            break;
+        case 0x29u:
+            result = acc(component) + vs(component) * vt(component);
+            break;
+        case 0x2Au:
+            result = vs(component) * vt(component);
+            break;
+        case 0x2Cu:
+            result = vs(component) - vt(component);
+            break;
+        case 0x2Du:
+            result = acc(component) - vs(component) * vt(component);
+            break;
+        case 0x2Eu:
+        {
+            static constexpr uint8_t left[4] = {1u, 2u, 0u, 3u};
+            static constexpr uint8_t right[4] = {2u, 0u, 1u, 3u};
+            result = component == 3u
+                         ? Real(0)
+                         : vs(left[component]) * vt(right[component]);
+            break;
+        }
+        default:
+            return false;
+        }
+    }
+    return true;
+}
+
+// Decode the arithmetic once and normalize each operand vector once, rather
+// than decoding and normalizing the same instruction independently per lane.
+inline bool vuEvaluateFmacVector64(const VU1State& state, uint32_t upper, double result[4])
+{
+    const uint8_t op=upper&0x3fu;
+    const bool special=op>=0x3cu;
+    const uint8_t code=special ? ((upper&3u)|((upper>>4)&0x7cu)) : op;
+    enum Kind { Add, Sub, Madd, Msub, Mul };
+    Kind kind;
+    enum Target { Broadcast, Vector, Q, I, Cross };
+    Target target;
+    if(code<=0x0fu) {
+        kind=static_cast<Kind>(code>>2u);
+        target=Broadcast;
+    } else if(code>=0x18u&&code<=0x1bu) {kind=Mul;target=Broadcast;}
+    else {
+        switch(code) {
+        case 0x1c:kind=Mul;target=Q;break;
+        case 0x1e:kind=Mul;target=I;break;
+        case 0x20:kind=Add;target=Q;break;
+        case 0x21:kind=Madd;target=Q;break;
+        case 0x22:kind=Add;target=I;break;
+        case 0x23:kind=Madd;target=I;break;
+        case 0x24:kind=Sub;target=Q;break;
+        case 0x25:kind=Msub;target=Q;break;
+        case 0x26:kind=Sub;target=I;break;
+        case 0x27:kind=Msub;target=I;break;
+        case 0x28:kind=Add;target=Vector;break;
+        case 0x29:kind=Madd;target=Vector;break;
+        case 0x2a:kind=Mul;target=Vector;break;
+        case 0x2c:kind=Sub;target=Vector;break;
+        case 0x2d:kind=Msub;target=Vector;break;
+        case 0x2e:kind=special ? Mul : Msub;target=Cross;break;
+        default:return false;
+        }
+    }
+    float left[4],right[4],acc[4];
+    vuNormalizeVector(left,state.vf[FS(upper)]);
+    if(target==Broadcast) {
+        const float value=vuNormalizeScalar(state.vf[FT(upper)][code&3u]);
+        for(unsigned c=0;c<4;c++)right[c]=value;
+    } else if(target==Q||target==I) {
+        const float value=vuNormalizeScalar(target==Q?state.q:state.i);
+        for(unsigned c=0;c<4;c++)right[c]=value;
+    } else vuNormalizeVector(right,state.vf[FT(upper)]);
+    if(kind==Madd||kind==Msub)vuNormalizeVector(acc,state.acc);
+    if(target==Cross) {
+        const float left0=left[0],right0=right[0],right1=right[1];
+        left[0]=left[1];left[1]=left[2];left[2]=left0;
+        right[0]=right[2];right[1]=right0;right[2]=right1;
+    }
+    // Keep multiplication and accumulation separately rounded, exactly as in
+    // the scalar binary64 evaluator; no contracted multiply-add is used.
+    for(unsigned c=0;c<4;c++) {
+        const double a=left[c],b=right[c];
+        switch(kind) {
+        case Add:result[c]=a+b;break;
+        case Sub:result[c]=a-b;break;
+        case Madd:result[c]=static_cast<double>(acc[c])+a*b;break;
+        case Msub:result[c]=static_cast<double>(acc[c])-a*b;break;
+        case Mul:result[c]=a*b;break;
+        }
+    }
+    if(target==Cross)result[3]=0.0;
+    return true;
+}
