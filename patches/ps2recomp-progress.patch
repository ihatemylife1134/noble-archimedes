+    // SampleTexture's bilinear blend of four RGBA texels: lerpChannel for all
+    // four channels at once. The same IEEE single-precision operations in the
+    // same order per lane, then std::lround (half away from zero) and clampU8.
+    __attribute__((always_inline)) inline uint32_t bilinearTexel(uint32_t c00, uint32_t c10, uint32_t c01, uint32_t c11,
+                                                                 __m128 fx, __m128 fy)
+    {
+        const __m128i zero = _mm_setzero_si128();
+        auto expand = [&](uint32_t c) __attribute__((always_inline)) {
+            return _mm_cvtepi32_ps(_mm_unpacklo_epi16(_mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c)), zero), zero));
+        };
+        const __m128 f00 = expand(c00);
+        const __m128 f10 = expand(c10);
+        const __m128 f01 = expand(c01);
+        const __m128 f11 = expand(c11);
+        const __m128 top = _mm_add_ps(f00, _mm_mul_ps(_mm_sub_ps(f10, f00), fx));
+        const __m128 bottom = _mm_add_ps(f01, _mm_mul_ps(_mm_sub_ps(f11, f01), fx));
+        const __m128 value = _mm_add_ps(top, _mm_mul_ps(_mm_sub_ps(bottom, top), fy));
+        __m128i rounded = _mm_cvttps_epi32(value);                            // toward zero
+        const __m128 fraction = _mm_sub_ps(value, _mm_cvtepi32_ps(rounded)); // exact
+        rounded = _mm_sub_epi32(rounded, _mm_castps_si128(_mm_cmpge_ps(fraction, _mm_set1_ps(0.5f))));
+        rounded = _mm_add_epi32(rounded, _mm_castps_si128(_mm_cmple_ps(fraction, _mm_set1_ps(-0.5f))));
+        // Signed then unsigned saturation: clampU8 for every lane.
+        const __m128i words = _mm_packs_epi32(rounded, rounded);
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(_mm_packus_epi16(words, words)));
+    }
+
+    // Texture coordinate that SampleTexture derives for a sprite pixel whose
+    // interpolated coordinate is `coord` (texels), per DrawSprite's call.
+    __attribute__((always_inline)) inline float spriteSampleCoordinate(float coord, bool fst, int textureSize)
+    {
+        if (fst)
+        {
+            const int fixed = static_cast<int>((coord * 16.0f) + 0.5f);
+            const uint16_t sample = static_cast<uint16_t>(clampInt(fixed, 0, 0xFFFF));
+            return static_cast<float>(sample) / 16.0f;
+        }
+        const float normalized = coord / static_cast<float>(textureSize);
+        const float invQ = 1.0f / fabsQ(1.0f);
+        return normalized * invQ * static_cast<float>(textureSize);
+    }
