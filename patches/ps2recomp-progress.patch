diff --git a/ps2xRuntime/include/runtime/gs/ps2_gs_memory.h b/ps2xRuntime/include/runtime/gs/ps2_gs_memory.h
index c784ff7..fd8dc9e 100644
--- a/ps2xRuntime/include/runtime/gs/ps2_gs_memory.h
+++ b/ps2xRuntime/include/runtime/gs/ps2_gs_memory.h
@@ -542,0 +543,157 @@ namespace GSMem
+	// Page lookup tables filled by InitLookupTables(). Exposed so the inline
+	// accessors below can be inlined into rasterizer loops.
+	extern PixelStorageTraits<C32>::PageLookupTableT PageTableC32;
+	extern PixelStorageTraits<Z32>::PageLookupTableT PageTableZ32;
+	extern PixelStorageTraits<C16>::PageLookupTableT PageTableC16;
+	extern PixelStorageTraits<C16S>::PageLookupTableT PageTableC16S;
+	extern PixelStorageTraits<Z16>::PageLookupTableT PageTableZ16;
+	extern PixelStorageTraits<Z16S>::PageLookupTableT PageTableZ16S;
+	extern PixelStorageTraits<P8>::PageLookupTableT PageTableP8;
+	extern PixelStorageTraits<P4>::PageLookupTableT PageTableP4;
+
+	// Inline equivalents of the ReadXX/WriteXX/ReadTexture entry points, with
+	// the same PSM mapping (unknown formats read 0 and ignore writes).
+	inline u32 ReadInline(u32 psm, const u8* data, u32 bp, u32 bw, u32 x, u32 y, TexturePageCache* cache = nullptr)
+	{
+		switch (psm & 0x3Fu)
+		{
+		case 0x00: return PixelStorageTraits<C32>::Read(PageTableC32, data, bp, bw, x, y, cache);
+		case 0x01: return PixelStorageTraits<C24>::Read(PageTableC32, data, bp, bw, x, y, cache);
+		case 0x02: return PixelStorageTraits<C16>::Read(PageTableC16, data, bp, bw, x, y, cache);
+		case 0x0A: return PixelStorageTraits<C16S>::Read(PageTableC16S, data, bp, bw, x, y, cache);
+		case 0x13: return PixelStorageTraits<P8>::Read(PageTableP8, data, bp, bw, x, y, cache);
+		case 0x14: return PixelStorageTraits<P4>::Read(PageTableP4, data, bp, bw, x, y, cache);
+		case 0x1B: return PixelStorageTraits<P8H>::Read(PageTableC32, data, bp, bw, x, y, cache);
+		case 0x24: return PixelStorageTraits<P4HL>::Read(PageTableC32, data, bp, bw, x, y, cache);
+		case 0x2C: return PixelStorageTraits<P4HH>::Read(PageTableC32, data, bp, bw, x, y, cache);
+		case 0x30: return PixelStorageTraits<Z32>::Read(PageTableZ32, data, bp, bw, x, y, cache);
+		case 0x31: return PixelStorageTraits<Z24>::Read(PageTableZ32, data, bp, bw, x, y, cache);
+		case 0x32: return PixelStorageTraits<Z16>::Read(PageTableZ16, data, bp, bw, x, y, cache);
+		case 0x3A: return PixelStorageTraits<Z16S>::Read(PageTableZ16S, data, bp, bw, x, y, cache);
+		default: return 0u;
+		}
+	}
+
+	inline void WriteInline(u32 psm, u8* data, u32 bp, u32 bw, u32 x, u32 y, u32 value)
+	{
+		switch (psm & 0x3Fu)
+		{
+		case 0x00: PixelStorageTraits<C32>::Write(PageTableC32, data, bp, bw, x, y, value); break;
+		case 0x01: PixelStorageTraits<C24>::Write(PageTableC32, data, bp, bw, x, y, value); break;
+		case 0x02: PixelStorageTraits<C16>::Write(PageTableC16, data, bp, bw, x, y, static_cast<u16>(value)); break;
+		case 0x0A: PixelStorageTraits<C16S>::Write(PageTableC16S, data, bp, bw, x, y, static_cast<u16>(value)); break;
+		case 0x13: PixelStorageTraits<P8>::Write(PageTableP8, data, bp, bw, x, y, static_cast<u8>(value)); break;
+		case 0x14: PixelStorageTraits<P4>::Write(PageTableP4, data, bp, bw, x, y, static_cast<u8>(value)); break;
+		case 0x1B: PixelStorageTraits<P8H>::Write(PageTableC32, data, bp, bw, x, y, static_cast<u8>(value)); break;
+		case 0x24: PixelStorageTraits<P4HL>::Write(PageTableC32, data, bp, bw, x, y, static_cast<u8>(value)); break;
+		case 0x2C: PixelStorageTraits<P4HH>::Write(PageTableC32, data, bp, bw, x, y, static_cast<u8>(value)); break;
+		case 0x30: PixelStorageTraits<Z32>::Write(PageTableZ32, data, bp, bw, x, y, value); break;
+		case 0x31: PixelStorageTraits<Z24>::Write(PageTableZ32, data, bp, bw, x, y, value); break;
+		case 0x32: PixelStorageTraits<Z16>::Write(PageTableZ16, data, bp, bw, x, y, static_cast<u16>(value)); break;
+		case 0x3A: PixelStorageTraits<Z16S>::Write(PageTableZ16S, data, bp, bw, x, y, static_cast<u16>(value)); break;
+		default: break;
+		}
+	}
+
+	// PixelStorageTraits<psm>::Read/Write for pixels of one row (fixed block,
+	// bw and y): the page row and the lookup table row are computed once, the
+	// per-pixel part is identical to Address() and the Read/Write tails.
+	template<PixelStorageMode psm>
+	struct RowAccess
+	{
+		using Traits = PixelStorageTraits<psm>;
+		using PackedT = typename Traits::PackedT;
+		static constexpr Extent2D kPage = Traits::PageExtent();
+
+		u32 pageBase = 0;
+		const u16* tableRow = nullptr;
+
+		RowAccess() = default;
+		RowAccess(const typename Traits::PageLookupTableT& table, u32 block, u32 bw, u32 y)
+		{
+			pageBase = static_cast<u32>(Traits::PageId(block, bw, 0u, y));
+			tableRow = table[block % Traits::BlocksPerPage()][y % kPage.y].data();
+		}
+
+		u32 Address(u32 x) const
+		{
+			return (pageBase + x / kPage.x) * static_cast<u32>(Traits::PixelsPerPage()) + tableRow[x % kPage.x];
+		}
+
+		// The byte address Read/Write access for pixel x.
+		u32 ByteAddress(u32 x) const
+		{
+			const u32 bits = Address(x) * UnpackedBitWidth(psm) + static_cast<u32>(Traits::BitOffset());
+			return (bits / 8) & (MEMORY_SIZE - sizeof(PackedT));
+		}
+
+		PackedT Read(const u8* data, u32 x, TexturePageCache* cache = nullptr) const
+		{
+			const u32 bits = Address(x) * UnpackedBitWidth(psm) + static_cast<u32>(Traits::BitOffset());
+			const u32 byte_addr = (bits / 8) & (MEMORY_SIZE - sizeof(PackedT));
+			const u32 shift = bits % 8;
+			const u8* source = cache ? cache->Resolve(data, byte_addr) : data + byte_addr;
+			PackedT v;
+			std::memcpy(&v, source, sizeof(PackedT));
+			if constexpr (psm == C24 || psm == Z24)
+				return v & 0x00FFFFFF;
+			else if constexpr (psm == P4 || psm == P4HL || psm == P4HH)
+				return (v >> shift) & 0x0F;
+			else
+				return v;
+		}
+
+		void Write(u8* data, u32 x, PackedT value) const
+		{
+			const u32 bits = Address(x) * UnpackedBitWidth(psm) + static_cast<u32>(Traits::BitOffset());
+			const u32 byte_addr = (bits / 8) & (MEMORY_SIZE - sizeof(PackedT));
+			const u32 shift = bits % 8;
+			u8* ptr = &data[byte_addr];
+			if constexpr (psm == C24 || psm == Z24)
+			{
+				PackedT old;
+				std::memcpy(&old, ptr, sizeof(PackedT));
+				value = (old & 0xFF000000) | (value & 0x00FFFFFF);
+			}
+			else if constexpr (psm == P4 || psm == P4HL || psm == P4HH)
+			{
+				PackedT old;
+				std::memcpy(&old, ptr, sizeof(PackedT));
+				value = (old & ~(0x0F << shift)) | ((value & 0x0F) << shift);
+			}
+			std::memcpy(ptr, &value, sizeof(PackedT));
+		}
+	};
+
+	// Page lookup table that ReadInline/WriteInline use for a PSM value.
+	template<u32 kPsm>
+	inline const auto& PageTableFor()
+	{
+		if constexpr (kPsm == 0x00 || kPsm == 0x01 || kPsm == 0x1B || kPsm == 0x24 || kPsm == 0x2C)
+			return PageTableC32;
+		else if constexpr (kPsm == 0x02)
+			return PageTableC16;
+		else if constexpr (kPsm == 0x0A)
+			return PageTableC16S;
+		else if constexpr (kPsm == 0x13)
+			return PageTableP8;
+		else if constexpr (kPsm == 0x14)
+			return PageTableP4;
+		else if constexpr (kPsm == 0x30 || kPsm == 0x31)
+			return PageTableZ32;
+		else if constexpr (kPsm == 0x32)
+			return PageTableZ16;
+		else
+		{
+			static_assert(kPsm == 0x3A, "PSM without a ReadInline mapping");
+			return PageTableZ16S;
+		}
+	}
+
+	// RowAccess for a PSM value, with ReadInline's table choice.
+	template<u32 kPsm>
+	inline RowAccess<static_cast<PixelStorageMode>(kPsm)> MakeRowAccess(u32 block, u32 bw, u32 y)
+	{
+		return RowAccess<static_cast<PixelStorageMode>(kPsm)>(PageTableFor<kPsm>(), block, bw, y);
+	}
+
