+    for (int priority : {2, 40, 32})
+    {
+        EeThreadCreateParams params{};
+        params.entry = kWorkerPc + static_cast<uint32_t>(priority == 2 ? 0 : priority == 40 ? 4 : 8);
+        params.priority = priority;
