+++ b/ps2xRuntime/cmake/ParallelGs.cmake
@@ -0,0 +1,19 @@
+function(ps2x_add_parallel_gs)
+    if(TARGET parallel-gs)
+        return()
+    endif()
+    set(PS2X_PGS_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/parallel-gs"
+        CACHE PATH "Standalone paraLLEl-GS checkout")
+    if(NOT EXISTS "${PS2X_PGS_DIR}/Granite/third_party/volk/volk.c" OR
+       NOT EXISTS "${PS2X_PGS_DIR}/Granite/third_party/khronos/vulkan-headers/include/vulkan/vulkan.h")
+        message(FATAL_ERROR "paraLLEl-GS dependencies are incomplete; run scripts/fetch_parallel_gs.py")
+    endif()
+    set(PARALLEL_GS_STANDALONE ON CACHE BOOL "" FORCE)
+    set(GRANITE_TOOLS OFF CACHE BOOL "" FORCE)
+    set(GRANITE_VULKAN_DXGI_INTEROP OFF CACHE BOOL "" FORCE)
+    set(GRANITE_RENDERDOC_CAPTURE OFF CACHE BOOL "" FORCE)
+    add_subdirectory("${PS2X_PGS_DIR}" "${CMAKE_BINARY_DIR}/parallel-gs" EXCLUDE_FROM_ALL)
+    # The generated game linker also needs the transitive static archives.
+    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/pgs_link_inputs.txt" CONTENT
+        "$<TARGET_FILE:parallel-gs>\n$<TARGET_FILE:granite-vulkan>\n$<TARGET_FILE:granite-math>\n$<TARGET_FILE:granite-util>\n$<TARGET_FILE:granite-volk>\n")
+endfunction()
diff --git a/ps2xRuntime/include/runtime/ee_dispatch_policy.h b/ps2xRuntime/include/runtime/ee_dispatch_policy.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ee_dispatch_policy.h
@@ -0,0 +1,34 @@
+#pragma once
+
+enum class EeDispatchChoice
+{
+    Idle,
+    Invocation,
+    Ready,
+};
+
+class EeDispatchPolicy
+{
+public:
+    EeDispatchChoice choose(bool hasPendingInvocation, bool hasReadyThread)
+    {
+        if (hasPendingInvocation && hasReadyThread)
+        {
+            const EeDispatchChoice choice = m_readyNext
+                                                ? EeDispatchChoice::Ready
+                                                : EeDispatchChoice::Invocation;
+            m_readyNext = !m_readyNext;
+            return choice;
+        }
+        if (hasPendingInvocation)
+        {
+            return EeDispatchChoice::Invocation;
+        }
+        return hasReadyThread ? EeDispatchChoice::Ready : EeDispatchChoice::Idle;
+    }
+
+    void reset() { m_readyNext = false; }
+
+private:
+    bool m_readyNext = false;
+};
diff --git a/ps2xRuntime/include/runtime/host_profile.h b/ps2xRuntime/include/runtime/host_profile.h
new file mode 100644
