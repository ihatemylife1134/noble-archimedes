+        {
+            const int fixed = static_cast<int>((coord * 16.0f) + 0.5f);
+            const uint16_t sample = static_cast<uint16_t>(clampInt(fixed, 0, 0xFFFF));
+            return static_cast<float>(sample) / 16.0f;
+        }
+        const float normalized = coord / static_cast<float>(textureSize);
+        const float invQ = 1.0f / fabsQ(1.0f);
+        return normalized * invQ * static_cast<float>(textureSize);
+    }
+
+    struct SpriteColumn
+    {
+        int u0;
+        int u1;
+        float fx;
+    };
+
+    // Scissor coordinates are 11-bit, so a clipped sprite row has at most
+    // 2048 pixels; the column table lives on the stack.
+    constexpr int kMaxSpriteColumns = 2048;
+}
+
+struct GSCpuBackend::PixelRowSetup
+{
+    PixelWriteMask masks[256];
+};
+
+// Row writer for WritePixel semantics: frame and Z addressing hoisted per row,
+// draw state held in locals (VRAM stores may alias any heap object).
+template <uint32_t kFramePsm, uint32_t kZPsm>
+void GSCpuBackend::WritePixelRow(const GSDrawState &state, const PixelRowSetup &pipe, int y, int x0, int x1,
+                                 const uint32_t *colors, uint32_t z, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    if (y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return;
+    const int scissorX0 = ctx.scissor.x0;
+    const int scissorX1 = ctx.scissor.x1;
+    static const bool s_disableFog = (std::getenv("PS2_GS_DISABLE_FOG") != nullptr);
+    const bool fogEnabled = state.prim.fge && !s_disableFog;
+    const uint8_t fogR = state.fogR, fogG = state.fogG, fogB = state.fogB;
+    const u32 fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const u32 fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    const u32 zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const uint64_t testReg = ctx.test;
+    const bool zte = ((testReg >> 16) & 1u) != 0u;
+    const uint32_t ztestMethod = zte ? static_cast<uint32_t>((testReg >> 17) & 3u) : 1u;
+    const bool alphaBlendEnabled = state.prim.abe;
+    const bool destinationAlphaTestNeedsRead = ((testReg >> 14) & 0x1u) != 0u &&
+        (kFramePsm == GS_PSM_CT32 || kFramePsm == GS_PSM_CT16 || kFramePsm == GS_PSM_CT16S);
+    const u32 fbmsk = ctx.frame.fbmsk;
+    const bool pabe = state.pabe;
+    const uint64_t alphaReg = ctx.alpha;
+    const uint8_t asel = alphaReg & 3;
+    const uint8_t bsel = (alphaReg >> 2) & 3;
+    const uint8_t csel = (alphaReg >> 4) & 3;
+    const uint8_t dsel = (alphaReg >> 6) & 3;
+    const uint8_t fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+    const bool forceAlphaMsb = (ctx.fba & 0x1ull) != 0ull && kFramePsm != GS_PSM_CT24;
+    const bool zmask = ctx.zbuf.zmask;
+    constexpr bool kFrame16 = kFramePsm == GS_PSM_CT16 || kFramePsm == GS_PSM_CT16S;
+    uint8_t *const vram = m_vram;
+    const auto frameRow = GSMem::MakeRowAccess<kFramePsm>(fbp, fbw, static_cast<u32>(y));
+    const auto depthRow = GSMem::MakeRowAccess<kZPsm>(zbp, fbw, static_cast<u32>(y));
+    using FramePacked = typename decltype(frameRow)::PackedT;
+    using DepthPacked = typename decltype(depthRow)::PackedT;
+
+    // Clears and opaque UI rows need neither destination reads nor per-pixel
+    // test/blend dispatch. Keep the full writer for every other GS state.
+    const bool alphaAlwaysPasses = (testReg & 1u) == 0u || ((testReg >> 1) & 7u) == 1u;
+    if (alphaAlwaysPasses && !destinationAlphaTestNeedsRead && ztestMethod == 1u &&
+        !fogEnabled && !alphaBlendEnabled && fbmsk == 0u)
+    {
+        const int first = std::max(x0, scissorX0);
+        const int last = std::min(x1, scissorX1);
+        for (int x = first; x <= last; ++x)
+        {
+            uint32_t pixel = colors[x - x0];
+            if (forceAlphaMsb)
+                pixel |= 0x80000000u;
+            if constexpr (kFrame16)
+                pixel = Rgba8888ToRgba5551(pixel);
+            frameRow.Write(vram, static_cast<u32>(x), static_cast<FramePacked>(pixel));
+            if (!zmask)
+                depthRow.Write(vram, static_cast<u32>(x), static_cast<DepthPacked>(z));
+        }
+        return;
+    }
+
+    for (int x = x0; x <= x1; ++x)
+    {
+        if (x < scissorX0 || x > scissorX1)
+            continue;
+        const uint32_t color = colors[x - x0];
+        uint8_t r = static_cast<uint8_t>(color & 0xFFu);
+        uint8_t g = static_cast<uint8_t>((color >> 8) & 0xFFu);
+        uint8_t b = static_cast<uint8_t>((color >> 16) & 0xFFu);
+        uint8_t a = static_cast<uint8_t>(color >> 24);
+
+        if (fogEnabled)
+        {
+            const uint32_t inverseFog = 255u - fog;
+            auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+            {
+                return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+            };
+            r = applyFog(r, fogR);
+            g = applyFog(g, fogG);
+            b = applyFog(b, fogB);
+        }
+
+        const PixelWriteMask writeMask = pipe.masks[a];
+        if (!writeMask.writesAnything())
+            continue;
+
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && kFramePsm == GS_PSM_CT32;
+        const bool blendNeedsDestination = alphaBlendEnabled &&
+            (asel == 1u || bsel == 1u || csel == 1u || dsel == 1u);
+        const bool frmw = destinationAlphaTestNeedsRead ||
+                          (writeMask.writesFramebuffer() && ((fbmsk != 0) || blendNeedsDestination || preserveDestinationAlpha));
+
+        u32 rawFramebufferPixel = 0;
+        u32 fbrgba = 0;
+        if (frmw)
+        {
+            rawFramebufferPixel = frameRow.Read(vram, static_cast<u32>(x));
+            fbrgba = rawFramebufferPixel;
+            if constexpr (kFrame16)
+                fbrgba = Rgba5551ToRgba8888(static_cast<u16>(fbrgba));
+            else if constexpr (kFramePsm == GS_PSM_CT24)
+                fbrgba |= 0x80000000u;
+        }
+
+        if (!passesDestinationAlphaTest(testReg, static_cast<uint8_t>(kFramePsm), rawFramebufferPixel))
+            continue;
+
+        bool zpass = false;
+        switch (ztestMethod)
+        {
+        case 0:
+            zpass = false;
+            break;
+        case 1:
+            zpass = true;
+            break;
+        case 2:
+            zpass = z >= static_cast<uint32_t>(depthRow.Read(vram, static_cast<u32>(x)));
+            break;
+        case 3:
+            zpass = z > static_cast<uint32_t>(depthRow.Read(vram, static_cast<u32>(x)));
+            break;
+        }
+        if (!zpass)
+            continue;
+
+        if (writeMask.writesFramebuffer())
+        {
+            if (alphaBlendEnabled)
+            {
+                const uint8_t dr = fbrgba & 0xFF;
+                const uint8_t dg = (fbrgba >> 8) & 0xFF;
+                const uint8_t db = (fbrgba >> 16) & 0xFF;
+                const uint8_t da = (fbrgba >> 24) & 0xFF;
+                if (!(pabe && (a & 0x80u) == 0u))
+                {
+                    auto pickRGB = [&](uint8_t sel, int cs, int cd) -> int
+                    {
+                        if (sel == 0)
+                            return cs;
+                        if (sel == 1)
+                            return cd;
+                        return 0;
+                    };
+                    const int cAlpha = (csel == 0) ? a : (csel == 1) ? da : fix;
+                    r = clampU8(((pickRGB(asel, r, dr) - pickRGB(bsel, r, dr)) * cAlpha >> 7) + pickRGB(dsel, r, dr));
+                    g = clampU8(((pickRGB(asel, g, dg) - pickRGB(bsel, g, dg)) * cAlpha >> 7) + pickRGB(dsel, g, dg));
+                    b = clampU8(((pickRGB(asel, b, db) - pickRGB(bsel, b, db)) * cAlpha >> 7) + pickRGB(dsel, b, db));
+                }
+            }
+
+            if (writeMask.writeAlpha && forceAlphaMsb)
+                a = static_cast<uint8_t>(a | 0x80u);
+
+            u32 pixel = pack32(r, g, b, a);
+            if (fbmsk != 0)
+                pixel = (pixel & ~fbmsk) | (fbrgba & fbmsk);
+            if (preserveDestinationAlpha)
+                pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+            if constexpr (kFrame16)
+                pixel = Rgba8888ToRgba5551(pixel);
+            frameRow.Write(vram, static_cast<u32>(x), static_cast<FramePacked>(pixel));
+        }
+
+        if (writeMask.writeDepth && !zmask)
+            depthRow.Write(vram, static_cast<u32>(x), static_cast<DepthPacked>(z));
+    }
+}
+
+GSCpuBackend::RowWriter GSCpuBackend::SelectRowWriter(uint8_t framePsm, uint8_t depthPsm, bool depthUsed)
+{
+    // Unused Z needs no Z format; its accessor is never touched.
+    if (!depthUsed)
+        depthPsm = GS_PSM_Z32;
+#define PS2_ROW_WRITER_Z(frame)                                                         \
+    switch (depthPsm)                                                                   \
+    {                                                                                   \
+    case GS_PSM_Z32: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z32>;           \
+    case GS_PSM_Z24: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z24>;           \
+    case GS_PSM_Z16: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z16>;           \
+    case GS_PSM_Z16S: return &GSCpuBackend::WritePixelRow<frame, GS_PSM_Z16S>;         \
+    default: return nullptr;                                                            \
+    }
+    switch (framePsm)
+    {
+    case GS_PSM_CT32: PS2_ROW_WRITER_Z(GS_PSM_CT32)
+    case GS_PSM_CT24: PS2_ROW_WRITER_Z(GS_PSM_CT24)
+    case GS_PSM_CT16: PS2_ROW_WRITER_Z(GS_PSM_CT16)
+    case GS_PSM_CT16S: PS2_ROW_WRITER_Z(GS_PSM_CT16S)
+    default:
+        return nullptr;
+    }
+#undef PS2_ROW_WRITER_Z
+}
+
+void GSCpuBackend::InitPixelRowSetup(PixelRowSetup &pipe, const GSDrawState &state)
+{
+    for (uint32_t alpha = 0; alpha < 256u; ++alpha)
+        pipe.masks[alpha] = classifyAlphaTest(state.context.test, static_cast<uint8_t>(alpha), state.context.frame.psm);
+}
+
+bool GSCpuBackend::DrawSpriteTexturedFast(const RasterContext &rc, const GSDrawState &state, const SpriteSetup &setup)
+{
+    const auto &ctx = state.context;
+    const uint8_t psm = ctx.tex0.psm;
+    const bool linear = state.linearFilter;
+    if (setup.drawX1 - setup.drawX0 + 1 > kMaxSpriteColumns)
+        return false;
+
+    // Rows are textured before they are written. That matches the per-pixel
+    // order only while the draw cannot sample the pages it writes.
+    const bool zte = ((ctx.test >> 16) & 1u) != 0u;
+    const uint32_t ztestMethod = zte ? static_cast<uint32_t>((ctx.test >> 17) & 3u) : 1u;
+    const bool depthUsed = (zte && ztestMethod >= 2u) || !ctx.zbuf.zmask;
+    RowWriter writer = SelectRowWriter(ctx.frame.psm, ctx.zbuf.psm, depthUsed);
+    bool directTexture = false;
+    if (writer)
+    {
+        PageBits written;
+        const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+        markPages(written, ctx.frame.fbp, false, fbw, ctx.frame.psm, setup.drawX0, setup.drawX1, setup.drawY0, setup.drawY1);
+        if (depthUsed)
+            markPages(written, ctx.zbuf.zbp, false, fbw, ctx.zbuf.psm, setup.drawX0, setup.drawX1, setup.drawY0, setup.drawY1);
+        const uint64_t clamp = ctx.clamp;
+        const int maxU = (clamp & 0x2u) != 0u ? 1023 : std::max<int>(state.textureWidth, 1) - 1;
+        const int maxV = (clamp & 0x8u) != 0u ? 1023 : std::max<int>(state.textureHeight, 1) - 1;
+        PageBits sampled;
+        markPages(sampled, ctx.tex0.tbp0 >> 5u, (ctx.tex0.tbp0 & 31u) != 0u, ctx.tex0.tbw, ctx.tex0.psm, 0, maxU, 0, maxV);
+        if ((written & sampled).any())
+        {
+            writer = nullptr;
+        }
+        else if (m_vram && rc.cache)
+        {
+            // Nothing writes the sampled pages during this draw: this one does
+            // not, and the threaded scheduler orders every other writer
+            // around it. Reads through the cache then return local memory,
+            // unless the page it holds from earlier is sampled and stale.
+            const uint32_t cachedPage = rc.cache->PageBase();
+            directTexture = cachedPage == UINT32_MAX ||
+                            !sampled.test((cachedPage / GSMem::TexturePageCache::kPageSize) & 511u) ||
+                            rc.cache->MatchesMemory(m_vram);
+        }
+    }
+
+#define PS2_SPRITE_CASE(value)                                                  \
+    case value:                                                                 \
+        if (linear)                                                             \
+            DrawSpriteTexturedRows<value, true>(rc, state, setup, writer, directTexture); \
+        else                                                                    \
+            DrawSpriteTexturedRows<value, false>(rc, state, setup, writer, directTexture); \
+        return true;
+    switch (psm)
+    {
+        PS2_SPRITE_CASE(GS_PSM_CT32)
+        PS2_SPRITE_CASE(GS_PSM_CT24)
+        PS2_SPRITE_CASE(GS_PSM_CT16)
+        PS2_SPRITE_CASE(GS_PSM_CT16S)
+        PS2_SPRITE_CASE(GS_PSM_T8)
+        PS2_SPRITE_CASE(GS_PSM_T4)
+        PS2_SPRITE_CASE(GS_PSM_T8H)
+        PS2_SPRITE_CASE(GS_PSM_T4HL)
+        PS2_SPRITE_CASE(GS_PSM_T4HH)
+        PS2_SPRITE_CASE(GS_PSM_Z32)
+        PS2_SPRITE_CASE(GS_PSM_Z24)
+        PS2_SPRITE_CASE(GS_PSM_Z16)
+        PS2_SPRITE_CASE(GS_PSM_Z16S)
+    default:
+        return false;
+    }
+#undef PS2_SPRITE_CASE
+}
+
+template <uint32_t kTexPsm, bool kLinear>
+void GSCpuBackend::DrawSpriteTexturedRows(const RasterContext &rc, const GSDrawState &state, const SpriteSetup &setup,
+                                          RowWriter writer, bool directTexture)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    const bool fst = state.prim.fst;
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    const uint8_t wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    const uint16_t maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    const uint16_t maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+
+    bool anyRow = false;
+    for (int y = setup.drawY0; y <= setup.drawY1 && !anyRow; ++y)
+        anyRow = rc.ownsRow(y);
+    if (!anyRow || !m_vram)
+        return;
+
+    constexpr bool kIndexed = kTexPsm == GS_PSM_T8 || kTexPsm == GS_PSM_T4 || kTexPsm == GS_PSM_T8H ||
+                              kTexPsm == GS_PSM_T4HL || kTexPsm == GS_PSM_T4HH;
+    constexpr uint32_t kPaletteSize = (kTexPsm == GS_PSM_T8 || kTexPsm == GS_PSM_T8H) ? 256u : 16u;
+    uint32_t palette[kIndexed ? kPaletteSize : 1u];
+    if constexpr (kIndexed)
+    {
+        for (uint32_t i = 0; i < kPaletteSize; ++i)
+            palette[i] = LookupCLUT(*rc.clut, state, static_cast<u8>(i), tex.cpsm, tex.csm, tex.csa, tex.psm);
+    }
+    const GSTexaReg texa = state.texa;
+    const uint8_t texPsm = tex.psm;
+    const u32 tbp0 = tex.tbp0;
+    const u32 tbw = tex.tbw;
+    const uint8_t *const vram = m_vram;
+    GSMem::TexturePageCache *const cache = rc.cache;
+    // directTexture: every texel read through the cache would return what
+    // local memory holds (see DrawSpriteTexturedFast), so read it directly and
+    // leave the cache as the last miss would have.
+    GSMem::TexturePageCache *const readCache = directTexture ? nullptr : cache;
+    u32 lastTexelAddress = 0u;
+    bool readTexel = false;
+
+    // SampleTexture's samplePoint decode for a raw texel.
+    auto decode = [&](u32 raw) __attribute__((always_inline)) -> uint32_t
+    {
+        if constexpr (kTexPsm == GS_PSM_CT32 || kTexPsm == GS_PSM_Z32 || kTexPsm == GS_PSM_CT24 || kTexPsm == GS_PSM_Z24)
+            return applyTexa(texa, texPsm, raw);
+        else if constexpr (kTexPsm == GS_PSM_CT16 || kTexPsm == GS_PSM_CT16S || kTexPsm == GS_PSM_Z16 || kTexPsm == GS_PSM_Z16S)
+            return applyTexa(texa, texPsm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+        else
+            return palette[static_cast<u8>(raw) & (kPaletteSize - 1u)];
+    };
+
+    SpriteColumn columns[kMaxSpriteColumns];
+    for (int x = setup.drawX0; x <= setup.drawX1; ++x)
+    {
+        const float tx = (static_cast<float>(x - setup.unclippedX0) + 0.5f) / setup.spriteW;
+        const float texUf = setup.u0f + (setup.u1f - setup.u0f) * tx;
+        const float coord = spriteSampleCoordinate(texUf, fst, texW);
+        SpriteColumn &column = columns[x - setup.drawX0];
+        if constexpr (kLinear)
+        {
+            const float sample = coord - 0.5f;
+            const int u0 = static_cast<int>(std::floor(sample));
+            column.fx = sample - static_cast<float>(u0);
+            column.u0 = wrapTextureCoordinate(u0, texW, wrapU, minU, maxU);
+            column.u1 = wrapTextureCoordinate(u0 + 1, texW, wrapU, minU, maxU);
+        }
+        else
+        {
+            column.u0 = wrapTextureCoordinate(static_cast<int>(coord), texW, wrapU, minU, maxU);
+            column.u1 = column.u0;
+            column.fx = 0.0f;
+        }
+    }
+
+    PixelRowSetup pipe;
+    if (writer)
+        InitPixelRowSetup(pipe, state);
+    uint32_t colors[kMaxSpriteColumns];
+    const uint8_t vr = setup.r, vg = setup.g, vb = setup.b, va = setup.a;
+
+    for (int y = setup.drawY0; y <= setup.drawY1; ++y)
+    {
+        if (!rc.ownsRow(y))
+            continue;
+        const float ty = (static_cast<float>(y - setup.unclippedY0) + 0.5f) / setup.spriteH;
+        const float texVf = setup.v0f + (setup.v1f - setup.v0f) * ty;
+        const float coordV = spriteSampleCoordinate(texVf, fst, texH);
+        int v0 = 0, v1 = 0;
+        float fy = 0.0f;
+        if constexpr (kLinear)
+        {
+            const float sample = coordV - 0.5f;
+            const int iv = static_cast<int>(std::floor(sample));
+            fy = sample - static_cast<float>(iv);
+            v0 = wrapTextureCoordinate(iv, texH, wrapV, minV, maxV);
+            v1 = wrapTextureCoordinate(iv + 1, texH, wrapV, minV, maxV);
+        }
+        else
+        {
+            v0 = wrapTextureCoordinate(static_cast<int>(coordV), texH, wrapV, minV, maxV);
+        }
+        const auto row0 = GSMem::MakeRowAccess<kTexPsm>(tbp0, tbw, static_cast<u32>(v0));
+        const auto row1 = GSMem::MakeRowAccess<kTexPsm>(tbp0, tbw, static_cast<u32>(v1));
+        const __m128 fyv = _mm_set1_ps(fy);
+        if (directTexture)
+        {
+            // The last texel this row reads (the cache's page after a miss).
+            const SpriteColumn &last = columns[setup.drawX1 - setup.drawX0];
+            lastTexelAddress = kLinear ? row1.ByteAddress(static_cast<u32>(last.u1))
+                                       : row0.ByteAddress(static_cast<u32>(last.u0));
+            readTexel = true;
+        }
+
+        for (int x = setup.drawX0; x <= setup.drawX1; ++x)
+        {
+            const SpriteColumn &column = columns[x - setup.drawX0];
+            uint32_t texel;
+            if constexpr (kLinear)
+            {
+                const uint32_t c00 = decode(row0.Read(vram, static_cast<u32>(column.u0), readCache));
+                // At an exact texel center the other three samples have zero
+                // weight. Only elide their reads when the cache is equivalent
+                // to VRAM; the final cache-page update above stays unchanged.
+                if (directTexture && column.fx == 0.0f && fy == 0.0f)
+                    texel = c00;
+                else
+                {
+                    const uint32_t c10 = decode(row0.Read(vram, static_cast<u32>(column.u1), readCache));
+                    const uint32_t c01 = decode(row1.Read(vram, static_cast<u32>(column.u0), readCache));
+                    const uint32_t c11 = decode(row1.Read(vram, static_cast<u32>(column.u1), readCache));
+                    texel = bilinearTexel(c00, c10, c01, c11, _mm_set1_ps(column.fx), fyv);
+                }
+            }
+            else
+            {
+                texel = decode(row0.Read(vram, static_cast<u32>(column.u0), readCache));
+            }
+
+            const TextureCombineResult color = combineTexture(tex, vr, vg, vb, va,
+                                                              static_cast<uint8_t>(texel & 0xFFu),
+                                                              static_cast<uint8_t>((texel >> 8) & 0xFFu),
+                                                              static_cast<uint8_t>((texel >> 16) & 0xFFu),
+                                                              static_cast<uint8_t>(texel >> 24));
+            if (writer)
+                colors[x - setup.drawX0] = pack32(color.r, color.g, color.b, color.a);
+            else
+                WritePixel(state, x, y, static_cast<int>(setup.z), color.r, color.g, color.b, color.a, setup.fog);
+        }
+        if (writer)
+            (this->*writer)(state, pipe, y, setup.drawX0, setup.drawX1, colors, setup.z, setup.fog);
+    }
+    if (readTexel)
+        cache->Load(vram, lastTexelAddress);
+}
+
+void GSCpuBackend::DrawSprite(const RasterContext &rc, const GSPrimitiveBatch &batch)
+{
+    const uint32_t curFrame = s_presentFrameCount.load(std::memory_order_relaxed);
+    static int s_loggedSpriteCount = 0;
+    if (curFrame >= 1670 && curFrame <= 1740 && s_loggedSpriteCount < 50)
+    {
