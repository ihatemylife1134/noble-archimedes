+void GSCpuBackend::EnqueueUnlocked(Command &&command)
+{
+    const uint64_t head = m_head.load(std::memory_order_relaxed);
+    const uint32_t count = static_cast<uint32_t>(m_workerConfig);
+    auto slowest = [&]()
+    {
+        uint64_t value = UINT64_MAX;
+        for (uint32_t i = 0; i < count; ++i)
+            value = std::min(value, m_workerProgress[i].load(std::memory_order_acquire));
+        return value;
+    };
+    if (head - slowest() >= kRingSize)
+    {
+        HostProfile::Scope profileScope(HostProfile::GsRingWait);
+        waitUntil(m_signalMutex, m_signalCv, m_sleepers, [&]() { return head - slowest() < kRingSize; });
+    }
+    {
+        static constexpr HostProfile::Slot kSlots[] = {HostProfile::GsCmdDraw, HostProfile::GsCmdDrawAll,
+                                                       HostProfile::GsCmdBarrier, HostProfile::GsCmdUpload,
+                                                       HostProfile::GsCmdClut, HostProfile::GsCmdFlush,
+                                                       HostProfile::GsCmdPresent};
+        HostProfile::g_calls[kSlots[static_cast<size_t>(command.kind)]].fetch_add(1u, std::memory_order_relaxed);
+    }
+    const bool exclusive = command.kind == Command::Kind::DrawAll || command.kind == Command::Kind::Barrier ||
+                           command.kind == Command::Kind::Upload || command.kind == Command::Kind::PresentSnapshot;
