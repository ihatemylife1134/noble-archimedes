@@ -0,0 +1,92 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kPeriodicPc = 0x400000u;
+constexpr uint32_t kDmaPc = 0x400004u;
+constexpr uint32_t kIntcPc = 0x400008u;
+int periodicCalls = 0;
+int dmaCalls = 0;
+int intcCalls = 0;
+int periodicBeforeDma = -1;
+uint32_t lastTick = 0;
+uint32_t dmaCauses = 0;
+
+void periodic(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    ++periodicCalls;
+    lastTick = getRegU32(ctx, 4);
+    ctx->pc = 0u;
+}
+
+void dma(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    dmaCauses |= 1u << getRegU32(ctx, 4);
+    if (periodicBeforeDma < 0)
+    {
+        periodicBeforeDma = periodicCalls;
+    }
+    if (++dmaCalls == 2)
+    {
+        runtime->eeScheduler().requestStop();
+    }
+    ctx->pc = 0u;
+}
+
+void intc(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    ++intcCalls;
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kPeriodicPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kIntcPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 3u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[3] = {periodic, dma, intc};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 1;
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context main{};
+    scheduler.reset(runtime.memory().getRDRAM(), main);
+    scheduler.setIrqCauseEnabled(false, 2u, true);
+    const int firstHandler = scheduler.addIrqHandler(false, 2u, kIntcPc, true, 11u, 0u, 0u);
+    const int secondHandler = scheduler.addIrqHandler(false, 2u, kIntcPc, true, 22u, 0u, 0u);
+    if (firstHandler <= 0 || secondHandler <= 0) return 1;
+
+    // A slow guest can receive many host VBlanks before it services one ISR.
+    for (uint32_t tick = 1; tick <= 100; ++tick)
+    {
+        GuestInvocation vsync{};
+        vsync.kind = GuestInvocationKind::GsCallback;
+        vsync.context.pc = kPeriodicPc;
+        vsync.context.r[4] = _mm_set_epi32(0, 0, 0, static_cast<int>(tick));
+        scheduler.queueInvocation(std::move(vsync));
+        scheduler.dispatchIrq(false, 2u);
+    }
+    // Distinct DMA completions must remain distinct and promptly dispatch.
+    for (int i = 0; i < 2; ++i)
+    {
+        GuestInvocation completion{};
+        completion.kind = GuestInvocationKind::Interrupt;
+        completion.context.pc = kDmaPc;
+        completion.context.r[4] = _mm_set_epi32(0, 0, 0, i == 0 ? 2 : 1);
+        scheduler.queueInvocation(std::move(completion));
+    }
+    scheduler.run();
+    if (periodicBeforeDma != 1 || lastTick != 100 || intcCalls != 2 || dmaCalls != 2 || dmaCauses != 0x6u)
+    {
+        std::cerr << "periodicBeforeDma=" << periodicBeforeDma
+                  << " lastTick=" << lastTick << " intcCalls=" << intcCalls
+                  << " dmaCalls=" << dmaCalls << " dmaCauses=" << dmaCauses << '\n';
+        return 1;
+    }
+    return 0;
+}
