diff --git a/ps2xRuntime/tests/ee_runnable_vblank_pacing_test.cpp b/ps2xRuntime/tests/ee_runnable_vblank_pacing_test.cpp
new file mode 100644
index 0000000..da544ef
--- /dev/null
+++ b/ps2xRuntime/tests/ee_runnable_vblank_pacing_test.cpp
@@ -0,0 +1,110 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <thread>
+
+namespace
+{
+constexpr uint32_t kMainWaitPc = 0x400000u;
+constexpr uint32_t kMainResumePc = 0x400004u;
+constexpr uint32_t kWorkerWaitPc = 0x400008u;
+constexpr uint32_t kWorkerServicePc = 0x40000Cu;
+constexpr uint32_t kVSyncCallbackPc = 0x400010u;
+int semaphoreId = 0;
+int workerId = 0;
+int workerServices = 0;
+bool mainResumed = false;
+
+void mainWait(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    // Start the worker only after main begins, so main reaches WaitVSync
+    // before the first VBlank in either host scheduling order.
+    runtime->eeScheduler().startThread(workerId, 0u, *ctx, true);
+    ctx->pc = kMainResumePc;
+    runtime->eeScheduler().waitVSync(runtime->eeScheduler().currentVSyncTick());
+}
+
+void mainResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    mainResumed = true;
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+
+void workerWait(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ctx->pc = kWorkerServicePc;
+    runtime->eeScheduler().waitSemaphore(semaphoreId);
+}
+
+void workerService(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    ++workerServices;
+    // Simulate a guest dispatch that takes longer than one host VBlank.
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    ctx->pc = kWorkerWaitPc;
+}
+
+void vsyncCallback(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    runtime->eeScheduler().signalSemaphore(semaphoreId, true);
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kMainWaitPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kVSyncCallbackPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 5u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[5] = {
+    mainWait, mainResume, workerWait, workerService, vsyncCallback};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 1;
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context mainContext{};
+    mainContext.pc = kMainWaitPc;
+    scheduler.reset(runtime.memory().getRDRAM(), mainContext);
+    semaphoreId = scheduler.createSemaphore(0, 0, 0u, 0u);
+    if (semaphoreId <= 0) return 1;
+    int oldPriority = 0;
+    if (scheduler.changePriority(1, 41, true, oldPriority) != 0) return 1;
+    EeThreadCreateParams workerParams{};
+    workerParams.entry = kWorkerWaitPc;
+    workerParams.priority = 32;
+    workerParams.stack = 0x100000u;
+    workerParams.stackSize = 0x1000u;
+    workerId = scheduler.createThread(workerParams);
+    if (workerId <= 1) return 1;
+    scheduler.setGsVSyncCallback(kVSyncCallbackPc, 0u, 0u);
+
+    std::atomic<bool> timedOut = false;
+    std::jthread watchdog([&](std::stop_token stop)
+    {
+        for (int i = 0; i < 80 && !stop.stop_requested(); ++i)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        if (!stop.stop_requested())
+        {
+            timedOut.store(true);
+            scheduler.requestStop();
+        }
+    });
+    scheduler.run();
+    watchdog.request_stop();
+    if (!mainResumed || workerServices == 0 || timedOut.load())
+    {
+        std::cerr << "runnable guest lost VBlank pacing: mainResumed=" << mainResumed
+                  << " workerServices=" << workerServices
+                  << " vsyncTicks=" << scheduler.currentVSyncTick()
+                  << " timedOut=" << timedOut.load() << '\n';
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_sif_checkstat_busy_test.cpp b/ps2xRuntime/tests/ee_sif_checkstat_busy_test.cpp
