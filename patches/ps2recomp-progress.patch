+bool GSCpuBackend::ThreadedUnlocked()
+{
+    if (m_workerConfig < 0)
+    {
+        const uint32_t count = std::min<uint32_t>(configuredGsWorkers(), kMaxWorkers);
+        m_workerConfig = count > 1u ? static_cast<int>(count) : 0;
+        if (m_workerConfig > 0)
+        {
+            m_ring.resize(kRingSize);
+            m_workerCaches = std::make_unique<GSMem::TexturePageCache[]>(count);
+            m_workerCluts = std::make_unique<Clut[]>(count);
+            for (uint32_t i = 0; i < count; ++i)
+                m_workerCluts[i] = m_clut;
+            m_workerProgress = std::make_unique<std::atomic<uint64_t>[]>(count);
+            for (uint32_t i = 0; i < count; ++i)
+                m_workerProgress[i].store(0u, std::memory_order_relaxed);
+            m_head.store(0u, std::memory_order_relaxed);
+            m_exclusiveDone.store(0u, std::memory_order_relaxed);
+            m_stopWorkers.store(false, std::memory_order_relaxed);
+            m_workers.reserve(count);
+            for (uint32_t i = 0; i < count; ++i)
