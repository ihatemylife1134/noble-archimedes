+// Forwards DIRECT/DIRECTHL payload qwords to GIF PATH2. PATH2 keeps its GIF
+// tag state between DIRECT commands, so qwords still owed to an earlier IMAGE
+// tag are wrapped in a synthesized IMAGE tag for the per-packet GS parser.
+void PS2Memory::submitVif1DirectPayload(const uint8_t *data, uint32_t qwCount, bool directHl)
+{
+    uint32_t consumedQw = 0u;
+    if (m_vif1PendingPath2ImageQwc != 0u)
+    {
+        const uint32_t chunkQw = std::min<uint32_t>(m_vif1PendingPath2ImageQwc, qwCount);
+        std::vector<uint8_t> imagePacket(16u + static_cast<size_t>(chunkQw) * 16u, 0u);
+        const uint64_t imageTag =
+            static_cast<uint64_t>(chunkQw & 0x7FFFu) |
+#if defined(PS2_GS_HAVE_PGS)
+            GSRawFeed::continuationMarker |
+#endif
+            ((m_vif1PendingPath2ImageQwc == chunkQw) ? (1ull << 15) : 0ull) |
+            (static_cast<uint64_t>(kGifFmtImage) << 58);
+        std::memcpy(imagePacket.data(), &imageTag, sizeof(imageTag));
+        std::memcpy(imagePacket.data() + 16u, data, static_cast<size_t>(chunkQw) * 16u);
+#if defined(PS2_GS_HAVE_PGS)
+        GSRawFeed::ContinuationScope rawContinuation(imagePacket.data());
+#endif
+        submitGifPacket(GifPathId::Path2, imagePacket.data(), static_cast<uint32_t>(imagePacket.size()), true, m_vif1PendingPath2DirectHl);
+
+        consumedQw = chunkQw;
+        m_vif1PendingPath2ImageQwc -= chunkQw;
+        if (m_vif1PendingPath2ImageQwc == 0u)
+            m_vif1PendingPath2DirectHl = false;
+    }
+
+    if (consumedQw >= qwCount)
+        return;
+
+    const uint8_t *packet = data + static_cast<size_t>(consumedQw) * 16u;
+    const uint32_t packetBytes = (qwCount - consumedQw) * 16u;
+    submitGifPacket(GifPathId::Path2, packet, packetBytes, true, directHl);
+
+    const uint32_t pendingImageQw = pendingGifImageQwc(packet, packetBytes);
+    if (pendingImageQw != 0u)
+    {
+        m_vif1PendingPath2ImageQwc = pendingImageQw;
+        m_vif1PendingPath2DirectHl = directHl;
+    }
+}
