+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kMainPc = 0x400000u;
+constexpr uint32_t kHandlerPc = 0x400004u;
+constexpr uint32_t kDStat = 0x1000E010u;
+constexpr uint32_t kGifCause = 2u;
+
+int handlerCalls = 0;
+
+void stopMain(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+
+void dmacHandler(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    ++handlerCalls;
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kMainPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kHandlerPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 2u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[2] = {stopMain, dmacHandler};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 1;
+
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context main{};
+    main.pc = kMainPc;
+    scheduler.reset(runtime.memory().getRDRAM(), main);
+
+    if (scheduler.addIrqHandler(true, kGifCause, kHandlerPc, true, 0u, 0u, 0u) <= 0) return 1;
+
+    // The game temporarily disables a DMA cause through the kernel, then
+    // restores it by writing D_STAT directly. The hardware register is the
+    // authoritative mask in that case, even though the scheduler shadow is stale.
+    scheduler.setIrqCauseEnabled(true, kGifCause, false);
+    runtime.memory().writeIORegister(kDStat, 1u << (16u + kGifCause));
+    if ((runtime.memory().readIORegister(kDStat) & (1u << (16u + kGifCause))) == 0u)
+    {
+        std::cerr << "failed to enable GIF in D_STAT\n";
+        return 1;
+    }
+
+    scheduler.dispatchIrq(true, kGifCause);
+    scheduler.run();
+
+    if (handlerCalls != 1)
+    {
+        std::cerr << "D_STAT-enabled DMA interrupt was dropped; handlerCalls=" << handlerCalls << '\n';
+        return 1;
+    }
+    return 0;
+}
