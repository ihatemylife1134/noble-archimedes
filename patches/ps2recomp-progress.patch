+void GSCpuBackend::DrainUnlocked() const
+{
+    if (m_workerConfig <= 0)
+        return;
+    const uint64_t head = m_head.load(std::memory_order_acquire);
+    const uint32_t count = static_cast<uint32_t>(m_workerConfig);
+    auto finished = [&]()
+    {
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            if (m_workerProgress[i].load(std::memory_order_acquire) < head)
+                return false;
+        }
+        return true;
+    };
+    if (!finished())
+    {
+        HostProfile::Scope profileScope(HostProfile::GsDrainWait);
+        waitUntil(m_signalMutex, m_signalCv, m_sleepers, finished);
+    }
+}
