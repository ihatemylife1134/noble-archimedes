--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -184,0 +185,38 @@ namespace
+    // Minimal IRX whose start routine is the given R3000 code.
+    void writeCodeIrx(TestHost &host, uint32_t address, const uint32_t *code, size_t count)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu;
+        header.ident[1] = 'E';
+        header.ident[2] = 'L';
+        header.ident[3] = 'F';
+        header.ident[4] = 1u;
+        header.ident[5] = 1u;
+        header.ident[6] = 1u;
+        header.type = 2u;
+        header.machine = 8u;
+        header.version = 1u;
+        header.entry = loadAddress;
+        header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader);
+        header.phentsize = sizeof(ProgramHeader);
+        header.phnum = 1u;
+
+        ProgramHeader program{};
+        program.type = 1u;
+        program.offset = codeOffset;
+        program.vaddr = loadAddress;
+        program.paddr = loadAddress;
+        program.filesz = static_cast<uint32_t>(count * sizeof(uint32_t));
+        program.memsz = program.filesz;
+        program.flags = 5u;
+        program.align = 4u;
+
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, code, count * sizeof(uint32_t));
+    }
+
@@ -913,0 +952,35 @@ int main()
+    {
+        // SPU2 drivers poll core STATX until its low bits clear, e.g. LIBSD's
+        // initialization waits (STATX & 0x7FF) == 0 with a delay loop. Starting
+        // a core DMA sets STATX bit 7; completing it must clear the bit again.
+        const uint32_t spuDmaPoll[] = {
+            0x3C08BF80u, // lui   t0, 0xBF80
+            0x350810C4u, // ori   t0, t0, 0x10C4   (SPU2 core0 DMA BCR)
+            0x3C090001u, // lui   t1, 1            (one block)
+            0x35290010u, // ori   t1, t1, 0x10     (16 words)
+            0xAD090000u, // sw    t1, 0(t0)
+            0x3C090100u, // lui   t1, 0x0100       (CHCR start)
+            0x35290201u, // ori   t1, t1, 0x0201
+            0xAD090004u, // sw    t1, 4(t0)        (SPU2 core0 DMA CHCR)
+            0x3C0ABF90u, // lui   t2, 0xBF90
+            0x354A0344u, // ori   t2, t2, 0x344    (core0 STATX)
+            0x240B4000u, // addiu t3, zero, 0x4000 (poll limit)
+            0x95420000u, // loop: lhu v0, 0(t2)
+            0x00000000u, // nop                    (R3000A load delay slot)
+            0x304207FFu, // andi  v0, v0, 0x7FF
+            0x10400004u, // beq   v0, zero, done
+            0x00000000u, // nop
+            0x256BFFFFu, // addiu t3, t3, -1
+            0x1560FFF9u, // bne   t3, zero, loop
+            0x00000000u, // nop
+            0x03E00008u, // done: jr ra            (v0 = STATX & 0x7FF)
+            0x00000000u, // nop
+        };
+        writeCodeIrx(host, 0x100u, spuDmaPoll, sizeof(spuDmaPoll) / sizeof(spuDmaPoll[0]));
+        const ModuleLoadResult spuResult = iop.loadModuleBuffer(0x100u);
+        if (!expect(spuResult.handled, "SPU2 DMA poll IRX was not loaded")) return 1;
+        if (!expect(spuResult.startResult == 0,
+                    "SPU2 core STATX stayed busy after its DMA completed")) return 1;
+        iop.reset();
+    }
+
