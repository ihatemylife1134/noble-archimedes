+    // Conservative screen-space bounding box of a primitive after XYOFFSET,
+    // clipped to the scissor. Returns false when nothing can be drawn.
+    bool primitiveBounds(const GSPrimitiveBatch &batch, int &x0, int &x1, int &y0, int &y1)
+    {
+        const GSContext &ctx = batch.state.context;
+        const uint32_t count = batch.state.prim.type == GS_PRIM_POINT ? 1u
+                             : (batch.state.prim.type == GS_PRIM_TRIANGLE || batch.state.prim.type == GS_PRIM_TRISTRIP ||
+                                batch.state.prim.type == GS_PRIM_TRIFAN) ? 3u
+                                                                        : 2u;
