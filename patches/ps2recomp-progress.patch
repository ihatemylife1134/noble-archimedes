+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ee_scheduler.h"
+#include "Kernel/Syscalls/RPC.h"
+#include "Kernel/Syscalls/Helpers/State.h"
+
+#include <cstdint>
+#include <iostream>
+
+void sub_00761330_0x761330(uint8_t *, R5900Context *, PS2Runtime *);
+
+namespace
+{
+constexpr uint32_t kCheckPc = 0x761330u;
+constexpr uint32_t kServerPc = 0x761338u;
+constexpr uint32_t kServerReturnPc = 0x76133Cu;
+constexpr uint32_t kOuterPc = 0x761340u;
+constexpr uint32_t kClientPtr = 0x100000u;
+constexpr uint32_t kServerPtr = 0x100100u;
+constexpr uint32_t kStackPtr = 0x1FFE000u;
+constexpr uint32_t kCompletionFlag = 0xA30300u;
+constexpr uint32_t kThreadFlag = 0x9E5CC4u;
+
+bool serverRan = false;
+uint32_t directBusy = ~0u;
+uint32_t branchBusy = ~0u;
+uint32_t completionAfterPoll = ~0u;
+uint32_t threadFlagAfterPoll = ~0u;
+bool outerRan = false;
+bool rpcThrew = false;
+
+void serverProbe(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    serverRan = true;
+    R5900Context directContext = *ctx;
+    SET_GPR_U32(&directContext, 4, kClientPtr);
+    ps2_syscalls::SifCheckStatRpc(rdram, &directContext, runtime);
+    directBusy = getRegU32(&directContext, 2);
+
+    SET_GPR_U32(ctx, 4, kClientPtr);
+    SET_GPR_U32(ctx, 31, kServerReturnPc);
+    ctx->pc = kCheckPc;
+    (void)runtime->dispatchGuestBranch(rdram, ctx, kCheckPc, kServerPc,
+                                       kServerReturnPc,
+                                       PS2Runtime::GuestBranchKind::DirectCall,
+                                       "sceSifCheckStatRpc during busy CallRpc");
+    branchBusy = getRegU32(ctx, 2);
+    completionAfterPoll = *reinterpret_cast<uint32_t *>(rdram + kCompletionFlag);
+    threadFlagAfterPoll = *reinterpret_cast<uint32_t *>(rdram + kThreadFlag);
+    ctx->pc = 0u;
+}
+
+void outerCall(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    outerRan = true;
+    SET_GPR_U32(ctx, 4, kClientPtr);
+    SET_GPR_U32(ctx, 5, 1u);
+    SET_GPR_U32(ctx, 6, 0u);
+    SET_GPR_U32(ctx, 7, 0u);
+    try
+    {
+        ps2_syscalls::SifCallRpc(rdram, ctx, runtime);
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "fixture: RPC exception: " << error.what() << '\n';
+        rpcThrew = true;
+    }
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+} // namespace
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kCheckPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kOuterPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount =
+    (kOuterPc + 4u - kCheckPc) / 4u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[g_ps2RecompiledFunctionTableSlotCount] = {};
+
+int main()
+{
+    std::cerr << "fixture: begin\n";
+    g_ps2RecompiledFunctionTable[(kCheckPc - kCheckPc) / 4u] = sub_00761330_0x761330;
+    g_ps2RecompiledFunctionTable[(kServerPc - kCheckPc) / 4u] = serverProbe;
+    g_ps2RecompiledFunctionTable[(kOuterPc - kCheckPc) / 4u] = outerCall;
+
+    PS2Runtime runtime;
+    std::cerr << "fixture: runtime constructed\n";
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 2;
+    std::cerr << "fixture: memory initialized\n";
+    uint8_t *rdram = runtime.memory().getRDRAM();
+    auto *client = reinterpret_cast<t_SifRpcClientData *>(rdram + kClientPtr);
+    auto *server = reinterpret_cast<t_SifRpcServerData *>(rdram + kServerPtr);
+    client->server = kServerPtr;
+    server->func = kServerPc;
+    server->buf = 0u;
+    *reinterpret_cast<uint32_t *>(rdram + kCompletionFlag) = 0u;
+    *reinterpret_cast<uint32_t *>(rdram + kThreadFlag) = 0u;
+
+    R5900Context context{};
+    context.pc = kOuterPc;
+    SET_GPR_U32(&context, 29, kStackPtr);
+    runtime.eeScheduler().reset(rdram, context);
+    std::cerr << "fixture: running guest RPC caller\n";
+    runtime.eeScheduler().run();
+
+    std::cout << "serverRan=" << serverRan << " directBusy=" << directBusy
+              << " branchBusy=" << branchBusy
+              << " completionAfterPoll=" << completionAfterPoll
+              << " threadFlagAfterPoll=" << threadFlagAfterPoll << '\n';
+    if (!outerRan || !serverRan || rpcThrew) return 2; // Busy-client fixture did not run.
+    return directBusy == 1u && branchBusy == 1u &&
+                   completionAfterPoll == 0u && threadFlagAfterPoll == 0u
+               ? 0
+               : 1;
+}
diff --git a/ps2xRuntime/tests/ee_start_thread_arg_test.cpp b/ps2xRuntime/tests/ee_start_thread_arg_test.cpp
new file mode 100644
index 0000000..e00ece0
--- /dev/null
+++ b/ps2xRuntime/tests/ee_start_thread_arg_test.cpp
@@ -0,0 +1,68 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+constexpr uint32_t kWorkerPc = 0x400000u;
+constexpr uint32_t kFirstArg = 0xA302C0u;
+constexpr uint32_t kRestartArg = 0xA302D0u;
+uint32_t observedArg = 0u;
+uint32_t observedPc = 0u;
+
+void worker(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    observedArg = getRegU32(ctx, 4);
+    observedPc = ctx->pc;
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+} // namespace
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kWorkerPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kWorkerPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 1u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {worker};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 2;
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context main{};
+    scheduler.reset(runtime.memory().getRDRAM(), main);
+
+    EeThreadCreateParams params{};
+    params.entry = kWorkerPc;
+    params.priority = 2;
+    params.stack = 0x100000u;
+    params.stackSize = 0x1000u;
+    const int id = scheduler.createThread(params);
+    if (id < 2 || scheduler.startThread(id, kFirstArg, main, false) != 0) return 2;
+    const GuestThread *thread = scheduler.thread(id);
+    const uint32_t firstContextArg = getRegU32(&thread->context, 4);
+    const uint32_t firstStoredArg = thread->arg;
+    uint32_t ownedStack = 0u;
+    if (scheduler.terminateThread(id, ownedStack, false) != 0 || ownedStack != 0u)
+        return 2;
+    if (scheduler.startThread(id, kRestartArg, main, false) != 0) return 2;
+    thread = scheduler.thread(id);
+    const uint32_t restartContextArg = getRegU32(&thread->context, 4);
+    const uint32_t restartStoredArg = thread->arg;
+    scheduler.run();
+
+    std::cout << std::hex << "firstStored=0x" << firstStoredArg
+              << " firstA0=0x" << firstContextArg
+              << " restartStored=0x" << restartStoredArg
+              << " restartA0=0x" << restartContextArg
+              << " workerA0=0x" << observedArg
+              << " workerPc=0x" << observedPc << '\n';
+    return firstStoredArg == kFirstArg && firstContextArg == kFirstArg &&
+                   restartStoredArg == kRestartArg &&
+                   restartContextArg == kRestartArg &&
+                   observedArg == kRestartArg && observedPc == kWorkerPc
+               ? 0
+               : 1;
+}
diff --git a/ps2xRuntime/tests/ee_vblank_pacing_test.cpp b/ps2xRuntime/tests/ee_vblank_pacing_test.cpp
new file mode 100644
index 0000000..02ebaa5
--- /dev/null
+++ b/ps2xRuntime/tests/ee_vblank_pacing_test.cpp
@@ -0,0 +1,50 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <thread>
+
+namespace
+{
+constexpr uint32_t kMainPc = 0x400000u;
+uint64_t tickAtMainDispatch = UINT64_MAX;
+
+void mainFunction(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    tickAtMainDispatch = runtime->eeScheduler().currentVSyncTick();
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kMainPc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kMainPc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 1u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {mainFunction};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE))
+    {
+        return 1;
+    }
+    R5900Context mainContext{};
+    mainContext.pc = kMainPc;
+    EeScheduler &scheduler = runtime.eeScheduler();
+    scheduler.reset(runtime.memory().getRDRAM(), mainContext);
+    // Several host VBlank periods elapse before the scheduler can emulate
+    // the first tick; virtual EE cycles are also ahead of multiple ticks.
+    std::this_thread::sleep_for(std::chrono::milliseconds(80));
+    (void)scheduler.checkpointDue(30'000'000u);
+    scheduler.run();
+    if (tickAtMainDispatch != 1u)
+    {
+        std::cerr << "late VBlank accumulated host catch-up debt; guest ran at tick "
+                  << tickAtMainDispatch << " instead of after the first tick\n";
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_virtual_vblank_progress_test.cpp b/ps2xRuntime/tests/ee_virtual_vblank_progress_test.cpp
new file mode 100644
index 0000000..febf40d
--- /dev/null
+++ b/ps2xRuntime/tests/ee_virtual_vblank_progress_test.cpp
@@ -0,0 +1,78 @@
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <thread>
+
+namespace
+{
+constexpr uint32_t kCyclePc = 0x400000u;
+constexpr uint32_t kIdleWaitPc = 0x400004u;
+constexpr uint32_t kIdleResumePc = 0x400008u;
+int cycleCalls = 0;
+uint64_t cycleTick = 0;
+uint64_t idleTick = 0;
+
+void cycleLoop(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ++cycleCalls;
+    if (runtime->eeScheduler().currentVSyncTick() != 0u)
+    {
+        cycleTick = runtime->eeScheduler().currentVSyncTick();
+        runtime->eeScheduler().requestStop();
+        ctx->pc = 0u;
+        return;
+    }
+    (void)runtime->eeScheduler().checkpointDue(1'000'000u);
+    ctx->pc = kCyclePc;
+}
+
+void idleWait(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    ctx->pc = kIdleResumePc;
+    runtime->eeScheduler().waitVSync(0u);
+}
+
+void idleResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+{
+    idleTick = runtime->eeScheduler().currentVSyncTick();
+    runtime->eeScheduler().requestStop();
+    ctx->pc = 0u;
+}
+}
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = kCyclePc;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = kIdleResumePc + 4u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 3u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[3] = {cycleLoop, idleWait, idleResume};
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE)) return 1;
+    EeScheduler &scheduler = runtime.eeScheduler();
+    R5900Context context{};
+    context.pc = kCyclePc;
+    scheduler.reset(runtime.memory().getRDRAM(), context);
+    // Host time is already past one VBlank. A runnable guest must reach the
+    // deadline through charged EE cycles, not a wall-clock jump.
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    scheduler.run();
+    if (cycleCalls != 6 || cycleTick != 1u)
+    {
+        std::cerr << "runnable cycle VBlank: calls=" << cycleCalls << " tick=" << cycleTick << '\n';
+        return 1;
+    }
+
+    context.pc = kIdleWaitPc;
+    scheduler.reset(runtime.memory().getRDRAM(), context);
+    scheduler.run();
+    if (idleTick != 1u)
+    {
+        std::cerr << "idle WaitVSync did not advance: tick=" << idleTick << '\n';
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/ee_zero_max_semaphore_test.cpp b/ps2xRuntime/tests/ee_zero_max_semaphore_test.cpp
new file mode 100644
index 0000000..dab9d39
--- /dev/null
+++ b/ps2xRuntime/tests/ee_zero_max_semaphore_test.cpp
@@ -0,0 +1,67 @@
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_syscalls.h"
+#include "runtime/ee_scheduler.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = 0u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 0u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {};
+
+struct EeSemaDescriptor
+{
+    int32_t count;
+    int32_t maxCount;
+    int32_t initCount;
+    int32_t waitThreads;
+    uint32_t attr;
+    uint32_t option;
+};
+static_assert(sizeof(EeSemaDescriptor) == 0x18);
+
+int main()
+{
+    PS2Runtime runtime;
+    if (!runtime.memory().initialize(PS2_RAM_SIZE))
+    {
+        return 1;
+    }
+    uint8_t *rdram = runtime.memory().getRDRAM();
+    R5900Context ctx{};
+    constexpr uint32_t descriptorAddress = 0x1000u;
+    const EeSemaDescriptor event{}; // Game supplies max_count=init_count=0.
+    std::memcpy(rdram + descriptorAddress, &event, sizeof(event));
+    SET_GPR_U32(&ctx, 4, descriptorAddress);
+    ps2_syscalls::CreateSema(rdram, &ctx, &runtime);
+    const int id = static_cast<int32_t>(getRegU32(&ctx, 2));
+    if (id <= 0)
+    {
+        std::cerr << "zero-max EE event semaphore rejected: " << id << '\n';
+        return 1;
+    }
+    EeScheduler &scheduler = runtime.eeScheduler();
+    const EeSemaphore *created = scheduler.semaphore(id);
+    if (!created || created->count != 0 || created->maxCount != 0)
+    {
+        std::cerr << "zero-max EE event semaphore descriptor decoded incorrectly\n";
+        return 1;
+    }
+    if (scheduler.signalSemaphore(id, false) != id || created->count != 1 ||
+        scheduler.pollSemaphore(id) != id || created->count != 0)
+    {
+        std::cerr << "zero-max EE event semaphore lost a pending signal\n";
+        return 1;
+    }
+    const int boundedId = scheduler.createSemaphore(0, 1, 0, 0);
+    if (boundedId <= 0 || scheduler.signalSemaphore(boundedId, false) != boundedId ||
+        scheduler.signalSemaphore(boundedId, false) != -420)
+    {
+        std::cerr << "positive-max semaphore overflow semantics changed\n";
+        return 1;
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/gs_raster_diff.cpp b/ps2xRuntime/tests/gs_raster_diff.cpp
new file mode 100644
index 0000000..8a6f2dc
--- /dev/null
+++ b/ps2xRuntime/tests/gs_raster_diff.cpp
@@ -0,0 +1,518 @@
+// Differential oracle for GSCpuBackend rasterization.
+//
+// Renders captured draw batches plus seeded random primitives (all primitive
+// types, frame/Z/texture formats, CLUT modes, alpha/depth/destination-alpha
+// tests, blending, fog, clamping, filtering, masks) and prints one 64-bit hash
+// of the full 4 MiB of GS local memory per case. Build it once against a
+// reference copy of the rasterizer and once against the candidate; identical
+// output means the candidate is bit-exact on every case.
+//
+// Usage: gs_raster_diff <base_vram.bin> <seed> <cases> <single|disjoint|sequence> [captured_batch.bin ...]
+//   single:   one random primitive per case, any memory layout
+//   disjoint: one random primitive per case; framebuffer, Z, texture and CLUT
+//             live in disjoint VRAM regions and textures stay inside their
+//             footprint (no render/texture feedback)
+//   sequence: 24 queued operations per case (draws as in disjoint, uploads,
+//             CLUT loads, texture flushes) before the final synchronization;
+//             the transfer bookkeeping is hashed too
+//   pingpong: 24 queued operations per case over two render targets A/B:
+//             each draw renders into one while sampling the other (read-
+//             after-write and write-after-read across draws), plus uploads
+//             into A/B and CLUT loads sourced from A/B. TEXFLUSH precedes
+//             every draw and CLUT load, as the hardware requires.
+//   sprites / sprites-disjoint: as single / disjoint with every primitive a
+//             sprite, 90% of them textured
+//   feedback: one textured sprite per case that samples the framebuffer it
+//             renders to, at a shifted position (render/texture feedback)
+//   stale:    as sequence, mostly sprites, and never a texture flush, with
+//             every texture and upload at one texture page (page 320): draws
+//             sample through the texture page cache's stale copy (only
+//             meaningful for a synchronous candidate: every worker has its
+//             own cache)
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_types.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace
+{
+std::vector<uint8_t> readFile(const char *path)
+{
+    std::ifstream file(path, std::ios::binary);
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(file), {});
+}
+
+struct Rng
+{
+    uint64_t state;
+    uint64_t next()
+    {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        return state;
+    }
+    uint32_t below(uint32_t n) { return static_cast<uint32_t>(next() % n); }
+    bool chance(uint32_t percent) { return below(100) < percent; }
+    float range(float lo, float hi) { return lo + (hi - lo) * static_cast<float>(next() % 1000001u) / 1000000.0f; }
+    template <typename T, size_t N>
+    T pick(const T (&values)[N]) { return values[below(N)]; }
+};
+
+uint64_t hashMemory(const uint8_t *data, size_t size)
+{
+    uint64_t h = 0x9E3779B97F4A7C15ull;
+    for (size_t i = 0; i + 8 <= size; i += 8)
+    {
+        uint64_t word;
+        std::memcpy(&word, data + i, 8);
+        h ^= word + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    }
+    return h;
+}
+
+bool g_forceSprites = false;
+bool g_pinTexturePage = false; // textures and uploads start at page 320
+
+GSPrimitiveBatch randomBatch(Rng &rng, bool disjoint)
+{
+    GSPrimitiveBatch b{};
+    GSDrawState &s = b.state;
+    GSContext &c = s.context;
+
+    static const GSPrimType kTypes[] = {GS_PRIM_SPRITE, GS_PRIM_SPRITE, GS_PRIM_SPRITE, GS_PRIM_TRIANGLE,
+                                        GS_PRIM_TRIANGLE, GS_PRIM_TRISTRIP, GS_PRIM_TRIFAN, GS_PRIM_LINE,
+                                        GS_PRIM_LINESTRIP, GS_PRIM_POINT};
+    s.prim.type = rng.pick(kTypes);
+    s.prim.iip = rng.chance(50);
+    s.prim.tme = rng.chance(75);
+    s.prim.fge = rng.chance(20);
+    s.prim.abe = rng.chance(60);
+    s.prim.fst = rng.chance(65);
+
+    static const uint8_t kFramePsm[] = {GS_PSM_CT32, GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S, GS_PSM_CT16S};
+    c.frame.fbp = rng.below(300);
+    c.frame.fbw = 1 + rng.below(10);
+    c.frame.psm = rng.pick(kFramePsm);
+    c.frame.fbmsk = rng.chance(15) ? static_cast<uint32_t>(rng.next()) : 0u;
+
+    static const uint8_t kZPsm[] = {GS_PSM_Z32, GS_PSM_Z24, GS_PSM_Z16, GS_PSM_Z16S, GS_PSM_Z16S};
+    c.zbuf.zbp = rng.below(300);
+    c.zbuf.psm = rng.pick(kZPsm);
+    c.zbuf.zmask = rng.chance(30);
+
+    c.scissor.x0 = static_cast<uint16_t>(rng.below(64));
+    c.scissor.y0 = static_cast<uint16_t>(rng.below(64));
+    c.scissor.x1 = static_cast<uint16_t>(c.scissor.x0 + rng.below(640));
+    c.scissor.y1 = static_cast<uint16_t>(c.scissor.y0 + rng.below(480));
+    const uint16_t baseX = static_cast<uint16_t>(1024 + rng.below(1024));
+    const uint16_t baseY = static_cast<uint16_t>(1024 + rng.below(1024));
+    c.xyoffset.ofx = static_cast<uint16_t>(baseX << 4);
+    c.xyoffset.ofy = static_cast<uint16_t>(baseY << 4);
+
+    static const uint8_t kTexPsm[] = {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S, GS_PSM_T8, GS_PSM_T4,
+                                      GS_PSM_T4, GS_PSM_T8H, GS_PSM_T4HL, GS_PSM_T4HH};
+    static const uint8_t kClutPsm[] = {GS_PSM_CT32, GS_PSM_CT32, GS_PSM_CT16, GS_PSM_CT16S};
+    c.tex0.tbp0 = rng.below(16000);
+    c.tex0.tbw = static_cast<uint8_t>(1 + rng.below(10));
+    c.tex0.psm = rng.pick(kTexPsm);
+    c.tex0.tw = static_cast<uint8_t>(rng.below(11));
+    c.tex0.th = static_cast<uint8_t>(rng.below(11));
+    c.tex0.tcc = static_cast<uint8_t>(rng.below(2));
+    c.tex0.tfx = static_cast<uint8_t>(rng.below(4));
+    c.tex0.cpsm = rng.pick(kClutPsm);
+    c.tex0.csm = static_cast<uint8_t>(rng.below(2));
+    c.tex0.csa = static_cast<uint8_t>(rng.below(32));
+    c.tex1 = rng.next();
+    c.clamp = rng.next() & 0xFFFFFFFFFFFull;
+    c.alpha = (rng.next() & 0xFFull) | (static_cast<uint64_t>(rng.below(256)) << 32);
+    c.test = rng.next() & 0x7FFFFull;
+    c.fba = rng.below(2);
+
+    s.texa.ta0 = static_cast<uint8_t>(rng.below(256));
+    s.texa.aem = rng.chance(30);
+    s.texa.ta1 = static_cast<uint8_t>(rng.below(256));
+    s.pabe = rng.chance(20);
+    s.fogR = static_cast<uint8_t>(rng.below(256));
+    s.fogG = static_cast<uint8_t>(rng.below(256));
+    s.fogB = static_cast<uint8_t>(rng.below(256));
+    s.textureWidth = static_cast<uint16_t>(1u << std::min<uint32_t>(c.tex0.tw, 10u));
+    s.textureHeight = static_cast<uint16_t>(1u << std::min<uint32_t>(c.tex0.th, 10u));
+    s.linearFilter = rng.chance(25);
+
+    if (disjoint)
+    {
+        // Frame pages [0, 124), Z pages [128, 252), textures and uploads from
+        // page 320, CLUTs from page 420 (see footprint bounds below).
+        c.frame.fbp = rng.below(64);
+        c.frame.fbw = 1 + rng.below(4);
+        c.zbuf.zbp = 128 + rng.below(64);
+        c.scissor.x0 = static_cast<uint16_t>(rng.below(32));
+        c.scissor.y0 = static_cast<uint16_t>(rng.below(32));
+        c.scissor.x1 = static_cast<uint16_t>(std::min<uint32_t>(c.frame.fbw * 64u - 1u, c.scissor.x0 + rng.below(256)));
+        c.scissor.y1 = static_cast<uint16_t>(std::min<uint32_t>(479u, c.scissor.y0 + rng.below(480)));
+        c.tex0.tbp0 = 320u * 32u + rng.below(32u * 32u);
+        c.tex0.tbw = static_cast<uint8_t>(1 + rng.below(4));
+        c.tex0.tw = static_cast<uint8_t>(std::min<uint32_t>(c.tex0.tw, 7u));
+        c.tex0.th = static_cast<uint8_t>(std::min<uint32_t>(c.tex0.th, 7u));
+        c.clamp &= ~0xFull;                            // WMS/WMT: repeat or clamp keeps
+        c.clamp |= rng.below(2) | (rng.below(2) << 2); // coordinates inside the texture
+        s.textureWidth = static_cast<uint16_t>(1u << c.tex0.tw);
+        s.textureHeight = static_cast<uint16_t>(1u << c.tex0.th);
+    }
+
+    if (g_pinTexturePage)
+    {
+        c.tex0.tbp0 = 320u * 32u;
+        c.tex0.tbw = 1u;
+        c.tex0.tw = static_cast<uint8_t>(std::min<uint32_t>(c.tex0.tw, 6u));
+        c.tex0.th = static_cast<uint8_t>(std::min<uint32_t>(c.tex0.th, 5u));
+        s.textureWidth = static_cast<uint16_t>(1u << c.tex0.tw);
+        s.textureHeight = static_cast<uint16_t>(1u << c.tex0.th);
+    }
+
+    if (g_forceSprites)
+    {
+        s.prim.type = GS_PRIM_SPRITE;
+        s.prim.tme = rng.chance(90);
+    }
+
+    const bool big = rng.chance(10);
+    const float span = big ? 520.0f : 140.0f;
+    b.vertexCount = s.prim.type == GS_PRIM_SPRITE || s.prim.type == GS_PRIM_LINE || s.prim.type == GS_PRIM_LINESTRIP ? 2
+                  : s.prim.type == GS_PRIM_POINT ? 1 : 3;
+    for (GSVertex &v : b.vertices)
+    {
+        v.x = static_cast<float>(baseX) + rng.range(-24.0f, span);
+        v.y = static_cast<float>(baseY) + rng.range(-24.0f, span);
+        if (rng.chance(50))
+        {
+            v.x = static_cast<float>(static_cast<int>(v.x));
+            v.y = static_cast<float>(static_cast<int>(v.y));
+        }
+        v.z = static_cast<double>(rng.next() & 0xFFFFFFFFull);
+        v.r = static_cast<uint8_t>(rng.below(256));
+        v.g = static_cast<uint8_t>(rng.below(256));
+        v.b = static_cast<uint8_t>(rng.below(256));
+        v.a = static_cast<uint8_t>(rng.below(256));
+        v.q = rng.chance(10) ? 0.0f : rng.range(0.05f, 2.0f);
+        v.s = rng.range(-0.5f, 1.6f);
+        v.t = rng.range(-0.5f, 1.6f);
+        v.u = static_cast<uint16_t>(rng.below(static_cast<uint32_t>(s.textureWidth) * 24u + 1u));
+        v.v = static_cast<uint16_t>(rng.below(static_cast<uint32_t>(s.textureHeight) * 24u + 1u));
+        v.fog = static_cast<uint8_t>(rng.below(256));
+    }
+    return b;
+}
+
+void loadRandomClut(GSCpuBackend &backend, Rng &rng, const GSPrimitiveBatch &batch, bool disjoint)
+{
+    GSTex0Reg tex0 = batch.state.context.tex0;
+    static const uint8_t kIndexed[] = {GS_PSM_T8, GS_PSM_T4};
+    tex0.psm = rng.pick(kIndexed);
+    tex0.cbp = disjoint ? 420u * 32u + rng.below(20u * 32u) : rng.below(16000);
+    tex0.cld = 1;
+    GSTexClutReg clut{};
+    clut.cbw = static_cast<uint8_t>(rng.below(8));
+    clut.cou = static_cast<uint8_t>(rng.below(8));
+    clut.cov = static_cast<uint16_t>(rng.below(64));
+    backend.LoadClut(tex0, clut);
+}
+void randomUpload(GSCpuBackend &backend, Rng &rng)
+{
+    static const uint8_t kPsm[] = {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S, GS_PSM_T8, GS_PSM_T4,
+                                   GS_PSM_T8H, GS_PSM_T4HL, GS_PSM_T4HH, GS_PSM_Z32, GS_PSM_Z16S};
+    GSTransferCommand command{};
+    command.bitbltbuf.dbp = 320u * 32u + rng.below(40u * 32u);
+    command.bitbltbuf.dbw = static_cast<uint8_t>(1 + rng.below(4));
+    command.bitbltbuf.dpsm = rng.pick(kPsm);
+    command.trxpos.dsax = static_cast<uint16_t>(rng.below(32));
+    command.trxpos.dsay = static_cast<uint16_t>(rng.below(32));
+    command.trxreg.rrw = static_cast<uint16_t>(1 + rng.below(64));
+    command.trxreg.rrh = static_cast<uint16_t>(1 + rng.below(64));
+    command.direction = 0u;
+    if (g_pinTexturePage)
+    {
+        command.bitbltbuf.dbp = 320u * 32u;
+        command.bitbltbuf.dbw = 1u;
+    }
+    backend.BeginTransfer(command);
+    const uint8_t psm = command.bitbltbuf.dpsm;
+    const uint32_t bits = (psm == GS_PSM_CT32 || psm == GS_PSM_Z32) ? 32u
+                        : psm == GS_PSM_CT24                         ? 24u
+                        : (psm == GS_PSM_T8 || psm == GS_PSM_T8H)    ? 8u
+                        : (psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH) ? 4u
+                                                                                      : 16u;
+    uint32_t bytes = (static_cast<uint32_t>(command.trxreg.rrw) * command.trxreg.rrh * bits + 7u) / 8u;
+    if (rng.chance(20))
+        bytes += rng.below(40); // trailing bytes beyond the transfer are ignored
+    else if (rng.chance(20))
+        bytes = rng.below(bytes + 1u); // an unfinished transfer
+    std::vector<uint8_t> data(bytes);
+    for (uint8_t &value : data)
+        value = static_cast<uint8_t>(rng.next());
+    // Deliver the image in up to three pieces, like split GIF IMAGE packets.
+    uint32_t offset = 0;
+    for (int piece = 0; piece < 3 && offset < bytes; ++piece)
+    {
+        const uint32_t size = piece == 2 ? bytes - offset : rng.below(bytes - offset + 1u);
+        if (size != 0u)
+            backend.UploadImage(data.data() + offset, size);
+        offset += size;
+    }
+}
+
+// Ping-pong targets: A at page 0, B at page 64, both CT32 with FBW 4 (256x240).
+GSPrimitiveBatch pingPongBatch(Rng &rng, bool intoA)
+{
+    GSPrimitiveBatch b = randomBatch(rng, true);
+    GSContext &c = b.state.context;
+    const uint32_t target = intoA ? 0u : 64u;
+    const uint32_t source = intoA ? 64u : 0u;
+    c.frame.fbp = target;
+    c.frame.fbw = 4u;
+    c.frame.psm = GS_PSM_CT32;
+    c.scissor.x0 = static_cast<uint16_t>(rng.below(32));
+    c.scissor.y0 = static_cast<uint16_t>(rng.below(32));
+    c.scissor.x1 = static_cast<uint16_t>(std::min<uint32_t>(255u, c.scissor.x0 + rng.below(256)));
+    c.scissor.y1 = static_cast<uint16_t>(std::min<uint32_t>(239u, c.scissor.y0 + rng.below(240)));
+    if (b.state.prim.tme && rng.chance(80))
+    {
+        c.tex0.tbp0 = source * 32u; // sample the other target
+        c.tex0.tbw = 4u;
+        c.tex0.psm = rng.chance(70) ? GS_PSM_CT32 : GS_PSM_CT24;
+        c.tex0.tw = 8u;
+        c.tex0.th = 7u; // 256x128 stays inside the other 256x240 target
+        c.clamp = (c.clamp & ~0xFull) | rng.below(2) | (rng.below(2) << 2);
+        b.state.textureWidth = 256u;
+        b.state.textureHeight = 128u;
+    }
+    return b;
+}
+
+GSPrimitiveBatch feedbackBatch(Rng &rng)
+{
+    GSPrimitiveBatch b = randomBatch(rng, true);
+    GSDrawState &s = b.state;
+    GSContext &c = s.context;
+    s.prim.type = GS_PRIM_SPRITE;
+    s.prim.tme = 1;
+    s.prim.fst = rng.chance(80);
+    b.vertexCount = 2;
+    static const uint8_t kFramePsm[] = {GS_PSM_CT32, GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S};
+    c.frame.fbp = rng.below(64);
+    c.frame.fbw = 4u;
+    c.frame.psm = rng.pick(kFramePsm);
+    c.tex0.tbp0 = c.frame.fbp * 32u; // the framebuffer itself
+    c.tex0.tbw = 4u;
+    c.tex0.psm = c.frame.psm;
+    c.tex0.tw = 8u;
+    c.tex0.th = 8u;
+    c.clamp = (c.clamp & ~0xFull) | rng.below(2) | (rng.below(2) << 2);
+    s.textureWidth = 256u;
+    s.textureHeight = 256u;
+    c.scissor.x0 = 0;
+    c.scissor.y0 = 0;
+    c.scissor.x1 = 255;
+    c.scissor.y1 = 255;
+    // Draw a rectangle and sample the same area shifted by a few texels, so
+    // the draw reads pixels it has already written (in either direction).
+    const int x0 = static_cast<int>(rng.below(160));
+    const int y0 = static_cast<int>(rng.below(160));
+    const int w = 8 + static_cast<int>(rng.below(96));
+    const int h = 8 + static_cast<int>(rng.below(96));
+    const int du = static_cast<int>(rng.below(17)) - 8;
+    const int dv = static_cast<int>(rng.below(17)) - 8;
+    const float ofx = static_cast<float>(c.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(c.xyoffset.ofy >> 4);
+    b.vertices[0].x = ofx + static_cast<float>(x0);
+    b.vertices[0].y = ofy + static_cast<float>(y0);
+    b.vertices[1].x = ofx + static_cast<float>(x0 + w);
+    b.vertices[1].y = ofy + static_cast<float>(y0 + h);
+    b.vertices[0].u = static_cast<uint16_t>(std::max(0, x0 + du) * 16);
+    b.vertices[0].v = static_cast<uint16_t>(std::max(0, y0 + dv) * 16);
+    b.vertices[1].u = static_cast<uint16_t>(std::max(0, x0 + w + du) * 16);
+    b.vertices[1].v = static_cast<uint16_t>(std::max(0, y0 + h + dv) * 16);
+    b.vertices[0].s = static_cast<float>(std::max(0, x0 + du)) / 256.0f;
+    b.vertices[0].t = static_cast<float>(std::max(0, y0 + dv)) / 256.0f;
+    b.vertices[1].s = static_cast<float>(std::max(0, x0 + w + du)) / 256.0f;
+    b.vertices[1].t = static_cast<float>(std::max(0, y0 + h + dv)) / 256.0f;
+    b.vertices[0].q = 1.0f;
+    b.vertices[1].q = 1.0f;
+    return b;
+}
+
+void pingPongUpload(GSCpuBackend &backend, Rng &rng)
+{
+    GSTransferCommand command{};
+    command.bitbltbuf.dbp = (rng.chance(50) ? 0u : 64u) * 32u;
+    command.bitbltbuf.dbw = 4u;
+    command.bitbltbuf.dpsm = GS_PSM_CT32;
+    command.trxpos.dsax = static_cast<uint16_t>(rng.below(192));
+    command.trxpos.dsay = static_cast<uint16_t>(rng.below(176));
+    command.trxreg.rrw = static_cast<uint16_t>(1 + rng.below(64));
+    command.trxreg.rrh = static_cast<uint16_t>(1 + rng.below(64));
+    command.direction = 0u;
+    backend.BeginTransfer(command);
+    std::vector<uint8_t> data(static_cast<size_t>(command.trxreg.rrw) * command.trxreg.rrh * 4u);
+    for (uint8_t &value : data)
+        value = static_cast<uint8_t>(rng.next());
+    backend.UploadImage(data.data(), static_cast<uint32_t>(data.size()));
+}
+
+uint64_t hashTransfer(const GSTransferSnapshot &t)
+{
+    return (static_cast<uint64_t>(t.x) * 0x9E3779B1u) ^ (static_cast<uint64_t>(t.y) << 20) ^
+           (static_cast<uint64_t>(t.totalPixels) << 32) ^ (static_cast<uint64_t>(t.copiedPixels) * 0x85EBCA6Bu) ^
+           (static_cast<uint64_t>(t.direction) << 60);
+}
+} // namespace
+
+int main(int argc, char **argv)
+{
+    if (argc < 5)
+    {
+        std::fprintf(stderr, "usage: %s <base_vram.bin> <seed> <cases> <single|disjoint|sequence> [captured_batch.bin ...]\n", argv[0]);
+        return 2;
+    }
+    const std::vector<uint8_t> base = readFile(argv[1]);
+    if (base.size() != 4u * 1024u * 1024u)
+    {
+        std::fprintf(stderr, "base VRAM must be 4 MiB\n");
+        return 2;
+    }
+    Rng rng{std::strtoull(argv[2], nullptr, 0) | 1ull};
+    const int cases = std::atoi(argv[3]);
+    const std::string mode = argv[4];
+    g_forceSprites = mode == "sprites" || mode == "sprites-disjoint" || mode == "stale";
+    const bool disjoint = mode != "single" && mode != "sprites";
+    const bool stale = mode == "stale";
+    g_pinTexturePage = stale;
+    const bool sequence = mode == "sequence" || stale;
+    const bool pingpong = mode == "pingpong";
+
+    std::vector<uint8_t> vram(base);
+    GSCpuBackend backend;
+    backend.Initialize(vram.data(), static_cast<uint32_t>(vram.size()));
+
+    int index = 0;
+    for (int i = 5; i < argc; ++i, ++index)
+    {
+        const std::vector<uint8_t> bytes = readFile(argv[i]);
+        if (bytes.size() != sizeof(GSPrimitiveBatch))
+        {
+            std::fprintf(stderr, "bad batch file %s\n", argv[i]);
+            return 2;
+        }
+        GSPrimitiveBatch batch{};
+        std::memcpy(&batch, bytes.data(), sizeof(batch));
+        std::memcpy(vram.data(), base.data(), base.size());
+        backend.TextureFlush();
+        loadRandomClut(backend, rng, batch, false);
+        backend.Submit(batch);
+        backend.Sync(GSSyncReason::DebugReadback);
+        std::printf("%d captured %016llx\n", index, static_cast<unsigned long long>(hashMemory(vram.data(), vram.size())));
+    }
+    for (int i = 0; i < cases; ++i, ++index)
+    {
+        std::memcpy(vram.data(), base.data(), base.size());
+        backend.TextureFlush();
+        if (pingpong)
+        {
+            for (int op = 0; op < 24; ++op)
+            {
+                const uint32_t kind = rng.below(100);
+                if (kind < 70)
+                {
+                    backend.TextureFlush();
+                    const GSPrimitiveBatch batch = pingPongBatch(rng, rng.chance(50));
+                    if (rng.chance(25))
+                    {
+                        GSTex0Reg tex0 = batch.state.context.tex0;
+                        tex0.psm = rng.chance(50) ? GS_PSM_T8 : GS_PSM_T4;
+                        tex0.cpsm = GS_PSM_CT32;
+                        tex0.csm = 0u;
+                        tex0.cbp = (rng.chance(50) ? 0u : 64u) * 32u + rng.below(32u); // CLUT from A or B
+                        tex0.cld = 1u;
+                        backend.LoadClut(tex0, GSTexClutReg{});
+                    }
+                    backend.Submit(batch);
+                }
+                else
+                {
+                    pingPongUpload(backend, rng);
+                }
+            }
+            backend.Sync(GSSyncReason::DebugReadback);
+            std::printf("%d sequence %016llx %016llx\n", index,
+                        static_cast<unsigned long long>(hashMemory(vram.data(), vram.size())),
+                        static_cast<unsigned long long>(hashTransfer(backend.GetTransferSnapshot())));
+            continue;
+        }
+        if (!sequence)
+        {
+            const GSPrimitiveBatch batch = mode == "feedback" ? feedbackBatch(rng) : randomBatch(rng, disjoint);
+            loadRandomClut(backend, rng, batch, disjoint);
+            backend.Submit(batch);
+            backend.Sync(GSSyncReason::DebugReadback);
+            std::printf("%d type=%u %016llx\n", index, static_cast<unsigned>(batch.state.prim.type),
+                        static_cast<unsigned long long>(hashMemory(vram.data(), vram.size())));
+            continue;
+        }
+        bool needFlush = false; // an upload must be flushed before textures/CLUTs read it
+        for (int op = 0; op < 24; ++op)
+        {
+            uint32_t kind = rng.below(100);
+            // PS2_DIFF_OPS bitmask (debugging aid): 1 draws, 2 uploads, 4 CLUT loads, 8 flushes.
+            static const uint32_t opMask = std::getenv("PS2_DIFF_OPS") ? std::strtoul(std::getenv("PS2_DIFF_OPS"), nullptr, 0) : 0xFu;
+            const uint32_t opBit = kind < 55 ? 1u : kind < 80 ? 2u : kind < 92 ? 4u : 8u;
+            if ((opMask & opBit) == 0u)
+                continue;
+            if (kind < 55)
+            {
+                if (needFlush && !stale)
+                {
+                    backend.TextureFlush();
+                    needFlush = false;
+                }
+                const GSPrimitiveBatch batch = randomBatch(rng, true);
+                if (rng.chance(30))
+                    loadRandomClut(backend, rng, batch, true);
+                backend.Submit(batch);
+            }
+            else if (kind < 80)
+            {
+                randomUpload(backend, rng);
+                needFlush = true;
+            }
+            else if (kind < 92)
+            {
+                if (needFlush && !stale)
+                {
+                    backend.TextureFlush();
+                    needFlush = false;
+                }
+                loadRandomClut(backend, rng, randomBatch(rng, true), true);
+            }
+            else if (!stale)
+            {
+                backend.TextureFlush();
+                needFlush = false;
+            }
+        }
+        const uint64_t transferHash = hashTransfer(backend.GetTransferSnapshot());
+        backend.Sync(GSSyncReason::DebugReadback);
+        std::printf("%d sequence %016llx %016llx\n", index,
+                    static_cast<unsigned long long>(hashMemory(vram.data(), vram.size())),
+                    static_cast<unsigned long long>(transferHash));
+    }
+    return 0;
+}
diff --git a/ps2xRuntime/tests/gs_sprite_raster_bench.cpp b/ps2xRuntime/tests/gs_sprite_raster_bench.cpp
new file mode 100644
index 0000000..b21d8e6
--- /dev/null
+++ b/ps2xRuntime/tests/gs_sprite_raster_bench.cpp
@@ -0,0 +1,116 @@
+// Replays a captured GS draw batch against its captured VRAM and reports the
+// per-pixel cost of the CPU rasterizer.
+//
+// Usage: gs_sprite_raster_bench <batch.bin> <vram.bin> [iterations] [samples.txt]
+// The capture files come from the PS2_GS_DRAW_TRACE_DIR scene-draw trace.
+// With samples.txt, a sampling thread records the rasterizing thread's RIP
+// (relative to the image base) every ~0.1 ms for offline symbolization.
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_types.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <atomic>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+namespace
+{
+std::vector<uint8_t> readFile(const char *path)
+{
+    std::ifstream file(path, std::ios::binary);
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(file), {});
+}
+} // namespace
+
+int main(int argc, char **argv)
+{
+    if (argc < 3)
+    {
+        std::fprintf(stderr, "usage: %s <batch.bin> <vram.bin> [iterations]\n", argv[0]);
+        return 2;
+    }
+    const std::vector<uint8_t> batchBytes = readFile(argv[1]);
+    std::vector<uint8_t> vram = readFile(argv[2]);
+    const int iterations = argc > 3 ? std::atoi(argv[3]) : 50;
+    if (batchBytes.size() != sizeof(GSPrimitiveBatch) || vram.size() != 4u * 1024u * 1024u)
+    {
+        std::fprintf(stderr, "unexpected capture sizes: batch=%zu (want %zu) vram=%zu\n",
+                     batchBytes.size(), sizeof(GSPrimitiveBatch), vram.size());
+        return 2;
+    }
+    GSPrimitiveBatch batch{};
+    std::memcpy(&batch, batchBytes.data(), sizeof(batch));
+
+    GSCpuBackend backend;
+    backend.Initialize(vram.data(), static_cast<uint32_t>(vram.size()));
+
+    const auto &v0 = batch.vertices[0];
+    const auto &v1 = batch.vertices[1];
+    const double pixels = std::abs((v1.x - v0.x) * (v1.y - v0.y));
+
+    backend.Submit(batch); // warm-up
+
+    std::atomic<bool> running{true};
+    std::vector<uint64_t> samples;
+    std::thread sampler;
+#if defined(_WIN32)
+    HANDLE worker = nullptr;
+    if (argc > 4)
+    {
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &worker,
+                        THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, FALSE, 0);
+        sampler = std::thread([&]() {
+            const uint64_t base = reinterpret_cast<uint64_t>(GetModuleHandleA(nullptr));
+            while (running.load())
+            {
+                if (SuspendThread(worker) != static_cast<DWORD>(-1))
+                {
+                    CONTEXT context{};
+                    context.ContextFlags = CONTEXT_CONTROL;
+                    if (GetThreadContext(worker, &context))
+                        samples.push_back(context.Rip - base);
+                    ResumeThread(worker);
+                }
+                // Busy-wait ~100 us: Sleep() granularity on Windows is ~15 ms.
+                const auto next = std::chrono::steady_clock::now() + std::chrono::microseconds(100);
+                while (std::chrono::steady_clock::now() < next)
+                {
+                }
+            }
+        });
+    }
+#endif
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < iterations; ++i)
+        backend.Submit(batch);
+    const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    running.store(false);
+    if (sampler.joinable())
+        sampler.join();
+    if (argc > 4)
+    {
+        if (FILE *out = std::fopen(argv[4], "w"))
+        {
+            for (uint64_t rva : samples)
+                std::fprintf(out, "%llx\n", static_cast<unsigned long long>(rva));
+            std::fclose(out);
+        }
+    }
+    std::printf("prim=%u tme=%u abe=%u fst=%u linear=%u tex=%ux%u psm=%u pixels/draw=%.0f draws=%d: %.3f ms/draw, %.1f ns/pixel\n",
+                static_cast<unsigned>(batch.state.prim.type), batch.state.prim.tme, batch.state.prim.abe,
+                batch.state.prim.fst, batch.state.linearFilter ? 1u : 0u,
+                batch.state.textureWidth, batch.state.textureHeight,
+                static_cast<unsigned>(batch.state.context.tex0.psm), pixels, iterations,
+                seconds * 1e3 / iterations, seconds * 1e9 / (iterations * pixels));
+    return 0;
+}
diff --git a/ps2xRuntime/tests/vif1_direct_image_continuation_test.cpp b/ps2xRuntime/tests/vif1_direct_image_continuation_test.cpp
new file mode 100644
index 0000000..02e4ede
--- /dev/null
+++ b/ps2xRuntime/tests/vif1_direct_image_continuation_test.cpp
@@ -0,0 +1,236 @@
+// Regression: a GIF IMAGE tag delivered by one VIF1 DIRECT must continue with
+// the payload of the next DIRECT/DIRECTHL, not with the raw VIFcodes before it.
+//
+// Castlevania: Curse of Darkness uploads every texture and CLUT as
+//   DIRECT 6   (PACKED A+D BITBLTBUF/TRXPOS/TRXREG/TRXDIR + IMAGE tag)
+//   REF tag with CHCR.TTE, upper half = NOP; DIRECTHL n   -> n pixel qwords
+// Feeding NOP/DIRECTHL to the GS as pixels shifted each upload by 8 bytes.
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/ps2_gs_psmct32.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <vector>
+
+namespace
+{
+void unusedGuest(uint8_t *, R5900Context *, PS2Runtime *) {}
+
+int g_failures = 0;
+
+void expect(bool condition, const char *message)
+{
+    if (!condition)
+    {
+        std::cerr << "FAIL: " << message << std::endl;
+        ++g_failures;
+    }
+}
+
+uint32_t makeVifCmd(uint8_t opcode, uint8_t num, uint16_t imm)
+{
+    return (static_cast<uint32_t>(opcode) << 24) | (static_cast<uint32_t>(num) << 16) | imm;
+}
+
+uint64_t makeGifTag(uint16_t nloop, uint8_t flg, uint8_t nreg, bool eop)
+{
+    return static_cast<uint64_t>(nloop & 0x7FFFu) | (eop ? (1ull << 15) : 0ull) |
+           (static_cast<uint64_t>(flg & 0x3u) << 58) | (static_cast<uint64_t>(nreg & 0xFu) << 60);
+}
+
+uint64_t makeDmaTag(uint16_t qwc, uint8_t id, uint32_t addr)
+{
+    return static_cast<uint64_t>(qwc) | (static_cast<uint64_t>(id & 0x7u) << 28) |
+           (static_cast<uint64_t>(addr & 0x7FFFFFFFu) << 32);
+}
+
+void appendU32(std::vector<uint8_t> &dst, uint32_t value)
+{
+    const size_t pos = dst.size();
+    dst.resize(pos + sizeof(value));
+    std::memcpy(dst.data() + pos, &value, sizeof(value));
+}
+
+void appendU64(std::vector<uint8_t> &dst, uint64_t value)
+{
+    const size_t pos = dst.size();
+    dst.resize(pos + sizeof(value));
+    std::memcpy(dst.data() + pos, &value, sizeof(value));
+}
+
+constexpr uint32_t kPixels = 8u; // 4x2 CT32 = 2 image qwords
+constexpr uint32_t kImageQwc = 2u;
+
+// PACKED A+D setup for a 4x2 CT32 host->local upload at DBP 0, then the IMAGE tag.
+void appendUploadSetup(std::vector<uint8_t> &dst)
+{
+    appendU64(dst, makeGifTag(4u, 0u, 1u, false));
+    appendU64(dst, 0x0Eull);
+    appendU64(dst, (1ull << 48)); // BITBLTBUF: DBP 0, DBW 1, DPSM CT32
+    appendU64(dst, GS_REG_BITBLTBUF);
+    appendU64(dst, 0ull); // TRXPOS
+    appendU64(dst, GS_REG_TRXPOS);
+    appendU64(dst, 4ull | (2ull << 32)); // TRXREG 4x2
+    appendU64(dst, GS_REG_TRXREG);
+    appendU64(dst, 0ull); // TRXDIR host->local
+    appendU64(dst, GS_REG_TRXDIR);
+    appendU64(dst, makeGifTag(static_cast<uint16_t>(kImageQwc), 2u, 0u, true));
+    appendU64(dst, 0ull);
+}
+
+uint32_t pixelValue(uint32_t i) { return 0x80000000u | (0x010203u * (i + 1u)); }
+
+void appendPixels(std::vector<uint8_t> &dst, uint32_t first, uint32_t count)
+{
+    for (uint32_t i = first; i < first + count; ++i)
+        appendU32(dst, pixelValue(i));
+}
+
+bool vramHoldsPixels(PS2Memory &mem)
+{
+    const uint8_t *vram = mem.getGSVRAM();
+    for (uint32_t i = 0; i < kPixels; ++i)
+    {
+        uint32_t value = 0u;
+        std::memcpy(&value, vram + GSPSMCT32::addrPSMCT32(0u, 1u, i % 4u, i / 4u), sizeof(value));
+        if (value != pixelValue(i))
+        {
+            std::cerr << "  pixel " << i << " = 0x" << std::hex << value << " expected 0x" << pixelValue(i)
+                      << std::dec << std::endl;
+            return false;
+        }
+    }
+    return true;
+}
+
+struct Harness
+{
+    PS2Memory mem;
+    GS gs;
+    GifArbiter arbiter{[this](const uint8_t *data, uint32_t size) { gs.processGIFPacket(data, size); }};
+
+    bool init()
+    {
+        if (!mem.initialize())
+            return false;
+        gs.init(mem.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &mem.gs());
+        mem.setGifArbiter(&arbiter);
+        return true;
+    }
+};
+
+void testDirectHlContinuationInOneBuffer()
+{
+    Harness h;
+    expect(h.init(), "memory init");
+    std::vector<uint8_t> vif;
+    appendU32(vif, 0u);
+    appendU32(vif, 0u);
+    appendU32(vif, 0u);
+    appendU32(vif, makeVifCmd(0x50u, 0u, 6u)); // DIRECT 6
+    appendUploadSetup(vif);
+    appendU32(vif, 0u);                                               // NOP (TTE tag word 2)
+    appendU32(vif, makeVifCmd(0x51u, 0u, static_cast<uint16_t>(kImageQwc))); // DIRECTHL 2 (word 3)
+    appendPixels(vif, 0u, kPixels);
+    appendU32(vif, 0u);
+    appendU32(vif, 0u);
+    appendU32(vif, 0u);
+    appendU32(vif, makeVifCmd(0x01u, 0u, 0x0304u)); // STCYCL after the image: must still decode as VIF
+
+    h.mem.processVIF1Data(vif.data(), static_cast<uint32_t>(vif.size()));
+    h.arbiter.drain();
+    expect(vramHoldsPixels(h.mem), "DIRECTHL payload after DIRECT image tag must be uploaded without VIFcodes");
+    expect(h.mem.vif1_regs.cycle == 0x0304u, "VIFcode after the image continuation must stay in sync");
+}
+
+void testTteDmaChainLikeGame()
+{
+    Harness h;
+    expect(h.init(), "memory init");
+    constexpr uint32_t kVif1Ch = 0x10009000u;
+    constexpr uint32_t kChain = 0x00030000u;
+    constexpr uint32_t kData = 0x00031000u;
+    uint8_t *rdram = h.mem.getRDRAM();
+
+    std::vector<uint8_t> setup;
+    appendUploadSetup(setup);
+
+    // CNT qwc=6, TTE upper half = NOP; DIRECT 6
+    uint64_t tag = makeDmaTag(6u, 1u, 0u);
+    std::memcpy(rdram + kChain, &tag, 8);
+    const uint32_t direct6[2] = {0u, makeVifCmd(0x50u, 0u, 6u)};
+    std::memcpy(rdram + kChain + 8u, direct6, 8);
+    std::memcpy(rdram + kChain + 16u, setup.data(), setup.size());
+
+    // REF qwc=2 -> pixels, TTE upper half = NOP; DIRECTHL 2
+    const uint32_t refAddr = kChain + 16u + 6u * 16u;
+    tag = makeDmaTag(static_cast<uint16_t>(kImageQwc), 3u, kData);
+    std::memcpy(rdram + refAddr, &tag, 8);
+    const uint32_t directHl[2] = {0u, makeVifCmd(0x51u, 0u, static_cast<uint16_t>(kImageQwc))};
+    std::memcpy(rdram + refAddr + 8u, directHl, 8);
+    std::vector<uint8_t> pixels;
+    appendPixels(pixels, 0u, kPixels);
+    std::memcpy(rdram + kData, pixels.data(), pixels.size());
+
+    // END qwc=0, TTE upper half = NOP; NOP
+    tag = makeDmaTag(0u, 7u, 0u);
+    std::memset(rdram + refAddr + 16u, 0, 16);
+    std::memcpy(rdram + refAddr + 16u, &tag, 8);
+
+    expect(h.mem.writeIORegister(kVif1Ch + 0x30u, kChain), "write VIF1 TADR");
+    expect(h.mem.writeIORegister(kVif1Ch + 0x20u, 0u), "write VIF1 QWC");
+    expect(h.mem.writeIORegister(kVif1Ch + 0x00u, 0x100u | 0x40u | (1u << 2)), "start VIF1 chain with TTE");
+    h.mem.processPendingTransfers();
+    h.arbiter.drain();
+    expect(vramHoldsPixels(h.mem), "TTE DIRECTHL chain must upload the referenced pixels unshifted");
+}
+
+void testTruncatedDirectContinuesAcrossBuffers()
+{
+    Harness h;
+    expect(h.init(), "memory init");
+    std::vector<uint8_t> first;
+    appendU32(first, 0u);
+    appendU32(first, 0u);
+    appendU32(first, 0u);
+    appendU32(first, makeVifCmd(0x50u, 0u, static_cast<uint16_t>(6u + kImageQwc))); // DIRECT 8
+    appendUploadSetup(first);
+    appendPixels(first, 0u, 4u); // only the first image qword fits in this transfer
+
+    std::vector<uint8_t> second;
+    appendPixels(second, 4u, 4u); // remaining DIRECT payload, no VIFcode on hardware
+    appendU32(second, 0u);
+    appendU32(second, 0u);
+    appendU32(second, 0u);
+    appendU32(second, makeVifCmd(0x01u, 0u, 0x0506u)); // STCYCL after the DIRECT payload
+
+    h.mem.processVIF1Data(first.data(), static_cast<uint32_t>(first.size()));
+    h.mem.processVIF1Data(second.data(), static_cast<uint32_t>(second.size()));
+    h.arbiter.drain();
+    expect(vramHoldsPixels(h.mem), "a DIRECT payload split across transfers must continue raw");
+    expect(h.mem.vif1_regs.cycle == 0x0506u, "VIFcode after a split DIRECT payload must stay in sync");
+}
+} // namespace
+
+extern const uint32_t g_ps2RecompiledFunctionTableBase = 0x400000u;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd = 0x400004u;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = 1u;
+PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[1] = {unusedGuest};
+
+int main()
+{
+    testDirectHlContinuationInOneBuffer();
+    testTteDmaChainLikeGame();
+    testTruncatedDirectContinuesAcrossBuffers();
+    if (g_failures != 0)
+    {
+        std::cerr << g_failures << " failure(s)" << std::endl;
+        return 1;
+    }
+    std::cout << "vif1_direct_image_continuation_test: all passed" << std::endl;
+    return 0;
+}
